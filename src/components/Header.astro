---
// src/components/Header.astro
// World-class Sticky Floating Glass Header for Aqua Shakti Industries.
// Features: Floating 24px Glass Pill, Shrink on Scroll, Mega Menu,
// Dark/Light Mode Switcher, and Fullscreen Mobile Drawer.

import Logo from './Logo.astro';
import { COMPANY_PHONE, COMPANY_ESTD } from '../consts';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = currentPath === '/';
const isProducts = currentPath.startsWith('/products');
const isAbout = currentPath.startsWith('/about');
const isBlog = currentPath.startsWith('/blog');
const isContact = currentPath.startsWith('/contact');
---



<!-- 2. Sticky Main Header -->
<header class="site-header-wrapper" id="site-header">
	<div class="site-header-container">
		<nav class="site-nav-glass" aria-label="Main Navigation">
			<!-- 1. Left: Brand & Logo with Custom Emblem -->
			<div class="nav-brand-group">
				<a href="/" class="nav-brand-link" aria-label="Aqua Shakti Industries Home">
					<Logo size="md" showTagline={true} />
				</a>
			</div>

			<!-- 2. Center: Desktop Navigation with Mega Menu -->
			<div class="nav-center-desktop">
				<ul class="nav-links-list">
					<!-- Home -->
					<li class="nav-link-item">
						<a href="/" class:list={["nav-item-link", { active: isHome }]}>Home</a>
					</li>

					<!-- Products & Plants with Mega Menu -->
					<li class="nav-link-item has-mega-menu">
						<button type="button" class:list={["nav-item-link dropdown-trigger", { active: isProducts }]} aria-expanded="false" aria-controls="mega-menu-plants">
							<span>Products & Plants</span>
							<svg class="dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
						</button>

						<!-- Mega Menu Flyout -->
						<div class="mega-menu-panel" id="mega-menu-plants" role="region" aria-label="Products Mega Menu">
							<div class="mega-menu-content">
								<div class="mega-menu-grid">
									<!-- Column 1: RO & Pure Water -->
									<div class="mega-menu-col">
										<span class="mega-col-heading">PURE WATER & MEMBRANE PLANTS</span>
										<ul class="mega-items-list">
											<li>
												<a href="/products#industrial-ro" class="mega-item">
													<div class="mega-item-icon blue">
														<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
													</div>
													<div class="mega-item-info">
														<div class="mega-item-title-row">
															<strong>Industrial RO Plants</strong>
															<span class="chip-popular">Popular</span>
														</div>
														<p>500 to 50,000+ LPH. SS 304 skid, high-pressure pumps & automated CIP.</p>
													</div>
												</a>
											</li>
											<li>
												<a href="/products#commercial-ro" class="mega-item">
													<div class="mega-item-icon cyan">
														<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h10"/><path d="M7 12h10"/><path d="M7 17h10"/></svg>
													</div>
													<div class="mega-item-info">
														<strong>Commercial RO Systems</strong>
														<p>25 to 1000 LPH for institutions, factories, hospitals & hotels.</p>
													</div>
												</a>
											</li>
											<li>
												<a href="/products#dm-plants" class="mega-item">
													<div class="mega-item-icon purple">
														<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
													</div>
													<div class="mega-item-info">
														<strong>DM & Mix Bed Plants</strong>
														<p>Ultra-pure water (&lt;0.5 µS/cm) for pharma, labs & boiler feed.</p>
													</div>
												</a>
											</li>
										</ul>
									</div>

									<!-- Column 2: Wastewater & Softening -->
									<div class="mega-menu-col">
										<span class="mega-col-heading">WASTEWATER & RECYCLING</span>
										<ul class="mega-items-list">
											<li>
												<a href="/products#etp-plants" class="mega-item">
													<div class="mega-item-icon emerald">
														<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 22h20"/><path d="M7 10v4"/><path d="M12 6v8"/><path d="M17 14v4"/><path d="M17 8h4v10H3V4h4v6"/></svg>
													</div>
													<div class="mega-item-info">
														<div class="mega-item-title-row">
															<strong>Effluent Treatment (ETP)</strong>
															<span class="chip-gpcb">GPCB Norms</span>
														</div>
														<p>Chemical & textile effluent treatment with zero liquid discharge (ZLD).</p>
													</div>
												</a>
											</li>
											<li>
												<a href="/products#stp-plants" class="mega-item">
													<div class="mega-item-icon teal">
														<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/></svg>
													</div>
													<div class="mega-item-info">
														<strong>Sewage Treatment (STP)</strong>
														<p>MBBR & DELTA PR biological treatment for hotels & apartments.</p>
													</div>
												</a>
											</li>
											<li>
												<a href="/products#softeners" class="mega-item">
													<div class="mega-item-icon amber">
														<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
													</div>
													<div class="mega-item-info">
														<strong>Industrial Water Softeners</strong>
														<p>Scale removal for cooling towers, boiler feed & textile dyeing.</p>
													</div>
												</a>
											</li>
										</ul>
									</div>

									<!-- Column 3: Featured Plant Spotlight -->
									<div class="mega-menu-spotlight">
										<div class="spotlight-card">
											<div class="spotlight-tag">
												<span class="spotlight-dot"></span>
												TURNKEY SOLUTION
											</div>
											<h4>10,000 LPH Industrial RO Skid</h4>
											<p>Engineered for high TDS borewell water in Gujarat industrial estates. Turnkey installation & GPCB approval support.</p>
											<div class="spotlight-specs">
												<span class="spec-pill">SS 304 Skid</span>
												<span class="spec-pill">Dow Membranes</span>
												<span class="spec-pill">CIP Skid</span>
											</div>
											<button type="button" class="btn-spotlight-quote" data-quote-trigger data-plant="10,000 LPH Industrial RO Plant">
												Get Technical Sizing &rarr;
											</button>
										</div>
									</div>
								</div>

								<!-- Mega Menu Bottom Bar -->
								<div class="mega-bottom-strip">
									<div class="mega-strip-left">
										<span class="badge-status-dot"></span>
										<span>Factory & Labs: <strong>Chanod, Vapi (Gujarat) Operational</strong></span>
									</div>
									<div class="mega-strip-links">
										<a href="/products">All 16+ Plant Categories &rarr;</a>
										<a href="/products#chemicals">Treatment Chemicals &rarr;</a>
										<a href="/products#components">Imported Spares &rarr;</a>
									</div>
								</div>
							</div>
						</div>
					</li>

					<!-- About Us with Dropdown -->
					<li class="nav-link-item has-dropdown">
						<button type="button" class:list={["nav-item-link dropdown-trigger", { active: isAbout }]} aria-expanded="false" aria-controls="dropdown-about">
							<span>About Us</span>
							<svg class="dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
						</button>

						<div class="nav-dropdown-panel" id="dropdown-about">
							<div class="dropdown-links-grid">
								<a href="/about" class="dropdown-card-item">
									<span class="drop-icon">🏢</span>
									<div class="drop-text">
										<strong>Company Profile</strong>
										<span>Pioneering water treatment in Vapi since {COMPANY_ESTD}.</span>
									</div>
								</a>
								<a href="/about#team" class="dropdown-card-item">
									<span class="drop-icon">👥</span>
									<div class="drop-text">
										<strong>Engineering Team</strong>
										<span>Qualified process chemists and mechanical engineers.</span>
									</div>
								</a>
								<a href="/about#dealers" class="dropdown-card-item">
									<span class="drop-icon">📍</span>
									<div class="drop-text">
										<strong>Authorized Dealers</strong>
										<span>Presence in Varanasi, Allahabad, and Rajasthan.</span>
									</div>
								</a>
								<a href="/#clients" class="dropdown-card-item">
									<span class="drop-icon">⭐</span>
									<div class="drop-text">
										<strong>500+ Reputed Clients</strong>
										<span>Nilkamal, Blue Star, Macleods Pharma, Lords Inn.</span>
									</div>
								</a>
							</div>
						</div>
					</li>

					<!-- Blog -->
					<li class="nav-link-item">
						<a href="/blog" class:list={["nav-item-link", { active: isBlog }]}>Blog</a>
					</li>

					<!-- Contact -->
					<li class="nav-link-item">
						<a href="/contact" class:list={["nav-item-link", { active: isContact }]}>Contact</a>
					</li>
				</ul>
			</div>

			<!-- 3. Right: Theme Toggle & Request Quote CTA -->
			<div class="nav-actions-right">
				<!-- Dark / Light Theme Toggle -->
				<button type="button" class="action-icon-btn theme-toggle-btn" id="theme-toggle" aria-label="Toggle Dark and Light Theme">
					<!-- Sun icon (shown in Dark mode) -->
					<svg class="theme-icon sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
					<!-- Moon icon (shown in Light mode) -->
					<svg class="theme-icon moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
				</button>

				<!-- Request Quote Luxury Gradient Button with Document Icon -->
				<button type="button" class="btn-gradient-quote" data-quote-trigger data-plant="General Enquiry">
					<svg class="btn-doc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
					<span class="quote-text-full">Request Quote</span>
					<span class="quote-text-short">Quote</span>
				</button>

				<!-- Mobile Hamburger Toggle Button -->
				<button type="button" class="mobile-hamburger-btn" id="mobile-menu-toggle" aria-label="Toggle Mobile Navigation" aria-expanded="false" aria-controls="mobile-nav-drawer">
					<span class="ham-bar bar-1"></span>
					<span class="ham-bar bar-2"></span>
					<span class="ham-bar bar-3"></span>
				</button>
			</div>
		</nav>
	</div>
</header>

	<!-- 4. Fullscreen Animated Mobile Glass Drawer -->
	<div class="mobile-drawer-overlay" id="mobile-nav-drawer" aria-hidden="true">
		<div class="mobile-drawer-inner">
			<!-- Mobile Drawer Header with Logo & Close Button -->
			<div class="mobile-drawer-header">
				<a href="/" class="mobile-brand-link" aria-label="Aqua Shakti Home">
					<Logo size="sm" showTagline={false} />
				</a>
				<button type="button" class="mobile-close-btn" id="mobile-drawer-close" aria-label="Close menu">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
				</button>
			</div>

			<!-- Mobile Navigation Links with Accordions -->
			<div class="mobile-nav-groups">
				<a href="/" class:list={["mobile-nav-item", { active: isHome }]}>Home</a>

				<!-- Products Accordion -->
				<div class:list={["mobile-accordion", { active: isProducts }]}>
					<button type="button" class="mobile-acc-btn">
						<span>Products & Plants</span>
						<svg class="acc-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
					</button>
					<div class="mobile-acc-content">
						<a href="/products#industrial-ro" class="mobile-subitem"><span class="dot blue"></span> Industrial RO (500 - 50k LPH)</a>
						<a href="/products#commercial-ro" class="mobile-subitem"><span class="dot cyan"></span> Commercial RO (25 - 1000 LPH)</a>
						<a href="/products#settling-plants" class="mobile-subitem"><span class="dot teal"></span> Secondary Settling Tanks</a>
						<a href="/products#boiler-plant" class="mobile-subitem"><span class="dot blue"></span> Industrial Boiler Plants</a>
						<a href="/products#etp-plants" class="mobile-subitem"><span class="dot emerald"></span> Effluent Treatment (ETP)</a>
						<a href="/products#stp-plants" class="mobile-subitem"><span class="dot teal"></span> Sewage Treatment (STP)</a>
						<a href="/products#dm-plants" class="mobile-subitem"><span class="dot purple"></span> Softeners & DM Plants</a>
						<a href="/products#chemicals" class="mobile-subitem"><span class="dot amber"></span> RO Chemicals & Spares</a>
					</div>
				</div>

				<!-- About Us Accordion -->
				<div class:list={["mobile-accordion", { active: isAbout }]}>
					<button type="button" class="mobile-acc-btn">
						<span>About Us</span>
						<svg class="acc-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
					</button>
					<div class="mobile-acc-content">
						<a href="/about" class="mobile-subitem">Company Profile & History (Estd 2007)</a>
						<a href="/about#team" class="mobile-subitem">Our Engineering Team in Vapi</a>
						<a href="/about#dealers" class="mobile-subitem">Authorized Dealer Network</a>
					</div>
				</div>

				<a href="/blog" class:list={["mobile-nav-item", { active: isBlog }]}>Blog</a>
				<a href="/contact" class:list={["mobile-nav-item", { active: isContact }]}>Contact</a>
			</div>

			<!-- Mobile Bottom Controls -->
			<div class="mobile-drawer-bottom">
				<div class="mobile-action-buttons">
					<button type="button" class="btn btn-primary btn-block" data-quote-trigger data-plant="General Enquiry">
						Request Free Plant Quote &rarr;
					</button>
					<a href={`tel:${COMPANY_PHONE.replace(/\s+/g, '')}`} class="btn btn-secondary btn-block">
						Call Direct: {COMPANY_PHONE}
					</a>
				</div>

				<div class="mobile-footer-row">
					<button type="button" class="btn-theme-mobile" id="mobile-theme-btn" aria-label="Toggle Dark Mode">
						<!-- Sun icon (shown in Dark mode) -->
						<svg class="theme-icon sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
						<!-- Moon icon (shown in Light mode) -->
						<svg class="theme-icon moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
						<span class="theme-label-text">Dark Mode</span>
					</button>
					<span class="mobile-estd-tag">ISO 9001:2008 • Vapi</span>
				</div>
			</div>
		</div>
	</div>


<style>
	/* ==========================================================================
	   Floating Glass Capsule Navbar (Circular Pill Floating Design)
	   ========================================================================== */

	.site-header-wrapper {
		position: fixed;
		top: 12px;
		left: 0;
		right: 0;
		z-index: 1000;
		background: transparent;
		pointer-events: none;
		padding: 0 1.25rem;
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.site-header-container {
		max-width: 1380px;
		margin: 0 auto;
		width: 100%;
		pointer-events: auto;
	}

	.site-nav-glass {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.65rem 1.75rem;
		background: rgba(255, 255, 255, 0.88);
		backdrop-filter: blur(28px) saturate(190%);
		-webkit-backdrop-filter: blur(28px) saturate(190%);
		border: 1.5px solid rgba(255, 255, 255, 0.85);
		border-radius: 9999px; /* Floating circular pill capsule */
		box-shadow: 
			0 16px 36px -6px rgba(15, 23, 42, 0.1),
			0 0 0 1px rgba(226, 232, 240, 0.8);
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	:global(html.dark) .site-nav-glass {
		background: rgba(13, 24, 43, 0.86);
		border-color: rgba(255, 255, 255, 0.12);
		box-shadow: 
			0 18px 44px -8px rgba(0, 0, 0, 0.65),
			0 0 0 1px rgba(255, 255, 255, 0.08);
	}

	/* When scrolled, navbar shrinks slightly for sleek floating feeling */
	.site-header-wrapper.scrolled {
		top: 8px;
	}

	.site-header-wrapper.scrolled .site-nav-glass {
		padding: 0.45rem 1.5rem;
		background: rgba(255, 255, 255, 0.95);
		box-shadow: 
			0 18px 44px -8px rgba(15, 23, 42, 0.14),
			0 0 0 1px rgba(226, 232, 240, 0.95);
	}

	:global(html.dark) .site-header-wrapper.scrolled .site-nav-glass {
		background: rgba(10, 19, 36, 0.94);
		box-shadow: 
			0 20px 48px -8px rgba(0, 0, 0, 0.75),
			0 0 0 1px rgba(255, 255, 255, 0.14);
	}

	/* Brand Group */
	.nav-brand-group {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.nav-brand-link {
		text-decoration: none;
		display: flex;
		align-items: center;
	}

	/* Desktop Center Links */
	.nav-center-desktop {
		display: flex;
		align-items: center;
	}

	.nav-links-list {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-link-item {
		position: relative;
	}

	.nav-item-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.5rem 0.9rem;
		font-size: 0.92rem;
		font-weight: 600;
		color: #334155;
		text-decoration: none;
		border-radius: 12px;
		background: transparent;
		border: none;
		cursor: pointer;
		transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
		position: relative;
	}

	:global(html.dark) .nav-item-link {
		color: #94A3B8;
	}

	.nav-item-link:hover {
		color: var(--primary, #0284c7);
	}

	:global(html.dark) .nav-item-link:hover {
		color: #38bdf8;
	}

	/* Dynamic Active Indicator - Highlights ONLY the currently active page */
	.nav-item-link.active {
		color: #0284c7 !important;
		font-weight: 700;
	}

	:global(html.dark) .nav-item-link.active {
		color: #38bdf8 !important;
	}

	.nav-item-link.active::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0.9rem;
		right: 0.9rem;
		height: 2.5px;
		background: #0284c7;
		border-radius: 9999px;
	}

	:global(html.dark) .nav-item-link.active::after {
		background: #38bdf8;
	}

	.dropdown-chevron {
		transition: transform 0.25s ease;
	}

	.nav-link-item:hover .dropdown-chevron,
	.nav-link-item.is-open .dropdown-chevron {
		transform: rotate(180deg);
	}

	/* ==========================================================================
	   Mega Menu Panel (Products & Plants)
	   ========================================================================== */

	.mega-menu-panel {
		position: absolute;
		top: calc(100% + 12px);
		left: 50%;
		transform: translateX(-50%) translateY(8px);
		width: min(860px, calc(100vw - 2rem));
		max-width: calc(100vw - 2rem);
		background: rgba(255, 255, 255, 0.96);
		backdrop-filter: blur(28px) saturate(200%);
		-webkit-backdrop-filter: blur(28px) saturate(200%);
		border: 1px solid rgba(226, 232, 240, 0.9);
		border-radius: 24px;
		box-shadow: 0 20px 48px -8px rgba(15, 23, 42, 0.18), 0 0 0 1px rgba(0, 0, 0, 0.04);
		padding: 1.5rem;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 1002;
	}

	:global(html.dark) .mega-menu-panel {
		background: rgba(15, 23, 42, 0.96);
		border-color: rgba(255, 255, 255, 0.1);
		box-shadow: 0 24px 60px -10px rgba(0, 0, 0, 0.7);
	}

