---
// Quote / Consultation Modal Component
---

<div id="quote-modal" class="modal-overlay" aria-hidden="true">
	<div class="modal-content">
		<button type="button" class="modal-close" id="modal-close-btn" aria-label="Close modal">&times;</button>
		
		<div class="modal-header">
			<span class="badge badge-blue">ISO 9001:2008 Quality Assured</span>
			<h3 style="margin-top: 0.5rem; margin-bottom: 0.25rem;">Request Plant Quote & Consultation</h3>
			<p style="font-size: 0.9rem; margin-bottom: 1.5rem;">Speak with an Aqua Shakti water treatment engineer. Get customized sizing & pricing for Gujarat & PAN-India.</p>
		</div>

		<form id="quote-form" onsubmit="event.preventDefault(); handleQuoteSubmit(event);">
			<div class="form-group">
				<label class="form-label" for="quote-plant">System / Plant Requirement</label>
				<select class="form-control" id="quote-plant" name="plant" required>
					<option value="Industrial RO Plant">Industrial RO Plant (500 to 50,000+ LPH)</option>
					<option value="Commercial RO Plant">Commercial RO Plant (25 to 1000 LPH)</option>
					<option value="Sewage Treatment Plant (STP)">Sewage Treatment Plant (STP - DELTA PR)</option>
					<option value="Effluent Treatment Plant (ETP)">Effluent Treatment Plant (ETP)</option>
					<option value="Water Softener Plant">Industrial Water Softener Plant</option>
					<option value="DM / Mix Bed Plant">Demineralization (DM) / Mix Bed Plant</option>
					<option value="Ozonation & Mineral Bottling">Ozonation & Packaged Drinking Water</option>
					<option value="Chilling Plant & Coolers">Online Chilling Plant & Water Coolers</option>
					<option value="Spares & Treatment Chemicals">Membranes, Resins, Antiscalant & Spares</option>
				</select>
			</div>

			<div class="modal-form-row">
				<div class="form-group">
					<label class="form-label" for="quote-capacity">Capacity / Flow Rate</label>
					<input type="text" class="form-control" id="quote-capacity" name="capacity" placeholder="e.g. 1000 LPH / 20 KLD" required />
				</div>
				<div class="form-group">
					<label class="form-label" for="quote-source">Raw Water Source</label>
					<select class="form-control" id="quote-source" name="source">
						<option value="Borewell / Ground Water">Borewell / Ground Water</option>
						<option value="Industrial Effluent">Industrial Effluent (ETP)</option>
						<option value="Domestic Sewage">Domestic Sewage (STP)</option>
						<option value="River / Surface Canal">River / Surface Canal</option>
						<option value="Municipal Corporation">Municipal Supply</option>
						<option value="Sea / Brackish Water">Sea / Brackish Water</option>
					</select>
				</div>
			</div>

			<div class="modal-form-row">
				<div class="form-group">
					<label class="form-label" for="quote-name">Your Full Name</label>
					<input type="text" class="form-control" id="quote-name" name="name" placeholder="Name / Company" required />
				</div>
				<div class="form-group">
					<label class="form-label" for="quote-phone">Phone / WhatsApp Number</label>
					<input type="tel" class="form-control" id="quote-phone" name="phone" placeholder="+91 98XXX XXXXX" required />
				</div>
			</div>

			<div class="form-group">
				<label class="form-label" for="quote-location">Installation Location</label>
				<input type="text" class="form-control" id="quote-location" name="location" placeholder="City / District (e.g. Vapi, Surat, Ahmedabad, Mumbai)" required />
			</div>

			<div class="form-group">
				<label class="form-label" for="quote-message">Project Notes / Raw Water TDS / Specific Needs</label>
				<textarea class="form-control" id="quote-message" name="message" rows="2" placeholder="Mention raw water TDS, hardness, or discharge limits if known..."></textarea>
			</div>

			<div class="modal-actions" style="display: flex; gap: 0.75rem; align-items: center; justify-content: flex-end; margin-top: 1rem;">
				<button type="button" class="btn btn-secondary btn-sm" id="modal-cancel-btn">Cancel</button>
				<button type="submit" class="btn btn-primary" id="modal-submit-btn">Send Enquiry via WhatsApp / Email &rarr;</button>
			</div>
		</form>

		<div id="quote-success" style="display: none; text-align: center; padding: 2rem 1rem;">
			<div style="width: 56px; height: 56px; background: #d1fae5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem auto; color: #059669; font-size: 1.75rem;">
				✓
			</div>
			<h3 style="color: #065f46;">Enquiry Prepared!</h3>
			<p>Thank you for reaching out to <strong>Aqua Shakti Industries</strong>. Opening direct WhatsApp line with our technical head now...</p>
			<a id="quote-whatsapp-link" href="#" target="_blank" class="btn btn-accent" style="margin-top: 1rem;">
				Open WhatsApp Direct Chat
			</a>
		</div>
	</div>
</div>

<script is:inline>
	function openQuoteModal(plantName = '', capacity = '') {
		const modal = document.getElementById('quote-modal');
		if (!modal) return;
		if (plantName) {
			const select = document.getElementById('quote-plant');
			if (select) {
				for (let option of select.options) {
					if (option.value.toLowerCase().includes(plantName.toLowerCase())) {
						option.selected = true;
						break;
					}
				}
			}
		}
		if (capacity) {
			const capInput = document.getElementById('quote-capacity');
			if (capInput) capInput.value = capacity;
		}
		modal.classList.add('active');
		modal.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
	}

	function closeQuoteModal() {
		const modal = document.getElementById('quote-modal');
		if (!modal) return;
		modal.classList.remove('active');
		modal.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
	}

	function handleQuoteSubmit(e) {
		const form = document.getElementById('quote-form');
		const plant = form.elements['plant'].value;
		const capacity = form.elements['capacity'].value;
		const source = form.elements['source'].value;
		const name = form.elements['name'].value;
		const phone = form.elements['phone'].value;
		const location = form.elements['location'].value;
		const message = form.elements['message'].value;

		const waText = encodeURIComponent(
			`*Aqua Shakti Quotation Enquiry*\n` +
			`*Plant Requirement:* ${plant}\n` +
			`*Capacity:* ${capacity}\n` +
			`*Water Source:* ${source}\n` +
			`*Customer Name:* ${name}\n` +
			`*Phone:* ${phone}\n` +
			`*Location:* ${location}\n` +
			(message ? `*Notes:* ${message}\n` : '') +
			`*Source:* aquashakti.in`
		);

		const waUrl = `https://wa.me/919913936995?text=${waText}`;

		document.getElementById('quote-form').style.display = 'none';
		const success = document.getElementById('quote-success');
		success.style.display = 'block';
		document.getElementById('quote-whatsapp-link').href = waUrl;

		// Automatically open WhatsApp in new tab
		window.open(waUrl, '_blank');
	}

	function initQuoteModal() {
		const modal = document.getElementById('quote-modal');
		const closeBtn = document.getElementById('modal-close-btn');
		const cancelBtn = document.getElementById('modal-cancel-btn');

		if (closeBtn) closeBtn.addEventListener('click', closeQuoteModal);
		if (cancelBtn) cancelBtn.addEventListener('click', closeQuoteModal);

		if (modal) {
			modal.addEventListener('click', (e) => {
				if (e.target === modal) closeQuoteModal();
			});
		}

		// Attach to any button with data-quote-trigger
		document.querySelectorAll('[data-quote-trigger]').forEach((el) => {
			el.addEventListener('click', (ev) => {
				ev.preventDefault();
				const plant = el.getAttribute('data-plant') || '';
				const cap = el.getAttribute('data-capacity') || '';
				openQuoteModal(plant, cap);
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initQuoteModal);
	} else {
		initQuoteModal();
	}
	document.addEventListener('astro:page-load', initQuoteModal);
</script>

<style>
	.modal-form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	@media (max-width: 580px) {
		.modal-form-row {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.modal-actions {
			flex-direction: column-reverse;
		}

		.modal-actions .btn {
			width: 100%;
			text-align: center;
		}
	}

	:global(html.dark) .modal-header h3 {
		color: #f8fafc !important;
	}

	:global(html.dark) .modal-header p {
		color: #94a3b8 !important;
	}

	:global(html.dark) #quote-success h3 {
		color: #34d399 !important;
	}

	:global(html.dark) #quote-success p {
		color: #cbd5e1 !important;
	}

	:global(html.dark) #quote-success strong {
		color: #ffffff !important;
	}
</style>
