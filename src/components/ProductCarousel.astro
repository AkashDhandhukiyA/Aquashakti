</style>

<script is:inline>
	(function() {
		function initProductCarousel() {
			const scroller = document.getElementById('product-carousel-rail');
			const track = document.getElementById('product-carousel-track');
			if (!scroller || !track) return;

			const prevBtn = document.getElementById('carousel-prev-btn');
			const nextBtn = document.getElementById('carousel-next-btn');
			const indexEl = document.getElementById('carousel-current-index');
			const cards = Array.from(track.querySelectorAll('.carousel-card-item'));
			const dots = Array.from(document.querySelectorAll('.carousel-dot-btn'));
			const totalCards = cards.length;

			let activeIndex = 0;
			let isDown = false;
			let startX = 0;
			let scrollLeft = 0;
			let moved = false;

			function getCardWidth() {
				if (cards[0]) {
					const style = window.getComputedStyle(cards[0]);
					const marginRight = parseFloat(window.getComputedStyle(track).gap) || 24;
					return cards[0].offsetWidth + marginRight;
				}
				return 380;
			}

			function updateState() {
				const cardWidth = getCardWidth();
				const currentScroll = scroller.scrollLeft;
				activeIndex = Math.round(currentScroll / cardWidth);
				activeIndex = Math.max(0, Math.min(activeIndex, totalCards - 1));

				// Update Index Pill
				if (indexEl) {
					indexEl.textContent = String(activeIndex + 1).padStart(2, '0');
				}

				// Update Arrows
				if (prevBtn) prevBtn.disabled = activeIndex === 0;
				if (nextBtn) nextBtn.disabled = activeIndex >= totalCards - 1;

				// Update Dots
				dots.forEach((dot, i) => {
					if (i === activeIndex) {
						dot.classList.add('active');
						dot.setAttribute('aria-selected', 'true');
					} else {
						dot.classList.remove('active');
						dot.setAttribute('aria-selected', 'false');
					}
				});
			}

			function scrollToCard(index) {
				const cardWidth = getCardWidth();
				scroller.scrollTo({
					left: index * cardWidth,
					behavior: 'smooth'
				});
			}

			// Arrow click handlers
			prevBtn?.addEventListener('click', () => {
				scrollToCard(activeIndex - 1);
			});

			nextBtn?.addEventListener('click', () => {
				scrollToCard(activeIndex + 1);
			});

			// Dot click handlers
			dots.forEach((dot) => {
				dot.addEventListener('click', () => {
					const idx = parseInt(dot.getAttribute('data-slide-index') || '0', 10);
					scrollToCard(idx);
				});
			});

			// Scroll listener with throttle
			let scrollTimer = null;
			scroller.addEventListener('scroll', () => {
				if (!scrollTimer) {
					scrollTimer = requestAnimationFrame(() => {
						updateState();
						scrollTimer = null;
					});
				}
			}, { passive: true });

			// Pointer drag / momentum handlers
			scroller.addEventListener('pointerdown', (e) => {
				if (e.target.closest('button, a, input')) return;
				isDown = true;
				moved = false;
				scroller.classList.add('is-dragging');
				startX = e.pageX - scroller.offsetLeft;
				scrollLeft = scroller.scrollLeft;
			});

			window.addEventListener('pointermove', (e) => {
				if (!isDown) return;
				const x = e.pageX - scroller.offsetLeft;
				const walk = (x - startX);
				if (Math.abs(walk) > 5) moved = true;
				scroller.scrollLeft = scrollLeft - walk;
			});

			window.addEventListener('pointerup', () => {
				if (!isDown) return;
				isDown = false;
				scroller.classList.remove('is-dragging');
			});

			// Keyboard Navigation
			scroller.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowLeft') {
					e.preventDefault();
					scrollToCard(activeIndex - 1);
				} else if (e.key === 'ArrowRight') {
					e.preventDefault();
					scrollToCard(activeIndex + 1);
				}
			});

			// ==========================================================
			// CLOSURE ACCORDION LOGIC (+ / - toggle technical specs)
			// ==========================================================
			const closureToggles = track.querySelectorAll('.closure-toggle-btn');
			closureToggles.forEach((btn) => {
				btn.addEventListener('click', (e) => {
					e.preventDefault();
					e.stopPropagation();
					const targetId = btn.getAttribute('data-toggle-target');
					const panel = document.getElementById(targetId);
					const isExpanded = btn.getAttribute('aria-expanded') === 'true';
					const indicator = btn.querySelector('.icon-toggle-indicator');
					const hint = btn.querySelector('.closure-hint');

					if (isExpanded) {
						btn.setAttribute('aria-expanded', 'false');
						if (panel) panel.hidden = true;
						if (indicator) indicator.textContent = '+';
						if (hint) hint.textContent = 'Click to view';
					} else {
						btn.setAttribute('aria-expanded', 'true');
						if (panel) panel.hidden = false;
						if (indicator) indicator.textContent = '−';
						if (hint) hint.textContent = 'Click to hide';
					}
				});
			});


			updateState();
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initProductCarousel);
		} else {
			initProductCarousel();
		}
		document.addEventListener('astro:page-load', initProductCarousel);
	})();
</script>
