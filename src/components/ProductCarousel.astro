---
// src/components/ProductCarousel.astro
// Momentum card carousel with interactive technical spec closures.
// All visuals are SVG or plain ASCII glyphs — no emojis.

interface Props {
	title?: string;
	subtitle?: string;
	showViewAllButton?: boolean;
}

const {
	title = 'State-of-the-Art Water Treatment Plants',
	subtitle = 'Engineered using premium Stainless Steel 304/316, FRP composite vessels, and imported high-rejection membranes.',
	showViewAllButton = true,
} = Astro.props;

interface ProductItem {
	id: string;
	title: string;
	badge: string;
	badgeType: 'blue' | 'teal' | 'dark';
	image: string;
	description: string;
	specs: string[];
	extendedSpecs: { label: string; value: string }[];
	capacity: string;
	quoteName: string;
	href: string;
}

const products: ProductItem[] = [
	{
		id: 'industrial-ro',
		title: 'Industrial RO & sea water plants',
		badge: '500 to 50,000+ LPH',
		badgeType: 'blue',
		image: '/images/hero-plant.jpg',
		description: 'Heavy-duty reverse osmosis for borewell, river and seawater desalination — high recovery, low energy.',
		specs: [
			'SS 304 / 316 skid-mounted framework',
			'Imported TFC 8040 polyamide membranes',
			'Vertical multistage high-pressure pump',
			'Digital conductivity & flow monitoring',
		],
		extendedSpecs: [
			{ label: 'System recovery', value: '65–85% efficiency' },
			{ label: 'Operating pressure', value: '14–18 bar continuous' },
			{ label: 'Skid construction', value: 'Full SS 304 / 316 industrial' },
			{ label: 'Automation', value: 'PLC / touchscreen HMI' },
		],
		capacity: '5000 LPH',
		quoteName: 'Industrial RO Plant',
		href: '/products#industrial-ro',
	},
	{
		id: 'commercial-ro',
		title: 'Commercial RO systems',
		badge: '25 to 1000 LPH',
		badgeType: 'teal',
		image: '/images/commercial-ro.jpg',
		description: 'Standardized commercial models for schools, hospitals, hotels, canteens and societies.',
		specs: [
			'Models: 25, 50, 100, 250, 500, 1000 LPH',
			'FRP / SS vessels with 5-micron pre-filter',
			'Dual flow rota meters & pressure switches',
			'Automatic flush & UV disinfection',
		],
		extendedSpecs: [
			{ label: 'Pure water recovery', value: '50–60% recovery' },
			{ label: 'Power input', value: 'Single / 3-phase 220V–415V' },
			{ label: 'Pre-filtration', value: 'Sand + carbon dual vessel' },
			{ label: 'Disinfection', value: 'Inline UV chamber' },
		],
		capacity: '1000 LPH',
		quoteName: 'Commercial RO Plant',
		href: '/products#commercial-ro',
	},
	{
		id: 'settling-plants',
		title: 'Secondary settling tank & multi-media filter',
		badge: 'Skid-mounted',
		badgeType: 'teal',
		image: '/images/secondary-settling-plant.jpg',
		description: 'Hopper-bottom conical settling, mixed-bed filtration, chemical dosing and automation for industrial wastewater.',
		specs: [
			'Hopper-bottom conical tank with center feed well',
			'Multi-media sand & anthracite filter column',
			'Coagulant & polymer dosing drums',
			'Central control panel & sludge discharge',
		],
		extendedSpecs: [
			{ label: 'Settling method', value: 'Gravity clarifier with conical sludge drain' },
			{ label: 'Filtration stage', value: 'High-rate multi-media column' },
			{ label: 'Skid construction', value: 'Epoxy-coated structural steel' },
			{ label: 'Pollution norms', value: 'GPCB & CPCB discharge limits' },
		],
		capacity: 'Turnkey skid',
		quoteName: 'Secondary Settling Tank Plant',
		href: '/products#settling-plants',
	},
	{
		id: 'boiler-plant',
		title: 'Industrial boiler plants & steam',
		badge: 'Thermal',
		badgeType: 'blue',
		image: '/images/boiler-plant.jpg',
		description: 'Super Economizer, step-fired multi-fuel burners (gas, propane, biogas, oil), rapid start-up, fuel savings.',
		specs: [
			'Super Economizer waste-heat recovery',
			'Multi-fuel step-fired burner',
			'Up to 98% thermal efficiency',
			'Automated feedwater deaerator & softening',
		],
		extendedSpecs: [
			{ label: 'Thermal efficiency', value: 'Up to 98% with condensing economizer' },
			{ label: 'Multi-fuel burner', value: 'Gas, LPG, biogas, heavy & light oil' },
			{ label: 'Burner control', value: 'Modulating PLC with O2 trim' },
			{ label: 'Feedwater quality', value: 'Zero-hardness softened feed' },
		],
		capacity: 'Turnkey steam',
		quoteName: 'Industrial Boiler Plant',
		href: '/products#boiler-plant',
	},
	{
		id: 'etp-plants',
		title: 'Effluent treatment plants (ETP)',
		badge: 'Turnkey ETP',
		badgeType: 'blue',
		image: '/images/etp-stp-plant.jpg',
		description: 'Industrial wastewater design with BOD, COD and nitrogen removal for zero liquid discharge.',
		specs: [
			'Equalization, flash mixing & clariflocculator',
			'High-volume load & fast recovery',
			'Sludge filter press & aeration basins',
			'Savings on discharge costs',
		],
		extendedSpecs: [
			{ label: 'BOD reduction', value: '> 90%' },
			{ label: 'COD reduction', value: '> 85%' },
			{ label: 'Sludge output', value: 'Dewatered dry cake' },
			{ label: 'Compliance', value: 'GPCB / CPCB ZLD' },
		],
		capacity: '50 KLD',
		quoteName: 'Effluent Treatment Plant (ETP)',
		href: '/products#etp-plants',
	},
	{
		id: 'stp-plants',
		title: 'Sewage treatment plants (STP)',
		badge: 'DELTA PR',
		badgeType: 'teal',
		image: '/images/clarifier-hero-bg.jpg',
		description: 'Fully biological STP compliant with Marpol 73/78 Annex IV, European Maritime Council & USCG.',
		specs: [
			'TSS < 50 mg/L guaranteed',
			'BOD5 < 50 mg/L · coliform < 200/100 mL',
			'Tanks, air blowers, pump & chlorine dosing',
			'Treated water safe for reuse',
		],
		extendedSpecs: [
			{ label: 'Biological tech', value: 'MBBR / SBR skid' },
			{ label: 'Civil footprint', value: 'Up to 40% more compact' },
			{ label: 'Aeration', value: 'Submerged fine bubble diffusers' },
			{ label: 'Reuse quality', value: 'Flushing & landscape safe' },
		],
		capacity: '20 KLD',
		quoteName: 'Sewage Treatment Plant (STP)',
		href: '/products#stp-plants',
	},
	{
		id: 'dm-plants',
		title: 'Water softeners & DM plants',
		badge: 'Ion exchange',
		badgeType: 'blue',
		image: '/images/dm-softener.jpg',
		description: 'Strong cation & anion exchange delivering hardness-free, ultra-low conductivity water.',
		specs: [
			'Manual & semi-auto multiport valves',
			'MS & FRP resin vessels with brine tank',
			'DM cation (H⁺) & anion (OH⁻) columns',
			'Mix bed: D.M 100 to D.M 800 (8,000 L/hr)',
		],
		extendedSpecs: [
			{ label: 'Water hardness', value: '< 5 ppm (as CaCO₃)' },
			{ label: 'DM conductivity', value: '< 0.5 µS/cm (mix bed)' },
			{ label: 'Resin type', value: 'High-capacity Dow / Lanxess' },
			{ label: 'Regeneration', value: 'Automated brine / acid draw' },
		],
		capacity: '2000 L/hr',
		quoteName: 'Water Softener / DM Plant',
		href: '/products#dm-plants',
	},
	{
		id: 'industrial-chemicals',
		title: 'Water treatment chemicals & media',
		badge: 'Chemicals',
		badgeType: 'dark',
		image: '/images/water-testing-lab.jpg',
		description: 'Factory inventory of RO antiscalants, membrane cleaners, biocides, coagulants & ion-exchange resins.',
		specs: [
			'High-performance RO antiscalants',
			'Acidic & alkaline membrane cleaners',
			'Coagulants & poly-electrolytes',
			'Cation & anion exchange resins',
		],
		extendedSpecs: [
			{ label: 'Antiscalant', value: 'High silica & hardness inhibition' },
			{ label: 'Biocides', value: 'Non-oxidizing & food-grade approved' },
			{ label: 'Packaging', value: '30 kg & 50 kg HDPE drums' },
			{ label: 'Testing', value: 'Water titration & dosing calculation' },
		],
		capacity: 'Factory direct',
		quoteName: 'Water Treatment Chemicals Requirement',
		href: '/products#industrial-chemicals',
	},
];

/* Inline SVG icons */
const icons = {
	grid: `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
	chevronLeft: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>`,
	chevronRight: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>`,
	check: `<svg class="check-bullet" width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>`,
	arrowRight: `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`,
	arrowRightBig: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`,
	swipe: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`,
};
---

<section class="section section-alt product-carousel-section" id="products">
	<div class="container">
		<!-- Header -->
		<div class="carousel-header-row">
			<div class="carousel-title-col">
				<span class="eyebrow-tag">
					<span set:html={icons.grid} />
					<span>Product profile</span>
				</span>
				<h2 class="carousel-heading">{title}</h2>
				<p class="carousel-subheading">{subtitle}</p>
			</div>

			<div class="carousel-nav-controls" aria-label="Carousel navigation">
				<div class="carousel-counter" aria-live="polite">
					<span class="counter-active" id="carousel-current-index">01</span>
					<span class="counter-sep">/</span>
					<span class="counter-total">{String(products.length).padStart(2, '0')}</span>
				</div>
				<div class="carousel-arrow-group">
					<button type="button" class="carousel-nav-btn prev-btn" id="carousel-prev-btn" aria-label="Previous product" title="Previous product">
						<span set:html={icons.chevronLeft} />
					</button>
					<button type="button" class="carousel-nav-btn next-btn" id="carousel-next-btn" aria-label="Next product" title="Next product">
						<span set:html={icons.chevronRight} />
					</button>
				</div>
			</div>
		</div>

		<!-- Rail -->
		<div
			class="carousel-rail-wrapper"
			id="product-carousel-rail"
			role="region"
			aria-roledescription="carousel"
			aria-label="Water treatment plants carousel"
			tabindex="0"
		>
			<div class="carousel-track" id="product-carousel-track">
				{products.map((item, idx) => (
					<article
						class="carousel-card-item"
						data-index={idx}
						data-id={item.id}
						id={`card-${item.id}`}
						role="group"
						aria-roledescription="slide"
						aria-label={`${idx + 1} of ${products.length}: ${item.title}`}
					>
						<div class="rail-card-inner">
							<div class="card-media-wrapper">
								<img
									src={item.image}
									alt={item.title}
									class="card-product-img"
									loading="lazy"
									draggable="false"
								/>
								<div class="card-media-overlay"></div>
								<span class={`card-category-badge badge-${item.badgeType}`}>{item.badge}</span>
							</div>

							<div class="card-content-body">
								<h3 class="card-product-title">{item.title}</h3>
								<p class="card-product-desc">{item.description}</p>

								<ul class="card-features-list" role="list">
									{item.specs.map((spec) => (
										<li>
											<span set:html={icons.check} />
											<span>{spec}</span>
										</li>
									))}
								</ul>

								<div class="specs-closure-wrapper">
									<button
										type="button"
										class="closure-toggle-btn"
										data-toggle-target={`specs-panel-${item.id}`}
										aria-expanded="false"
										aria-controls={`specs-panel-${item.id}`}
									>
										<span class="closure-toggle-text">
											<span class="icon-toggle-indicator" aria-hidden="true">+</span>
											<span class="label-text">Technical specifications</span>
										</span>
										<span class="closure-hint">Click to view</span>
									</button>

									<div class="closure-content-panel" id={`specs-panel-${item.id}`} hidden>
										<div class="closure-specs-grid">
											{item.extendedSpecs.map((ext) => (
												<div class="closure-spec-item">
													<span class="spec-prop-label">{ext.label}</span>
													<span class="spec-prop-val">{ext.value}</span>
												</div>
											))}
										</div>
									</div>
								</div>

								<div class="card-action-bar">
									<button
										type="button"
										class="btn btn-primary btn-sm btn-quote-action"
										data-quote-trigger
										data-plant={item.quoteName}
										data-capacity={item.capacity}
									>
										<span>Get quote</span>
										<span set:html={icons.arrowRight} />
									</button>

									<a href={item.href} class="btn-specs-link">
										<span>Specs sheet</span>
										<span set:html={icons.arrowRight} />
									</a>
								</div>
							</div>
						</div>
					</article>
				))}
			</div>
		</div>

		<!-- Bottom -->
		<div class="carousel-bottom-bar">
			<div class="carousel-dots-track" id="carousel-dots" role="tablist" aria-label="Slide dots">
				{products.map((item, idx) => (
					<button
						type="button"
						class={`carousel-dot-btn ${idx === 0 ? 'active' : ''}`}
						data-slide-index={idx}
						aria-label={`Go to slide ${idx + 1}: ${item.title}`}
						role="tab"
						aria-selected={idx === 0 ? 'true' : 'false'}
					></button>
				))}
			</div>

			<div class="carousel-swipe-hint">
				<span set:html={icons.swipe} />
				<span>Drag or swipe cards to explore</span>
			</div>
		</div>

		{showViewAllButton && (
			<div class="view-all-cta">
				<a href="/products" class="btn btn-primary btn-lg">
					<span>View complete specifications &amp; engineering data</span>
					<span set:html={icons.arrowRightBig} />
				</a>
			</div>
		)}
	</div>
</section>

<style>
	/* ==========================================================
	   SECTION / HEADER
	   ========================================================== */
	.product-carousel-section {
		position: relative;
		overflow: hidden;
		padding: 3.5rem 0;
	}

	.carousel-header-row {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
	}

	.carousel-title-col { max-width: 680px; }

	.eyebrow-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		background: var(--brand-50);
		color: var(--brand-500);
		padding: 0.3rem 0.75rem;
		border-radius: var(--radius-pill);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		margin-bottom: 0.7rem;
	}

	:global(html.dark) .eyebrow-tag {
		background: rgba(2, 132, 199, 0.18);
		color: var(--brand-400);
	}

	.carousel-heading {
		font-size: clamp(1.6rem, 2.8vw, 2.15rem);
		font-weight: 700;
		color: var(--ink-900);
		line-height: 1.2;
		letter-spacing: -0.02em;
		margin-bottom: 0.5rem;
	}

	:global(html.dark) .carousel-heading { color: #ffffff; }

	.carousel-subheading {
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--ink-400);
		margin: 0;
	}

	:global(html.dark) .carousel-subheading { color: var(--ink-300); }

	/* ==========================================================
	   CONTROLS
	   ========================================================== */
	.carousel-nav-controls {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		flex-shrink: 0;
	}

	.carousel-counter {
		display: flex;
		align-items: baseline;
		gap: 0.25rem;
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--ink-900);
		background: var(--surface);
		border: 1px solid var(--line-200);
		padding: 0.35rem 0.85rem;
		border-radius: var(--radius-pill);
	}

	:global(html.dark) .carousel-counter {
		background: var(--surface-dark-2);
		border-color: rgba(255, 255, 255, 0.12);
		color: #f1f5f9;
	}

	.counter-active { color: var(--brand-500); font-weight: 800; }
	:global(html.dark) .counter-active { color: var(--brand-400); }

	.counter-sep,
	.counter-total {
		color: var(--ink-400);
		font-size: 0.8rem;
	}

	.carousel-arrow-group {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.carousel-nav-btn {
		width: 42px;
		height: 42px;
		border-radius: 50%;
		border: 1.5px solid var(--line-300);
		background: var(--surface);
		color: var(--ink-900);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: background 0.2s var(--ease), border-color 0.2s var(--ease),
			color 0.2s var(--ease), transform 0.2s var(--ease);
	}

	:global(html.dark) .carousel-nav-btn {
		background: var(--surface-dark-2);
		border-color: rgba(255, 255, 255, 0.15);
		color: #f1f5f9;
	}

	.carousel-nav-btn:hover:not(:disabled) {
		background: var(--brand-500);
		border-color: var(--brand-500);
		color: #ffffff;
		transform: scale(1.05);
	}

	.carousel-nav-btn:active:not(:disabled) { transform: scale(0.95); }

	.carousel-nav-btn:disabled {
		opacity: 0.35;
		cursor: not-allowed;
		transform: none;
	}

	.carousel-nav-btn:focus-visible {
		outline: 3px solid var(--brand-400);
		outline-offset: 2px;
	}

	/* ==========================================================
	   RAIL / TRACK
	   ========================================================== */
	.carousel-rail-wrapper {
		width: 100%;
		overflow-x: auto;
		scroll-behavior: smooth;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		outline: none;
		cursor: grab;
		user-select: none;
		-webkit-user-select: none;
		padding: 0.4rem 0.25rem 0.85rem;
		margin: 0 -0.25rem;
	}

	.carousel-rail-wrapper::-webkit-scrollbar { display: none; }

	.carousel-rail-wrapper.is-dragging {
		cursor: grabbing;
		scroll-behavior: auto;
	}

	.carousel-track {
		display: flex;
		gap: 1.5rem;
		width: max-content;
		padding-right: 1.5rem;
	}

	.carousel-card-item {
		width: 380px;
		max-width: 85vw;
		flex-shrink: 0;
		scroll-snap-align: start;
	}

	.rail-card-inner {
		background: var(--surface);
		border: 1px solid var(--line-200);
		border-radius: var(--radius-lg);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		height: 100%;
		transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease),
			border-color 0.3s var(--ease);
	}

	:global(html.dark) .rail-card-inner {
		background: var(--surface-dark-2);
		border-color: rgba(255, 255, 255, 0.08);
	}

	.rail-card-inner:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-md);
		border-color: var(--brand-500);
	}

	:global(html.dark) .rail-card-inner:hover {
		border-color: var(--brand-400);
	}

	/* Card media */
	.card-media-wrapper {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #0f172a;
	}

	.card-product-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s var(--ease);
		pointer-events: none;
	}

	.rail-card-inner:hover .card-product-img { transform: scale(1.05); }

	.card-media-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 40%, rgba(15, 23, 42, 0.6) 100%);
		pointer-events: none;
	}

	.card-category-badge {
		position: absolute;
		bottom: 0.85rem;
		left: 0.85rem;
		padding: 0.3rem 0.7rem;
		border-radius: var(--radius-pill);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
		z-index: 2;
	}

	.badge-blue  { background: rgba(2, 132, 199, 0.94); color: #ffffff; }
	.badge-teal  { background: rgba(16, 185, 129, 0.94); color: #ffffff; }
	.badge-dark  { background: rgba(15, 23, 42, 0.92); color: #ffffff; }

	/* ==========================================================
	   CARD CONTENT
	   ========================================================== */
	.card-content-body {
		padding: 1.35rem;
		display: flex;
		flex-direction: column;
