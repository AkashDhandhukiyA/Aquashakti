---
// src/components/Footer.astro
// World-class, modern, premium Footer for Aqua Shakti Industries.
// Features: Pre-Footer CTA Card, 5-Column Directory,
// and Smooth Back-to-Top Button.

import Logo from './Logo.astro';
import { COMPANY_NAME, COMPANY_PHONE, COMPANY_ESTD } from '../consts';

interface Props {
	showPreFooter?: boolean;
}

const { showPreFooter = true } = Astro.props;
const today = new Date();
---

<footer class:list={["site-footer-wrapper", { "no-prefooter": !showPreFooter }]}>
	<!-- 1. Pre-Footer "Ready to build something amazing?" CTA Card -->
	{showPreFooter && (
		<div class="pre-footer-cta-container">
			<div class="pre-footer-card">
				<div class="pre-footer-ambient-mesh" aria-hidden="true"></div>
				
				<div class="pre-footer-content">
					<span class="pre-footer-tag">TURNKEY ENGINEERING EXCELLENCE</span>
					<h2 class="pre-footer-heading">Ready to build something amazing?</h2>
					<p class="pre-footer-sub">
						Join over 500+ satisfied industrial factories, pharmaceuticals, hotels, and chemical plants across Gujarat and India. Get custom P&ID engineering, water analysis, and factory-direct pricing.
					</p>

					<div class="pre-footer-actions">
						<button type="button" class="btn-gradient-prefooter" data-quote-trigger data-plant="Complete Project Consultation">
							<span class="cta-shine-layer"></span>
							<span>Request Free Plant Sizing & Proposal</span>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</button>
						<a href={`tel:${COMPANY_PHONE.replace(/\s+/g, '')}`} class="btn-secondary-prefooter">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
							<span>Direct Engineer: {COMPANY_PHONE}</span>
						</a>
					</div>

					<div class="pre-footer-perks">
						<span>✓ ISO 9001:2008 Certified</span>
						<span>•</span>
						<span>✓ 18+ Years Estd {COMPANY_ESTD}</span>
						<span>•</span>
						<span>✓ 500+ Satisfied Clients</span>
						<span>•</span>
						<span>✓ Complete Turnkey Warranty</span>
					</div>
				</div>
			</div>
		</div>
	)}

	<!-- 2. Main Footer Body -->
	<div class="site-footer-main">
		<div class="site-footer-container">
			<div class="footer-primary-grid">
				<!-- Brand Column -->
				<div class="footer-col brand-col">
					<a href="/" class="footer-brand-link" aria-label="Aqua Shakti Home">
						<Logo size="md" showTagline={true} />
					</a>
					<p class="brand-bio">
						Established in {COMPANY_ESTD} in Vapi, Gujarat, <strong>{COMPANY_NAME}</strong> is an ISO 9001:2008 certified turnkey manufacturer, supplier, and service provider of industrial reverse osmosis, wastewater recycling, and chemical water treatment systems.
					</p>

					<!-- Live Operational Status Indicator -->
					<div class="status-indicator-pill">
						<span class="status-pulse-dot"></span>
						<span class="status-label">Factory & Testing Labs Operational</span>
						<span class="status-latency">Chanod, Vapi</span>
					</div>

					<!-- Certifications -->
					<div class="compliance-badges-row">
						<span class="comp-badge">ISO 9001:2008</span>
						<span class="comp-badge">Make in India</span>
						<span class="comp-badge">GPCB Approved</span>
					</div>
				</div>

				<!-- Column 1: Pure Water Plants -->
				<div class="footer-col footer-accordion">
					<button type="button" class="footer-accordion-btn" aria-expanded="false">
						<h4 class="footer-heading">Pure Water Plants</h4>
						<span class="acc-toggle-icon" aria-hidden="true">
							<span class="acc-icon-h"></span>
							<span class="acc-icon-v"></span>
						</span>
					</button>
					<div class="footer-accordion-content">
						<ul class="footer-links-list">
							<li><a href="/products#industrial-ro">Industrial RO Plants <span class="badge-sub-pill">50k LPH</span></a></li>
							<li><a href="/products#commercial-ro">Commercial RO (25 - 1000 LPH)</a></li>
							<li><a href="/products#softeners">Water Softener Plants</a></li>
							<li><a href="/products#dm-plants">Demineralization (DM) & Mix Bed</a></li>
							<li><a href="/products#ozonation">Ozonation & Mineral Packaging</a></li>
							<li><a href="/products#chilling">Online Chilling & Water Coolers</a></li>
							<li><a href="/products#boiler-plant">Boiler Feed Water Treatment</a></li>
						</ul>
					</div>
				</div>

				<!-- Column 2: Wastewater & ETP/STP -->
				<div class="footer-col footer-accordion">
					<button type="button" class="footer-accordion-btn" aria-expanded="false">
						<h4 class="footer-heading">Wastewater & Recycling</h4>
						<span class="acc-toggle-icon" aria-hidden="true">
							<span class="acc-icon-h"></span>
							<span class="acc-icon-v"></span>
						</span>
					</button>
					<div class="footer-accordion-content">
						<ul class="footer-links-list">
							<li><a href="/products#etp-plants">Effluent Treatment Plants (ETP)</a></li>
							<li><a href="/products#stp-plants">Sewage Treatment (STP)</a></li>
							<li><a href="/products#settling-plants">Secondary Settling Tanks</a></li>
							<li><a href="/products#etp-plants">Sludge Filter Press Systems</a></li>
							<li><a href="/products#stp-plants">DELTA PR Biological Tech</a></li>
							<li><a href="/products#etp-plants">Zero Liquid Discharge (ZLD)</a></li>
							<li><a href="/blog/etp-vs-stp-plant-differences">ETP vs STP Comparison Guide</a></li>
						</ul>
					</div>
				</div>

				<!-- Column 3: Components & Spares -->
				<div class="footer-col footer-accordion">
					<button type="button" class="footer-accordion-btn" aria-expanded="false">
						<h4 class="footer-heading">Components & Media</h4>
						<span class="acc-toggle-icon" aria-hidden="true">
							<span class="acc-icon-h"></span>
							<span class="acc-icon-v"></span>
						</span>
					</button>
					<div class="footer-accordion-content">
						<ul class="footer-links-list">
							<li><a href="/products#components">High Pressure Multistage Pumps</a></li>
							<li><a href="/products#components">SS 304 & FRP Membrane Housings</a></li>
							<li><a href="/products#components">Imported TFC Membranes (Dow)</a></li>
							<li><a href="/products#chemicals">Antiscalant & Descaling Acids</a></li>
							<li><a href="/products#chemicals">Activated Carbon & Resins</a></li>
							<li><a href="/products#components">Automatic Multiport Valves</a></li>
							<li><a href="/products#components">Pressure Gauges & Flow Meters</a></li>
						</ul>
					</div>
				</div>

				<!-- Column 4: Company & Support -->
				<div class="footer-col footer-accordion">
					<button type="button" class="footer-accordion-btn" aria-expanded="false">
						<h4 class="footer-heading">Company & Guides</h4>
						<span class="acc-toggle-icon" aria-hidden="true">
							<span class="acc-icon-h"></span>
							<span class="acc-icon-v"></span>
						</span>
					</button>
					<div class="footer-accordion-content">
						<ul class="footer-links-list">
							<li><a href="/about">About Us & Company History</a></li>
							<li><a href="/about#team">Specialized Engineering Team</a></li>
							<li><a href="/about#dealers">Regional Dealer Network</a></li>
							<li><a href="/blog">Water Treatment Blog</a></li>
							<li><a href="/contact">Factory Location & Inquiry</a></li>
							<li><a href="/#clients">500+ Satisfied Clients</a></li>
							<li><a href="/contact">1-Year Performance Warranty</a></li>
						</ul>
					</div>
				</div>

				<!-- Column 5: Works & Laboratory Closure -->
				<div class="footer-col footer-accordion">
					<button type="button" class="footer-accordion-btn" aria-expanded="false">
						<h4 class="footer-heading">Works & Laboratory</h4>
						<span class="acc-toggle-icon" aria-hidden="true">
							<span class="acc-icon-h"></span>
							<span class="acc-icon-v"></span>
						</span>
					</button>
					<div class="footer-accordion-content">
						<div class="footer-contact-card">
							<p class="contact-location">
								<strong>Aqua Shakti Works & Labs:</strong><br />
								Vapi Timber Compound, Opp. Chandralok Tower, Nr. D Mart, Chanod, Vapi - 396 195 (Gujarat)
							</p>
							<div class="contact-quick-links">
								<a href={`tel:${COMPANY_PHONE.replace(/\s+/g, '')}`} class="contact-mini-row">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
									<span>Hotline: {COMPANY_PHONE}</span>
								</a>
								<a href="mailto:aquashakti99@gmail.com" class="contact-mini-row">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
									<span>aquashakti99@gmail.com</span>
								</a>
								<span class="contact-timings-badge">
									🕒 Mon - Sat: 9:00 AM - 7:30 PM
								</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- 3. Bottom Copyright & Back-to-Top Bar -->
			<div class="footer-bottom-strip">
				<div class="bottom-left-meta">
					<p class="copyright-text">
						&copy; {today.getFullYear()} <strong>{COMPANY_NAME}</strong>. All rights reserved. Ideal Solution for all types of Water.
					</p>
					<span class="crafted-text">Engineered with <span class="heart-pulse">❤️</span> in Vapi, Gujarat (India).</span>
				</div>

				<div class="bottom-right-meta">
					<div class="legal-mini-links">
						<a href="/products">Products</a>
						<span>•</span>
						<a href="/blog">Blog</a>
						<span>•</span>
						<a href="/contact">Contact</a>
					</div>

					<!-- Back to Top Button -->
					<button type="button" class="back-to-top-btn" id="footer-back-to-top" aria-label="Scroll back to top of page">
						<span>Back to Top</span>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m18 15-6-6-6 6"/></svg>
					</button>
				</div>
			</div>
		</div>
	</div>
</footer>

<style>
	/* ==========================================================================
	   World-Class Aqua Shakti Footer Styles
	   ========================================================================== */

	.site-footer-wrapper {
		background: #f8fafc;
		border-top: 1px solid rgba(226, 232, 240, 0.9);
		position: relative;
		overflow: hidden;
		transition: background-color 0.35s ease;
		margin-top: 5rem;
	}

	:global(html.dark) .site-footer-wrapper {
		background: #080d1a;
		border-top-color: rgba(255, 255, 255, 0.08);
	}

	/* Pre-Footer CTA Card */
	.pre-footer-cta-container {
		max-width: 1380px;
		margin: -3.5rem auto 3.5rem auto;
		padding: 0 1.5rem;
		position: relative;
		z-index: 10;
	}

	.pre-footer-card {
		background: linear-gradient(135deg, rgba(2, 132, 199, 0.07) 0%, rgba(6, 182, 212, 0.07) 50%, rgba(16, 185, 129, 0.09) 100%), #ffffff;
		border: 1px solid rgba(2, 132, 199, 0.25);
		border-radius: 28px;
		padding: 4.5rem 2.5rem;
		box-shadow: 0 24px 64px -12px rgba(15, 23, 42, 0.1);
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	:global(html.dark) .pre-footer-card {
		background: linear-gradient(135deg, rgba(2, 132, 199, 0.14) 0%, rgba(6, 182, 212, 0.12) 50%, rgba(16, 185, 129, 0.16) 100%), #0f172a;
		border-color: rgba(255, 255, 255, 0.12);
		box-shadow: 0 30px 80px -15px rgba(0, 0, 0, 0.55);
	}

	.pre-footer-ambient-mesh {
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.25) 0%, transparent 60%);
		pointer-events: none;
	}

	.pre-footer-content {
		position: relative;
		z-index: 1;
		max-width: 760px;
		margin: 0 auto;
	}

	.pre-footer-tag {
		font-family: var(--font-display, sans-serif);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: #0284c7;
		background: rgba(2, 132, 199, 0.1);
		padding: 0.25rem 0.85rem;
		border-radius: 9999px;
		margin-bottom: 1.25rem;
		display: inline-block;
	}

	:global(html.dark) .pre-footer-tag {
		color: #38bdf8;
		background: rgba(56, 189, 248, 0.15);
	}

	.pre-footer-heading {
		font-family: var(--font-display, sans-serif);
		font-size: clamp(2rem, 3.8vw, 3.2rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: #0f172a;
		margin: 0 0 1rem 0;
		line-height: 1.15;
	}

	:global(html.dark) .pre-footer-heading { color: #ffffff; }

	.pre-footer-sub {
		font-size: 1.15rem;
		line-height: 1.6;
		color: #475569;
		margin: 0 0 2.25rem 0;
	}

	:global(html.dark) .pre-footer-sub { color: #94a3b8; }

	.pre-footer-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 2rem;
	}

	.btn-gradient-prefooter {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.95rem 2.25rem;
		font-size: 1rem;
		font-weight: 600;
		border-radius: 16px;
		background: linear-gradient(135deg, #0284c7 0%, #06b6d4 50%, #10b981 100%);
		background-size: 200% auto;
		color: #ffffff;
		border: none;
		cursor: pointer;
		box-shadow: 0 8px 24px -2px rgba(2, 132, 199, 0.45);
		position: relative;
		overflow: hidden;
		transition: all 0.35s ease;
	}

	.btn-gradient-prefooter:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 30px -2px rgba(16, 185, 129, 0.55);
		background-position: right center;
	}

	.cta-shine-layer {
		position: absolute;
		top: 0;
		left: -100%;
		width: 60%;
		height: 100%;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
		transform: skewX(-25deg);
		transition: left 0.75s ease;
	}

	.btn-gradient-prefooter:hover .cta-shine-layer {
		left: 140%;
	}

	.btn-secondary-prefooter {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.95rem 2rem;
		font-size: 1rem;
		font-weight: 600;
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid rgba(226, 232, 240, 0.9);
		color: #1e293b;
		text-decoration: none;
		transition: all 0.25s ease;
	}

	:global(html.dark) .btn-secondary-prefooter {
		background: rgba(255, 255, 255, 0.06);
		border-color: rgba(255, 255, 255, 0.12);
		color: #e2e8f0;
	}

	.btn-secondary-prefooter:hover {
		background: #ffffff;
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
	}

	:global(html.dark) .btn-secondary-prefooter:hover {
		background: rgba(255, 255, 255, 0.1);
	}

	.pre-footer-perks {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		font-size: 0.82rem;
		color: #64748b;
		flex-wrap: wrap;
	}

	:global(html.dark) .pre-footer-perks { color: #94a3b8; }

	/* Main Footer Container */
	.site-footer-main {
		padding: 3rem 1.5rem 2rem 1.5rem;
	}

	.site-footer-container {
		max-width: 1400px;
		margin: 0 auto;
	}

	/* Primary 6-Column Grid */
	.footer-primary-grid {
		display: grid;
		grid-template-columns: 1.8fr 1fr 1fr 1fr 1fr 1.2fr;
		gap: 2.25rem;
		margin-bottom: 3rem;
		padding-bottom: 3rem;
		border-bottom: 1px solid rgba(226, 232, 240, 0.8);
	}

	:global(html.dark) .footer-primary-grid {
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	.brand-col {
		padding-right: 1.5rem;
	}

	.footer-brand-link {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		margin-bottom: 1.25rem;
	}

	.brand-bio {
		font-size: 0.92rem;
		line-height: 1.6;
		color: #64748b;
		margin-bottom: 1.5rem;
	}

	:global(html.dark) .brand-bio { color: #94a3b8; }

	.status-indicator-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.4rem 0.85rem;
		border-radius: 9999px;
		background: rgba(16, 185, 129, 0.08);
		border: 1px solid rgba(16, 185, 129, 0.25);
		font-size: 0.75rem;
		color: #065f46;
		margin-bottom: 1.5rem;
	}

	:global(html.dark) .status-indicator-pill {
		background: rgba(16, 185, 129, 0.15);
		color: #6ee7b7;
		border-color: rgba(16, 185, 129, 0.3);
	}

	.status-pulse-dot {
		width: 7px;
		height: 7px;
		background: #10b981;
		border-radius: 50%;
		box-shadow: 0 0 8px #10b981;
		animation: pulseDot 2s infinite ease-in-out;
	}

	.status-label { font-weight: 700; }
	.status-latency { color: #64748b; }
	:global(html.dark) .status-latency { color: #94a3b8; }

	.compliance-badges-row {
		display: flex;
		gap: 0.45rem;
		flex-wrap: wrap;
	}

	.comp-badge {
		font-size: 0.68rem;
		font-weight: 700;
		padding: 0.2rem 0.55rem;
		border-radius: 6px;
		background: rgba(0, 0, 0, 0.04);
		border: 1px solid rgba(0, 0, 0, 0.06);
		color: #475569;
	}

	:global(html.dark) .comp-badge {
		background: rgba(255, 255, 255, 0.06);
		border-color: rgba(255, 255, 255, 0.1);
		color: #cbd5e1;
	}

	/* Footer Column Styles */
	.footer-heading {
		font-family: var(--font-display, sans-serif);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #0f172a;
		margin: 0 0 1.25rem 0;
	}

	:global(html.dark) .footer-heading { color: #ffffff; }

	.footer-links-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.footer-links-list a {
		font-size: 0.9rem;
		color: #64748b;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		transition: all 0.2s ease;
	}

	:global(html.dark) .footer-links-list a { color: #94a3b8; }

	.footer-links-list a:hover {
		color: #0284c7;
		transform: translateX(3px);
	}

	:global(html.dark) .footer-links-list a:hover { color: #38bdf8; }

	.badge-sub-pill {
		font-size: 0.62rem;
		font-weight: 700;
		padding: 0.1rem 0.4rem;
		border-radius: 9999px;
		background: rgba(2, 132, 199, 0.1);
		color: #0284c7;
	}

	/* Accordion Base (Desktop defaults: fully open, button is passive heading wrapper) */
	.footer-accordion-btn {
		width: auto;
		display: block;
		padding: 0;
		background: transparent;
		border: none;
		cursor: default;
		pointer-events: none;
		text-align: left;
	}

	.acc-toggle-icon {
		display: none;
	}

	.footer-accordion-content {
		display: block;
	}

	/* Footer Contact Card (Works & Lab) */
	.footer-contact-card {
		font-size: 0.88rem;
		color: #64748b;
		line-height: 1.5;
	}

	:global(html.dark) .footer-contact-card {
		color: #94a3b8;
	}

	.contact-location {
		margin-bottom: 0.85rem;
		font-size: 0.85rem;
		line-height: 1.45;
	}

	.contact-location strong {
		color: #0f172a;
	}

	:global(html.dark) .contact-location strong {
		color: #f1f5f9;
	}

	.contact-quick-links {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.contact-mini-row {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: #0284c7;
		font-weight: 600;
