---
// src/components/Footer.astro
// World-class Footer — SVG icons only, no emojis.
import Logo from './Logo.astro';
import { COMPANY_NAME, COMPANY_PHONE, COMPANY_ESTD } from '../consts';

interface Props {
	showPreFooter?: boolean;
}

const { showPreFooter = true } = Astro.props;
const today = new Date();

/* Inline SVG icon set (Lucide-shaped, currentColor) */
const icons = {
	arrowRight: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`,
	arrowUp: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>`,
	phone: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
	phoneSmall: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
	mail: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
	clock: `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
	check: `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`,
	heart: `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
};
---

<footer class:list={["site-footer-wrapper", { "no-prefooter": !showPreFooter }]}>
	<!-- ============================================================
	     1. PRE-FOOTER CTA CARD
	     ============================================================ -->
	{showPreFooter && (
		<div class="pre-footer-cta-container">
			<div class="pre-footer-card">
				<div class="pre-footer-ambient-mesh" aria-hidden="true"></div>

				<div class="pre-footer-content">
					<span class="pre-footer-tag">Turnkey engineering excellence</span>
					<h2 class="pre-footer-heading">Ready to build something amazing?</h2>
					<p class="pre-footer-sub">
						Join 500+ industrial, pharma, hotel and chemical plants across Gujarat and India. Custom P&amp;ID engineering, water analysis and factory-direct pricing.
					</p>

					<div class="pre-footer-actions">
						<button type="button" class="btn-gradient-prefooter" data-quote-trigger data-plant="Complete Project Consultation">
							<span class="cta-shine-layer"></span>
							<span>Request free sizing &amp; proposal</span>
							<span set:html={icons.arrowRight} />
						</button>
						<a href={`tel:${COMPANY_PHONE.replace(/\s+/g, '')}`} class="btn-secondary-prefooter">
							<span set:html={icons.phone} />
							<span>Direct engineer: {COMPANY_PHONE}</span>
						</a>
					</div>

					<ul class="pre-footer-perks" role="list">
						<li><span set:html={icons.check} /><span>ISO 9001:2008 certified</span></li>
						<li><span set:html={icons.check} /><span>18+ years (estd {COMPANY_ESTD})</span></li>
						<li><span set:html={icons.check} /><span>500+ satisfied clients</span></li>
						<li><span set:html={icons.check} /><span>Complete turnkey warranty</span></li>
					</ul>
				</div>
			</div>
		</div>
	)}

	<!-- ============================================================
	     2. MAIN FOOTER BODY
	     ============================================================ -->
	<div class="site-footer-main">
		<div class="site-footer-container">
			<div class="footer-primary-grid">
				<!-- Brand column -->
				<div class="footer-col brand-col">
					<a href="/" class="footer-brand-link" aria-label={`${COMPANY_NAME} home`}>
						<Logo size="md" showTagline={true} />
					</a>
					<p class="brand-bio">
						Established {COMPANY_ESTD} in Vapi, Gujarat. <strong>{COMPANY_NAME}</strong> is an ISO 9001:2008 certified turnkey manufacturer of industrial RO, wastewater recycling and chemical water treatment systems.
					</p>

					<div class="status-indicator-pill">
						<span class="status-pulse-dot" aria-hidden="true"></span>
						<span class="status-label">Factory &amp; labs operational</span>
						<span class="status-latency">Chanod, Vapi</span>
					</div>

					<div class="compliance-badges-row">
						<span class="comp-badge">ISO 9001:2008</span>
						<span class="comp-badge">Make in India</span>
						<span class="comp-badge">GPCB Approved</span>
					</div>
				</div>

				<!-- Pure Water Plants -->
				<div class="footer-col footer-accordion">
					<button type="button" class="footer-accordion-btn" aria-expanded="false">
						<h4 class="footer-heading">Pure water plants</h4>
						<span class="acc-toggle-icon" aria-hidden="true">
							<span class="acc-icon-h"></span>
							<span class="acc-icon-v"></span>
						</span>
					</button>
					<div class="footer-accordion-content">
						<ul class="footer-links-list">
							<li><a href="/products#industrial-ro">Industrial RO <span class="badge-sub-pill">50k LPH</span></a></li>
							<li><a href="/products#commercial-ro">Commercial RO (25–1000 LPH)</a></li>
							<li><a href="/products#softeners">Water softener plants</a></li>
							<li><a href="/products#dm-plants">DM &amp; mix bed</a></li>
							<li><a href="/products#ozonation">Ozonation &amp; packaging</a></li>
							<li><a href="/products#chilling">Chilling &amp; water coolers</a></li>
							<li><a href="/products#boiler-plant">Boiler feed treatment</a></li>
						</ul>
					</div>
				</div>

				<!-- Wastewater -->
				<div class="footer-col footer-accordion">
					<button type="button" class="footer-accordion-btn" aria-expanded="false">
						<h4 class="footer-heading">Wastewater &amp; recycling</h4>
						<span class="acc-toggle-icon" aria-hidden="true">
							<span class="acc-icon-h"></span>
							<span class="acc-icon-v"></span>
						</span>
					</button>
					<div class="footer-accordion-content">
						<ul class="footer-links-list">
							<li><a href="/products#etp-plants">Effluent treatment (ETP)</a></li>
							<li><a href="/products#stp-plants">Sewage treatment (STP)</a></li>
							<li><a href="/products#settling-plants">Secondary settling tanks</a></li>
							<li><a href="/products#etp-plants">Sludge filter press</a></li>
							<li><a href="/products#stp-plants">DELTA PR biological</a></li>
							<li><a href="/products#etp-plants">Zero liquid discharge</a></li>
							<li><a href="/blog/etp-vs-stp-plant-differences">ETP vs STP guide</a></li>
						</ul>
					</div>
				</div>

				<!-- Components -->
				<div class="footer-col footer-accordion">
					<button type="button" class="footer-accordion-btn" aria-expanded="false">
						<h4 class="footer-heading">Components &amp; media</h4>
						<span class="acc-toggle-icon" aria-hidden="true">
							<span class="acc-icon-h"></span>
							<span class="acc-icon-v"></span>
						</span>
					</button>
					<div class="footer-accordion-content">
						<ul class="footer-links-list">
							<li><a href="/products#components">Multistage pumps</a></li>
							<li><a href="/products#components">SS 304 / FRP housings</a></li>
							<li><a href="/products#components">Imported TFC membranes</a></li>
							<li><a href="/products#chemicals">Antiscalant &amp; descalers</a></li>
							<li><a href="/products#chemicals">Carbon &amp; resins</a></li>
							<li><a href="/products#components">Multiport valves</a></li>
							<li><a href="/products#components">Gauges &amp; flow meters</a></li>
						</ul>
					</div>
				</div>

				<!-- Company -->
				<div class="footer-col footer-accordion">
					<button type="button" class="footer-accordion-btn" aria-expanded="false">
						<h4 class="footer-heading">Company &amp; guides</h4>
						<span class="acc-toggle-icon" aria-hidden="true">
							<span class="acc-icon-h"></span>
							<span class="acc-icon-v"></span>
						</span>
					</button>
					<div class="footer-accordion-content">
						<ul class="footer-links-list">
							<li><a href="/about">About us</a></li>
							<li><a href="/about#team">Engineering team</a></li>
							<li><a href="/about#dealers">Dealer network</a></li>
							<li><a href="/blog">Blog</a></li>
							<li><a href="/contact">Contact</a></li>
							<li><a href="/#clients">Our clients</a></li>
							<li><a href="/contact">1-year warranty</a></li>
						</ul>
					</div>
				</div>

				<!-- Works -->
				<div class="footer-col footer-accordion">
					<button type="button" class="footer-accordion-btn" aria-expanded="false">
						<h4 class="footer-heading">Works &amp; laboratory</h4>
						<span class="acc-toggle-icon" aria-hidden="true">
							<span class="acc-icon-h"></span>
							<span class="acc-icon-v"></span>
						</span>
					</button>
					<div class="footer-accordion-content">
						<div class="footer-contact-card">
							<p class="contact-location">
								<strong>Works &amp; Labs:</strong><br />
								Vapi Timber Compound, Opp. Chandralok Tower, Nr. D Mart, Chanod, Vapi – 396 195 (Gujarat)
							</p>
							<div class="contact-quick-links">
								<a href={`tel:${COMPANY_PHONE.replace(/\s+/g, '')}`} class="contact-mini-row">
									<span set:html={icons.phoneSmall} />
									<span>Hotline: {COMPANY_PHONE}</span>
								</a>
								<a href="mailto:aquashakti99@gmail.com" class="contact-mini-row">
									<span set:html={icons.mail} />
									<span>aquashakti99@gmail.com</span>
								</a>
								<span class="contact-timings-badge">
									<span set:html={icons.clock} />
									<span>Mon – Sat: 9:00 AM – 7:30 PM</span>
								</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- ============================================================
			     3. BOTTOM BAR
			     ============================================================ -->
			<div class="footer-bottom-strip">
				<div class="bottom-left-meta">
					<p class="copyright-text">
						&copy; {today.getFullYear()} <strong>{COMPANY_NAME}</strong>. All rights reserved.
					</p>
					<span class="crafted-text">
						Engineered with <span class="heart-pulse" set:html={icons.heart} /> in Vapi, Gujarat (India).
					</span>
				</div>

				<div class="bottom-right-meta">
					<div class="legal-mini-links">
						<a href="/products">Products</a>
						<span class="dot-sep" aria-hidden="true"></span>
						<a href="/blog">Blog</a>
						<span class="dot-sep" aria-hidden="true"></span>
						<a href="/contact">Contact</a>
					</div>

					<button type="button" class="back-to-top-btn" id="footer-back-to-top" aria-label="Scroll to top">
						<span>Back to top</span>
						<span set:html={icons.arrowUp} />
					</button>
				</div>
			</div>
		</div>
	</div>
</footer>

<style>
	/* ==========================================================
	   WRAPPER
	   ========================================================== */
	.site-footer-wrapper {
		background: var(--surface-alt);
		border-top: 1px solid var(--line-200);
		position: relative;
		overflow: hidden;
		margin-top: 5rem;
	}

	:global(html.dark) .site-footer-wrapper {
		background: var(--surface-dark);
		border-top-color: rgba(255, 255, 255, 0.08);
	}

	/* ==========================================================
	   PRE-FOOTER CTA
	   ========================================================== */
	.pre-footer-cta-container {
		max-width: 1280px;
		margin: -3rem auto 3.5rem;
		padding: 0 1.5rem;
		position: relative;
		z-index: 10;
	}

	.pre-footer-card {
		background: var(--surface);
		border: 1px solid var(--line-200);
		border-radius: var(--radius-lg);
		padding: 3.5rem 2.5rem;
		box-shadow: var(--shadow-md);
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	:global(html.dark) .pre-footer-card {
		background: var(--surface-dark-2);
		border-color: rgba(255, 255, 255, 0.10);
	}

	.pre-footer-ambient-mesh {
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.10) 0%, transparent 60%);
		pointer-events: none;
	}

	.pre-footer-content {
		position: relative;
		z-index: 1;
		max-width: 720px;
		margin: 0 auto;
	}

	.pre-footer-tag {
		display: inline-block;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.10em;
		text-transform: uppercase;
		color: var(--brand-500);
		background: var(--brand-50);
		padding: 0.28rem 0.85rem;
		border-radius: var(--radius-pill);
		margin-bottom: 1.1rem;
	}

	:global(html.dark) .pre-footer-tag {
		color: var(--brand-400);
		background: rgba(2, 132, 199, 0.15);
	}

	.pre-footer-heading {
		font-size: clamp(1.75rem, 3.2vw, 2.5rem);
		font-weight: 800;
		color: var(--ink-900);
		letter-spacing: -0.025em;
		line-height: 1.18;
		margin: 0 0 0.9rem 0;
	}

	:global(html.dark) .pre-footer-heading { color: #ffffff; }

	.pre-footer-sub {
		font-size: 1rem;
		line-height: 1.6;
		color: var(--ink-500);
		margin: 0 0 1.75rem 0;
	}

	:global(html.dark) .pre-footer-sub { color: var(--ink-300); }

	.pre-footer-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 1.75rem;
	}

	.btn-gradient-prefooter {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.8rem 1.75rem;
		font-size: 0.92rem;
		font-weight: 600;
		border-radius: var(--radius-pill);
		background: var(--brand-500);
		color: #ffffff;
		border: none;
		cursor: pointer;
		position: relative;
		overflow: hidden;
		transition: background 0.2s var(--ease), transform 0.2s var(--ease);
	}

	.btn-gradient-prefooter:hover {
		background: #0369a1;
		transform: translateY(-1px);
	}

	.cta-shine-layer { display: none; }

	.btn-secondary-prefooter {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.8rem 1.5rem;
		font-size: 0.92rem;
		font-weight: 600;
		border-radius: var(--radius-pill);
		background: transparent;
		border: 1.5px solid var(--line-300);
		color: var(--ink-700);
		text-decoration: none;
		transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
	}

	.btn-secondary-prefooter:hover {
		border-color: var(--brand-500);
		color: var(--brand-500);
	}

	:global(html.dark) .btn-secondary-prefooter {
		color: var(--line-200);
		border-color: rgba(255, 255, 255, 0.18);
	}

	:global(html.dark) .btn-secondary-prefooter:hover {
		border-color: var(--brand-400);
		color: var(--brand-400);
	}

	/* Perks list */
	.pre-footer-perks {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		flex-wrap: wrap;
	}

	.pre-footer-perks li {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.82rem;
		color: var(--ink-400);
	}

	:global(html.dark) .pre-footer-perks li { color: var(--ink-300); }

	.pre-footer-perks li > :first-child {
		color: var(--green-600);
		display: inline-flex;
	}

	/* ==========================================================
	   MAIN FOOTER
	   ========================================================== */
	.site-footer-main {
		padding: 3rem 1.5rem 2rem;
	}

	.site-footer-container {
		max-width: 1280px;
		margin: 0 auto;
	}

	.footer-primary-grid {
		display: grid;
		grid-template-columns: 1.8fr 1fr 1fr 1fr 1fr 1.2fr;
		gap: 2rem;
		margin-bottom: 2.5rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--line-200);
	}

	:global(html.dark) .footer-primary-grid {
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	.brand-col { padding-right: 1.25rem; }

	.footer-brand-link {
		display: inline-flex;
		margin-bottom: 1rem;
	}

	.brand-bio {
		font-size: 0.88rem;
		line-height: 1.6;
		color: var(--ink-500);
		margin-bottom: 1.25rem;
	}

	:global(html.dark) .brand-bio { color: var(--ink-300); }
	.brand-bio strong { color: var(--ink-900); }
	:global(html.dark) .brand-bio strong { color: #ffffff; }

	.status-indicator-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.35rem 0.75rem;
		border-radius: var(--radius-pill);
		background: rgba(16, 185, 129, 0.08);
		border: 1px solid rgba(16, 185, 129, 0.20);
		font-size: 0.72rem;
		color: var(--green-700);
		margin-bottom: 1.25rem;
	}

	:global(html.dark) .status-indicator-pill {
		background: rgba(16, 185, 129, 0.12);
		color: #6ee7b7;
		border-color: rgba(16, 185, 129, 0.28);
	}

	.status-pulse-dot {
		width: 7px;
		height: 7px;
		background: var(--green-600);
		border-radius: 50%;
		box-shadow: 0 0 8px var(--green-600);
		animation: pulseDot 2s infinite ease-in-out;
	}

	@keyframes pulseDot {
		0%, 100% { transform: scale(1); opacity: 1; }
		50% { transform: scale(1.2); opacity: 0.7; }
	}

	.status-label { font-weight: 600; }
	.status-latency { color: var(--ink-400); }
	:global(html.dark) .status-latency { color: var(--ink-300); }

	.compliance-badges-row {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	.comp-badge {
		font-size: 0.66rem;
		font-weight: 700;
		padding: 0.2rem 0.55rem;
		border-radius: 6px;
		background: var(--surface);
		border: 1px solid var(--line-200);
		color: var(--ink-500);
	}

	:global(html.dark) .comp-badge {
		background: rgba(255, 255, 255, 0.05);
		border-color: rgba(255, 255, 255, 0.10);
		color: var(--line-300);
	}

	.footer-heading {
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-900);
		margin: 0 0 1rem 0;
	}

	:global(html.dark) .footer-heading { color: #ffffff; }

	.footer-links-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.footer-links-list a {
		font-size: 0.86rem;
		color: var(--ink-500);
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		transition: color 0.2s var(--ease), transform 0.2s var(--ease);
	}

	:global(html.dark) .footer-links-list a { color: var(--ink-300); }

	.footer-links-list a:hover {
		color: var(--brand-500);
		transform: translateX(2px);
	}
	:global(html.dark) .footer-links-list a:hover { color: var(--brand-400); }

	.badge-sub-pill {
		font-size: 0.6rem;
		font-weight: 700;
		padding: 0.08rem 0.4rem;
		border-radius: var(--radius-pill);
		background: var(--brand-50);
		color: var(--brand-500);
	}

	/* Accordion (desktop = fully open, button passive) */
	.footer-accordion-btn {
		width: auto;
		display: block;
		padding: 0;
		background: transparent;
		border: none;
		cursor: default;
		pointer-events: none;
		text-align: left;
	}

	.acc-toggle-icon { display: none; }

	.footer-accordion-content { display: block; }

	/* Works & labs card */
	.footer-contact-card {
		font-size: 0.86rem;
		color: var(--ink-500);
		line-height: 1.5;
	}

