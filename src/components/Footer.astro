---
import Logo from './Logo.astro';
import { COMPANY_NAME, COMPANY_PHONE, COMPANY_EMAIL, COMPANY_LOCATION, COMPANY_ESTD } from '../consts';

const today = new Date();
---

<footer class="site-footer">
	<!-- Top CTA Banner -->
	<div class="footer-cta">
		<div class="container footer-cta-content">
			<div class="footer-cta-text">
				<span class="badge badge-teal">Turnkey Water Treatment Engineering</span>
				<h2>Looking for an Industrial RO, ETP, or DM Plant?</h2>
				<p>Get technical sizing, P&ID diagram consultation, and factory-direct pricing for your project in Gujarat and across India.</p>
			</div>
			<div class="footer-cta-actions">
				<button type="button" class="btn btn-primary btn-lg" data-quote-trigger data-plant="Complete Project Consultation">
					Request Free Consultation &rarr;
				</button>
				<a href="tel:+919825176420" class="btn btn-white-outline btn-lg">
					Call Direct: {COMPANY_PHONE}
				</a>
			</div>
		</div>
	</div>

	<!-- Main Footer Columns -->
	<div class="footer-main">
		<div class="container">
			<div class="footer-grid">
				<!-- Brand Column -->
				<div class="footer-col brand-col">
					<Logo light={true} size="md" showTagline={true} />
					<p class="brand-desc">
						Established in {COMPANY_ESTD} in Vapi, Valsad (Gujarat), <strong>Aqua Shakti Industries</strong> is an ISO 9001:2008 certified leading manufacturer, supplier, and turnkey service provider of water treatment plants, industrial reverse osmosis, and wastewater management systems.
					</p>
					<div class="cert-badges">
						<span class="cert-pill">ISO 9001:2008</span>
						<span class="cert-pill">WAPTAG Member</span>
						<span class="cert-pill">Make in India</span>
					</div>
				</div>

				<!-- Products Column -->
				<div class="footer-col">
					<h4 class="footer-heading">Water & Waste Plants</h4>
					<ul class="footer-links">
						<li><a href="/products#industrial-ro">Industrial RO & Sea Water Plants</a></li>
						<li><a href="/products#commercial-ro">Commercial RO Plants (25 - 1000 LPH)</a></li>
						<li><a href="/products#softeners">Water Softener Plants</a></li>
						<li><a href="/products#dm-plants">Demineralization (DM) & Mix Bed</a></li>
						<li><a href="/products#etp-plants">Effluent Treatment Plants (ETP)</a></li>
						<li><a href="/products#stp-plants">Sewage Treatment Plants (STP)</a></li>
						<li><a href="/products#ozonation">Ozonation & Mineral Packaging</a></li>
						<li><a href="/products#chilling">Online Chilling & Water Coolers</a></li>
					</ul>
				</div>

				<!-- Components & Usage -->
				<div class="footer-col">
					<h4 class="footer-heading">Components & Media</h4>
					<ul class="footer-links">
						<li><a href="/products#components">Pressure Gauges & Rota Meters</a></li>
						<li><a href="/products#components">SS & FRP Membrane Housings</a></li>
						<li><a href="/products#components">Imported RO Membranes (Dow/Toray)</a></li>
						<li><a href="/products#components">Vertical Multi-Stage Pumps</a></li>
						<li><a href="/products#components">Dosing Pumps & Level Sensors</a></li>
						<li><a href="/products#chemicals">Antiscalant & RO Chemicals</a></li>
						<li><a href="/products#chemicals">Activated Carbon & Resins</a></li>
						<li><a href="/products#components">Multi-Port Automatic Valves</a></li>
					</ul>
				</div>

				<!-- Contact & Location -->
				<div class="footer-col">
					<h4 class="footer-heading">Get in Touch</h4>
					<ul class="contact-list">
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
							<span><strong>Works & Office:</strong><br />Vapi, District Valsad, Gujarat - 396195, India</span>
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
							<span><a href="tel:+919825176420">{COMPANY_PHONE}</a></span>
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
							<span><a href={`mailto:${COMPANY_EMAIL}`}>{COMPANY_EMAIL}</a></span>
						</li>
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
							<span><a href="/blog"><strong>Markdown Technical Blog &rarr;</strong></a></span>
						</li>
					</ul>
				</div>
			</div>

			<!-- Bottom Copyright -->
			<div class="footer-bottom">
				<p class="copyright">
					&copy; {today.getFullYear()} <strong>{COMPANY_NAME}</strong>. All rights reserved. Ideal Solution for all types of Water.
				</p>
				<div class="footer-tech-tag">
					<span>Static Astro SSG</span>
					<span>•</span>
					<span>Markdown-Driven Blog (No CMS needed)</span>
					<span>•</span>
					<a href="/rss.xml">RSS Feed</a>
				</div>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: #0a1128;
		color: #e2e8f0;
		margin-top: auto;
	}

	.footer-cta {
		background: linear-gradient(135deg, #075985 0%, #0369a1 50%, #0284c7 100%);
		padding: 4rem 0;
		color: #ffffff;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.footer-cta-content {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2.5rem;
		flex-wrap: wrap;
	}

	.footer-cta-text {
		max-width: 650px;
	}

	.footer-cta-text h2 {
		color: #ffffff;
		margin-top: 0.75rem;
		font-size: clamp(1.6rem, 2.8vw, 2.2rem);
	}

	.footer-cta-text p {
		color: #e0f2fe;
		font-size: 1.05rem;
		margin-bottom: 0;
	}

	.footer-cta-actions {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-width: 260px;
	}

	.footer-main {
		padding: 4.5rem 0 2rem 0;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr 1fr 1.25fr;
		gap: 2.5rem;
		margin-bottom: 3.5rem;
	}

	.brand-desc {
		color: #94a3b8;
		font-size: 0.9rem;
		line-height: 1.6;
		margin: 1.25rem 0;
	}

	.cert-badges {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.cert-pill {
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: #38bdf8;
		font-size: 0.72rem;
		font-weight: 700;
		padding: 0.25rem 0.65rem;
		border-radius: var(--radius-full);
	}

	.footer-heading {
		color: #ffffff;
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		margin-bottom: 1.25rem;
		position: relative;
		padding-bottom: 0.5rem;
	}

	.footer-heading::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 30px;
		height: 2px;
		background: var(--primary);
		border-radius: 2px;
	}

	.footer-links {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.footer-links a {
		color: #94a3b8;
		font-size: 0.9rem;
		transition: all 0.2s ease;
		display: inline-block;
	}

	.footer-links a:hover {
		color: #38bdf8;
		transform: translateX(4px);
	}

	.contact-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-size: 0.9rem;
		color: #94a3b8;
	}

	.contact-list li {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
	}

	.contact-list svg {
		color: #38bdf8;
		flex-shrink: 0;
		margin-top: 3px;
	}

	.contact-list a {
		color: #e2e8f0;
	}

	.contact-list a:hover {
		color: #38bdf8;
	}

	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		padding-top: 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.82rem;
		color: #64748b;
	}

	.copyright {
		margin: 0;
		color: #94a3b8;
	}

	.footer-tech-tag {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: #64748b;
	}

	.footer-tech-tag a {
		color: #94a3b8;
	}

	@media (max-width: 992px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 600px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
		.footer-bottom {
			flex-direction: column;
			text-align: center;
		}
	}
</style>
