<script is:inline>
	function initFooter() {
		// Back to top
		const bttBtn = document.getElementById('footer-back-to-top');
		bttBtn?.addEventListener('click', () => {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});

		// Mobile accordion
		document.querySelectorAll('.footer-accordion-btn').forEach((btn) => {
			btn.addEventListener('click', (e) => {
				if (window.innerWidth > 768) return;
				e.preventDefault();
				const accordion = btn.closest('.footer-accordion');
				const isOpen = accordion?.classList.contains('is-open');

				if (isOpen) {
					accordion?.classList.remove('is-open');
					btn.setAttribute('aria-expanded', 'false');
				} else {
					accordion?.classList.add('is-open');
					btn.setAttribute('aria-expanded', 'true');
				}
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initFooter);
	} else {
		initFooter();
	}
	document.addEventListener('astro:page-load', initFooter);
</script>
