---
import { REPUTED_CLIENTS } from '../consts';
---

<section class="clients-section">
	<div class="container text-center">
		<span class="badge badge-blue">Trusted Across Industries</span>
		<h3 class="clients-heading">Our Reputed Clients & Corporate Partners</h3>
		<p class="clients-sub">Aqua Shakti plants operate reliably across India's premier industrial and hospitality groups.</p>
		
		<div class="clients-ticker">
			<div class="clients-grid">
				{REPUTED_CLIENTS.map((client) => (
					<div class="client-badge-card">
						<div class="client-symbol">🏢</div>
						<div class="client-info">
							<strong class="client-name">{client.name}</strong>
							<span class="client-sub">{client.desc}</span>
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.clients-section {
		padding: 4rem 0 3.5rem 0;
		background: #ffffff;
		border-top: 1px solid var(--border-color);
		border-bottom: 1px solid var(--border-color);
	}

	.text-center {
		text-align: center;
	}

	.clients-heading {
		font-size: clamp(1.4rem, 2.5vw, 1.9rem);
		margin-top: 0.75rem;
		margin-bottom: 0.5rem;
	}

	.clients-sub {
		color: var(--text-muted);
		max-width: 650px;
		margin: 0 auto 2.5rem auto;
		font-size: 0.95rem;
	}

	.clients-grid {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 1.25rem;
	}

	.client-badge-card {
		background: #f8fafc;
		border: 1px solid var(--border-color);
		border-radius: var(--radius-md);
		padding: 1.1rem 0.75rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		transition: var(--transition);
	}

	.client-badge-card:hover {
		background: #ffffff;
		border-color: var(--primary);
		box-shadow: var(--shadow-md);
		transform: translateY(-3px);
	}

	.client-symbol {
		font-size: 1.4rem;
		margin-bottom: 0.4rem;
	}

	.client-name {
		font-size: 0.88rem;
		color: var(--navy-900);
		line-height: 1.2;
		display: block;
	}

	.client-sub {
		font-size: 0.72rem;
		color: var(--text-muted);
		margin-top: 2px;
		display: block;
	}

	@media (max-width: 1024px) {
		.clients-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	@media (max-width: 768px) {
		.clients-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 480px) {
		.clients-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
