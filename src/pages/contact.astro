		<!-- ==========================================================
		     JAVASCRIPT — UNCHANGED (all logic preserved)
		     ========================================================== -->
		<script is:inline>
			function submitContactRFQ() {
				const name = document.getElementById('cf-name').value;
				const company = document.getElementById('cf-company').value;
				const phone = document.getElementById('cf-phone').value;
				const email = document.getElementById('cf-email').value;
				const plant = document.getElementById('cf-plant').value;
				const capacity = document.getElementById('cf-capacity').value;
				const source = document.getElementById('cf-source').value;
				const location = document.getElementById('cf-location').value;
				const tds = document.getElementById('cf-tds').value;
				const notes = document.getElementById('cf-notes').value;

				const text = encodeURIComponent(
					`*Aqua Shakti Water Treatment Enquiry*\n` +
					`*Client Name:* ${name}\n` +
					(company ? `*Company:* ${company}\n` : '') +
					`*Phone:* ${phone}\n` +
					(email ? `*Email:* ${email}\n` : '') +
					`*Plant Requirement:* ${plant}\n` +
					`*Capacity:* ${capacity}\n` +
					`*Water Source:* ${source}\n` +
					`*Location:* ${location}\n` +
					(tds ? `*Raw Water TDS/Params:* ${tds}\n` : '') +
					(notes ? `*Notes:* ${notes}\n` : '')
				);

				const waUrl = `https://wa.me/919913936995?text=${text}`;

				document.getElementById('full-contact-form').style.display = 'none';
				const success = document.getElementById('contact-success');
				success.style.display = 'block';
				document.getElementById('contact-wa-link').href = waUrl;

				window.open(waUrl, '_blank');
			}

			(function () {
				function initContactInteractions() {
					const plantChips = document.querySelectorAll('.plant-chip');
					const plantSelect = document.getElementById('cf-plant');
					plantChips.forEach((chip) => {
						chip.addEventListener('click', () => {
							plantChips.forEach((c) => c.classList.remove('active'));
							chip.classList.add('active');
							const val = chip.getAttribute('data-val');
							if (plantSelect && val) {
								plantSelect.value = val;
							}
						});
					});

					const capChips = document.querySelectorAll('.cap-chip');
					const capInput = document.getElementById('cf-capacity');
					capChips.forEach((chip) => {
						chip.addEventListener('click', () => {
							const val = chip.getAttribute('data-val');
							if (capInput && val) {
								capInput.value = val;
								capInput.focus();
							}
						});
					});

					const copyBtns = document.querySelectorAll('.btn-copy-chip');
					copyBtns.forEach((btn) => {
						btn.addEventListener('click', async () => {
							const text = btn.getAttribute('data-copy');
							if (!text) return;
							try {
								await navigator.clipboard.writeText(text);
								const orig = btn.innerHTML;
								btn.innerHTML = '<span>✓ Copied</span>';
								setTimeout(() => {
									btn.innerHTML = orig;
								}, 1800);
							} catch (_) {}
						});
					});

					const faqBtns = document.querySelectorAll('.faq-question-btn');
					faqBtns.forEach((btn) => {
						btn.addEventListener('click', () => {
							const targetId = btn.getAttribute('data-faq-target');
							const panel = document.getElementById(targetId);
							const isExpanded = btn.getAttribute('aria-expanded') === 'true';
							const icon = btn.querySelector('.faq-toggle-icon');

							if (isExpanded) {
								btn.setAttribute('aria-expanded', 'false');
								if (panel) panel.hidden = true;
								if (icon) icon.textContent = '+';
							} else {
								btn.setAttribute('aria-expanded', 'true');
								if (panel) panel.hidden = false;
								if (icon) icon.innerHTML = '&minus;';
							}
						});
					});
				}

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initContactInteractions);
				} else {
					initContactInteractions();
				}
				document.addEventListener('astro:page-load', initContactInteractions);
			})();
		</script>
