---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import QuoteModal from '../components/QuoteModal.astro';
import { COMPANY_NAME, COMPANY_PHONE, COMPANY_EMAIL, COMPANY_LOCATION } from '../consts';

/* Inline SVG icons — no emojis */
const icons = {
	pin: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`,
	phone: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
	mail: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
	clock: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
	copy: `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`,
	check: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`,
	checkBig: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`,
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Contact Us | ${COMPANY_NAME}`}
			description="Get in touch with Aqua Shakti Industries in Vapi, Gujarat for plant sizing, quotation, raw water test analysis, or after-sales service."
			image="/images/hero-plant.jpg"
		/>
	</head>
	<body>
		<Header />

		<main class="contact-page">
			<!-- ======================================================
			     HERO
			     ====================================================== -->
			<section class="contact-hero">
				<div class="container text-center">
					<span class="eyebrow-pill">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
						<span>Direct engineering</span>
					</span>
					<h1 class="contact-main-title">Contact Aqua Shakti</h1>
					<p class="section-subtitle">
						Consult with our specialists for RO, ETP, STP, softener or chemical pricing.
					</p>
				</div>
			</section>

			<!-- ======================================================
			     MAIN GRID
			     ====================================================== -->
			<section class="section">
				<div class="container">
					<div class="grid-2 contact-grid">
						<!-- ================= FORM ================= -->
						<div class="card rfq-card">
							<span class="eyebrow">Plant sizing request</span>
							<h3 class="rfq-title">Request sizing &amp; quotation</h3>
							<p class="rfq-lead">
								Fill in your project details. Our Vapi team prepares an official proposal and P&amp;ID sizing within 24 hours.
							</p>

							<form id="full-contact-form" onsubmit="event.preventDefault(); submitContactRFQ();">
								<div class="form-row">
									<div class="form-group">
										<label class="form-label" for="cf-name">Full name / Contact *</label>
										<input type="text" id="cf-name" class="form-control" placeholder="Your name" required />
									</div>
									<div class="form-group">
										<label class="form-label" for="cf-company">Company / Factory</label>
										<input type="text" id="cf-company" class="form-control" placeholder="Company name (if any)" />
									</div>
								</div>

								<div class="form-row">
									<div class="form-group">
										<label class="form-label" for="cf-phone">Phone / WhatsApp *</label>
										<input type="tel" id="cf-phone" class="form-control" placeholder="+91 98XXX XXXXX" required />
									</div>
									<div class="form-group">
										<label class="form-label" for="cf-email">Email</label>
										<input type="email" id="cf-email" class="form-control" placeholder="your@email.com" />
									</div>
								</div>

								<div class="form-group">
									<label class="form-label">Plant requirement *</label>
									<div class="plant-chip-selector" id="plant-chip-group">
										<button type="button" class="plant-chip active" data-val="Industrial RO Plant">Industrial RO</button>
										<button type="button" class="plant-chip" data-val="Commercial RO Plant">Commercial RO</button>
										<button type="button" class="plant-chip" data-val="Effluent Treatment Plant (ETP)">ETP</button>
										<button type="button" class="plant-chip" data-val="Sewage Treatment Plant (STP)">STP</button>
										<button type="button" class="plant-chip" data-val="Water Softener Plant">Softener</button>
										<button type="button" class="plant-chip" data-val="DM / Mix Bed Plant">DM Plant</button>
										<button type="button" class="plant-chip" data-val="Components & Water Chemicals">Chemicals &amp; Spares</button>
									</div>
									<select id="cf-plant" class="form-control" required>
										<option value="Industrial RO Plant" selected>Industrial RO Plant (500 – 50,000+ LPH)</option>
										<option value="Commercial RO Plant">Commercial RO Plant (25 – 1,000 LPH)</option>
										<option value="Effluent Treatment Plant (ETP)">Effluent Treatment Plant (ETP)</option>
										<option value="Sewage Treatment Plant (STP)">Sewage Treatment Plant (STP)</option>
										<option value="Water Softener Plant">Industrial Water Softener Plant</option>
										<option value="DM / Mix Bed Plant">Demineralization (DM) / Mix Bed Plant</option>
										<option value="Ozonation & Mineral Packaging">Ozonation &amp; Packaged Water Plant</option>
										<option value="Components & Water Chemicals">Membranes, Resins, Antiscalants &amp; Spares</option>
									</select>
								</div>

								<div class="form-group">
									<div class="capacity-label-row">
										<label class="form-label" for="cf-capacity">Required capacity *</label>
										<div class="capacity-chips-row" id="capacity-chips">
											<button type="button" class="cap-chip" data-val="500 LPH">500 LPH</button>
											<button type="button" class="cap-chip" data-val="1,000 LPH">1,000 LPH</button>
											<button type="button" class="cap-chip" data-val="5,000 LPH">5,000 LPH</button>
											<button type="button" class="cap-chip" data-val="10,000 LPH">10k LPH</button>
											<button type="button" class="cap-chip" data-val="25 KLD">25 KLD</button>
											<button type="button" class="cap-chip" data-val="50 KLD">50 KLD</button>
										</div>
									</div>
									<input type="text" id="cf-capacity" class="form-control" placeholder="e.g. 5,000 LPH / 50 KLD" required value="5,000 LPH" />
								</div>

								<div class="form-row">
									<div class="form-group">
										<label class="form-label" for="cf-source">Raw water source</label>
										<select id="cf-source" class="form-control">
											<option value="Borewell / Ground Water">Borewell / Ground water</option>
											<option value="Industrial Effluent (Chemical/Pharma/Textile)">Industrial effluent</option>
											<option value="Domestic Sewage">Domestic sewage</option>
											<option value="River / Canal">River / Surface canal</option>
											<option value="Municipal Water">Municipal water</option>
											<option value="Sea / Brackish Water">Sea / Brackish water</option>
										</select>
									</div>
									<div class="form-group">
										<label class="form-label" for="cf-location">Installation location *</label>
										<input type="text" id="cf-location" class="form-control" placeholder="City / District" required />
									</div>
								</div>

								<div class="form-group">
									<label class="form-label" for="cf-tds">Raw water TDS / Hardness / BOD</label>
									<input type="text" id="cf-tds" class="form-control" placeholder="e.g. TDS 1800 ppm, Hardness 600 ppm" />
								</div>

								<div class="form-group">
									<label class="form-label" for="cf-notes">Project notes</label>
									<textarea id="cf-notes" class="form-control" rows="3" placeholder="Skid material, delivery timeline, site space..."></textarea>
								</div>

								<button type="submit" class="btn btn-primary btn-lg btn-block">
									Submit &amp; open WhatsApp &rarr;
								</button>
							</form>

							<div id="contact-success" class="contact-success" style="display: none;">
								<div class="success-badge"><span set:html={icons.checkBig} /></div>
								<h3>Enquiry prepared!</h3>
								<p>Connecting you directly to our technical head via WhatsApp.</p>
								<a id="contact-wa-link" href="#" target="_blank" class="btn btn-primary btn-lg">
									Open WhatsApp &rarr;
								</a>
							</div>
						</div>

						<!-- ================= INFO ================= -->
						<div class="contact-info-col">
							<div class="card info-card">
								<span class="eyebrow">Works &amp; HQ</span>
								<h3 class="info-heading">Visit or ship a water sample</h3>

								<div class="info-items-list">
									<div class="info-item">
										<div class="info-icon"><span set:html={icons.pin} /></div>
										<div>
											<strong>Works &amp; head office</strong>
											<p>Aqua Shakti Industries<br />Vapi Timber Compound, Opp. Chandralok Tower, Nr. D Mart, Chanod, VAPI – 396 195 (Gujarat)</p>
										</div>
									</div>

									<div class="info-item">
										<div class="info-icon"><span set:html={icons.phone} /></div>
										<div>
											<div class="info-title-row">
												<strong>Mobile / direct sales</strong>
												<button type="button" class="btn-copy-chip" data-copy="+919913936995" title="Copy primary phone">
													<span set:html={icons.copy} />
													<span>Copy</span>
												</button>
											</div>
											<p>
												<a href="tel:+919913936995">+91 99139 36995</a> / <a href="tel:+919377555014">+91 93775 55014</a>
											</p>
											<p class="helpline">
												<strong>Helpline:</strong> <a href="tel:6356008944">6356008944</a>
											</p>
										</div>
									</div>

									<div class="info-item">
										<div class="info-icon"><span set:html={icons.mail} /></div>
										<div>
											<div class="info-title-row">
												<strong>Official email</strong>
												<button type="button" class="btn-copy-chip" data-copy="aquashakti99@gmail.com" title="Copy email">
													<span set:html={icons.copy} />
													<span>Copy</span>
												</button>
											</div>
											<p><a href="mailto:aquashakti99@gmail.com">aquashakti99@gmail.com</a></p>
										</div>
									</div>

									<div class="info-item">
										<div class="info-icon"><span set:html={icons.clock} /></div>
										<div>
											<strong>Operating hours</strong>
											<p>Mon – Sat: 9:00 AM – 7:30 PM<br />Emergency breakdown &amp; AMC: 24/7</p>
										</div>
									</div>
								</div>

								<div class="vapi-card">
									<h4>Why Vapi?</h4>
									<p>
										Located in South Gujarat's primary chemical corridor — rapid spares dispatch across Vapi, Daman, Silvassa, Sarigam, Umbergaon, Valsad, Navsari, Surat, Ankleshwar and Bharuch.
									</p>
								</div>
							</div>

							<div class="card card-dark blog-callout">
								<span class="eyebrow eyebrow-light">Knowledge</span>
								<h4>Need help with technical sizing?</h4>
								<p>Explore engineering guides written by our process chemists and design engineers.</p>
								<a href="/blog" class="btn btn-white-outline btn-sm">Visit blog &rarr;</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ======================================================
			     FAQ
			     ====================================================== -->
			<section class="section section-alt">
				<div class="container container-narrow">
					<div class="section-title-wrap-centered">
						<span class="eyebrow">Common inquiries</span>
						<h2 class="section-title">Frequently asked questions</h2>
						<p class="section-subtitle">
							Quick answers on plant selection, warranties and maintenance.
						</p>
					</div>

					<div class="faq-accordion" id="faq-closure-group">
						<div class="card faq-card">
							<button type="button" class="faq-question-btn" aria-expanded="true" data-faq-target="faq-ans-1">
								<span class="faq-question-text">1. Do I need a water softener or an RO plant?</span>
								<span class="faq-toggle-icon">&minus;</span>
							</button>
							<div class="faq-answer-panel" id="faq-ans-1">
								<p>
									A <strong>softener</strong> removes only hardness (calcium &amp; magnesium), replacing them with sodium — no change in TDS. An <strong>RO plant</strong> removes up to 99% of all dissolved solids, heavy metals, chlorides and bacteria. If TDS &gt; 500 ppm, choose RO.
								</p>
							</div>
						</div>

						<div class="card faq-card">
							<button type="button" class="faq-question-btn" aria-expanded="false" data-faq-target="faq-ans-2">
								<span class="faq-question-text">2. What raw-water test parameters should I provide?</span>
								<span class="faq-toggle-icon">+</span>
							</button>
							<div class="faq-answer-panel" id="faq-ans-2" hidden>
								<p>
									TDS, pH, total hardness, chlorides, sulphates, silica, iron and turbidity. For ETP/STP include BOD, COD and TSS. If you don't have a report, courier a 2-litre sample to our Vapi lab for a complimentary analysis.
								</p>
							</div>
						</div>

						<div class="card faq-card">
							<button type="button" class="faq-question-btn" aria-expanded="false" data-faq-target="faq-ans-3">
								<span class="faq-question-text">3. What warranty and after-sales policy do you offer?</span>
								<span class="faq-toggle-icon">+</span>
							</button>
							<div class="faq-answer-panel" id="faq-ans-3" hidden>
								<p>
									Every plant carries a <strong>1-year performance warranty</strong> on high-pressure pumps, control panels, pressure vessels and fabrication. We include on-site operator training, preventive maintenance schedules and optional AMC.
								</p>
							</div>
						</div>

						<div class="card faq-card">
							<button type="button" class="faq-question-btn" aria-expanded="false" data-faq-target="faq-ans-4">
								<span class="faq-question-text">4. How often do membranes and cartridges need replacing?</span>
								<span class="faq-toggle-icon">+</span>
							</button>
							<div class="faq-answer-panel" id="faq-ans-4" hidden>
								<p>
									Industrial TFC membranes last <strong>2–4 years</strong> with proper antiscalant dosing and auto-flush. Spun 5-micron pre-filter cartridges are typically replaced every 1–3 months depending on sediment load.
								</p>
							</div>
						</div>

						<div class="card faq-card">
							<button type="button" class="faq-question-btn" aria-expanded="false" data-faq-target="faq-ans-5">
								<span class="faq-question-text">5. What is the manufacturing and commissioning timeline?</span>
								<span class="faq-toggle-icon">+</span>
							</button>
							<div class="faq-answer-panel" id="faq-ans-5" hidden>
								<p>
									Commercial RO (25–1,000 LPH): <strong>3–5 working days</strong>. Industrial skids (5,000–50,000 LPH) and ETP/STP turnkey packages: <strong>2–4 weeks</strong>, including factory pressure testing, wiring and on-site commissioning.
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
		<QuoteModal />

		<style>
			/* ==========================================================
			   DESIGN TOKENS (shared with all pages)
			   ========================================================== */
			:root {
				--brand-50: #eff6ff;
				--brand-500: #0284c7;
				--brand-400: #38bdf8;
				--green-600: #16a34a;
				--green-700: #047857;
				--ink-900: #0f172a;
				--ink-700: #1e293b;
				--ink-500: #475569;
				--ink-400: #64748b;
				--ink-300: #94a3b8;
				--line-200: #e2e8f0;
				--line-300: #cbd5e1;
				--surface: #ffffff;
				--surface-alt: #f8fafc;
				--surface-dark: #0b1220;
				--surface-dark-2: #131c2e;
				--radius-md: 12px;
				--radius-lg: 16px;
				--radius-pill: 9999px;
				--shadow-xs: 0 1px 3px rgba(0,0,0,0.06);
				--shadow-md: 0 8px 24px -8px rgba(15,23,42,0.10);
				--ease: cubic-bezier(0.4, 0, 0.2, 1);
			}

			:global(html.dark) {
				--surface: #131c2e;
				--surface-alt: #0b1220;
				--ink-900: #f8fafc;
				--ink-700: #e2e8f0;
				--ink-500: #94a3b8;
				--ink-400: #94a3b8;
				--line-200: rgba(255,255,255,0.10);
				--line-300: rgba(255,255,255,0.15);
			}

			.contact-page { background-color: var(--surface); }
			:global(html.dark) .contact-page { background-color: var(--surface-dark); }

			.text-center { text-align: center; }

			/* ==========================================================
			   HERO
			   ========================================================== */
			.contact-hero {
				background: linear-gradient(180deg, #e0f2fe 0%, var(--surface) 100%);
				padding: 3rem 0 2rem;
			}
			:global(html.dark) .contact-hero {
				background: linear-gradient(180deg, #0e192f 0%, var(--surface-dark) 100%);
			}

			.eyebrow-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				background: var(--surface);
				border: 1px solid var(--line-300);
				color: var(--brand-500);
				padding: 0.28rem 0.8rem;
				border-radius: var(--radius-pill);
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				margin-bottom: 0.9rem;
			}
			:global(html.dark) .eyebrow-pill {
				background: var(--surface-dark-2);
				border-color: rgba(255,255,255,0.12);
				color: var(--brand-400);
			}

			.contact-main-title {
				font-size: clamp(1.9rem, 3.6vw, 2.75rem);
				font-weight: 800;
				color: var(--ink-900);
				letter-spacing: -0.025em;
				line-height: 1.18;
				margin-bottom: 0.7rem;
			}
			:global(html.dark) .contact-main-title { color: #ffffff; }

			/* ==========================================================
			   SHARED HEADINGS
			   ========================================================== */
			.eyebrow {
				display: inline-block;
				font-size: 0.75rem;
				font-weight: 700;
				color: var(--brand-500);
				text-transform: uppercase;
				letter-spacing: 0.14em;
				margin-bottom: 0.55rem;
			}
			.eyebrow-light { color: var(--brand-400); }

			.section-title {
				font-size: clamp(1.6rem, 2.6vw, 2.1rem);
				font-weight: 700;
				color: var(--ink-900);
				letter-spacing: -0.02em;
				line-height: 1.2;
				margin-bottom: 0.5rem;
			}
			:global(html.dark) .section-title { color: #ffffff; }

			.section-subtitle {
				font-size: 0.95rem;
				color: var(--ink-400);
				line-height: 1.55;
				max-width: 620px;
			}

			.section-title-wrap-centered {
				text-align: center;
				max-width: 720px;
				margin: 0 auto 2.5rem;
			}
			.section-title-wrap-centered .section-subtitle { margin: 0 auto; }

			/* ==========================================================
			   LAYOUT
			   ========================================================== */
			.contact-grid {
				gap: 3rem;
				align-items: flex-start;
			}

			.container-narrow {
				max-width: 860px !important;
				margin: 0 auto;
			}

			/* ==========================================================
			   FORM CARD
			   ========================================================== */
			.rfq-card {
				padding: 2rem;
				border-radius: var(--radius-lg);
			}
			:global(html.dark) .rfq-card {
				background: var(--surface-dark-2);
				border-color: rgba(255,255,255,0.08);
			}

			.rfq-title {
				font-size: 1.4rem;
				font-weight: 700;
				color: var(--ink-900);
				letter-spacing: -0.015em;
				line-height: 1.25;
				margin-bottom: 0.35rem;
			}
			:global(html.dark) .rfq-title { color: #ffffff; }

			.rfq-lead {
				font-size: 0.9rem;
				color: var(--ink-400);
				line-height: 1.55;
				margin-bottom: 1.5rem;
			}
			:global(html.dark) .rfq-lead { color: var(--ink-300); }

			.form-row {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
			}

			.form-group { margin-bottom: 1rem; }

			.form-label {
				display: block;
				font-size: 0.75rem;
				font-weight: 600;
				color: var(--ink-700);
				margin-bottom: 0.35rem;
				letter-spacing: 0.01em;
			}
			:global(html.dark) .form-label { color: var(--line-200); }

			.form-control {
				width: 100%;
				background: var(--surface);
				border: 1.5px solid var(--line-200);
