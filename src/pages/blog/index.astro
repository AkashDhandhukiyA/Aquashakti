---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import QuoteModal from '../../components/QuoteModal.astro';
import { COMPANY_NAME } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const otherPosts = posts.slice(1);

const categories = ['All', 'Industrial RO', 'Wastewater Treatment', 'Water Purification', 'Commercial RO', 'Engineering Guide'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Water Treatment & Engineering Blog | ${COMPANY_NAME}`}
			description="Technical guides, process diagrams, membrane technology, and wastewater treatment insights from Aqua Shakti Industries engineers in Vapi, Gujarat."
			image="/images/hero-plant.jpg"
		/>
	</head>
	<body>
		<Header />

		<main class="blog-index-page">
			<!-- Blog Hero -->
			<section class="blog-hero">
				<div class="container text-center">
					<span class="section-tag">Technical Knowledge Base</span>
					<h1>Water Engineering Insights</h1>
					<p class="section-subtitle">
						Practical guides, process chemistry, sizing formulas, and regulatory compliance tips for Industrial RO, Softeners, DM, ETP, and STP systems.
					</p>

					<!-- Markdown In-Code Notice -->
					<div class="code-notice-box">
						<div class="notice-icon">💡</div>
						<div class="notice-text">
							<strong>Static Markdown Blog:</strong> Add or edit articles simply by creating a <code>.md</code> file in <code>src/content/blog/</code>. No database, CMS, or admin login needed!
						</div>
					</div>
				</div>
			</section>

			<!-- Blog Content -->
			<section class="section" style="padding-top: 2rem;">
				<div class="container">
					{featuredPost && (
						<div class="featured-post-wrapper">
							<div class="featured-badge">Featured Article</div>
							<div class="featured-card">
								<a href={`/blog/${featuredPost.id}/`} class="featured-img-link">
									<img
										src={featuredPost.data.heroImage || '/images/hero-plant.jpg'}
										alt={featuredPost.data.title}
										class="featured-img"
									/>
								</a>
								<div class="featured-content">
									<div class="post-meta-top">
										<span class="badge badge-blue">{featuredPost.data.category || 'Water Treatment'}</span>
										<span class="reading-time">{featuredPost.data.readingTime || '5 min read'}</span>
									</div>
									<h2 class="featured-title">
										<a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a>
									</h2>
									<p class="featured-desc">{featuredPost.data.description}</p>
									<div class="featured-footer">
										<div class="post-author">
											<span>By {featuredPost.data.author || 'Aqua Shakti Team'}</span>
											<span>•</span>
											<FormattedDate date={featuredPost.data.pubDate} />
										</div>
										<a href={`/blog/${featuredPost.id}/`} class="btn btn-primary btn-sm">
											Read Complete Guide &rarr;
										</a>
									</div>
								</div>
							</div>
						</div>
					)}

					<!-- Grid of Other Posts -->
					<div class="posts-section-header">
						<h3>All Technical Articles ({posts.length})</h3>
					</div>

					<div class="grid-3 blog-grid">
						{otherPosts.map((post) => (
							<article class="card card-hover post-card">
								<a href={`/blog/${post.id}/`} class="post-thumbnail-link">
									<img
										src={post.data.heroImage || '/images/hero-plant.jpg'}
										alt={post.data.title}
										class="post-thumbnail"
									/>
									<span class="post-cat-badge">{post.data.category}</span>
								</a>

								<div class="post-card-body">
									<div class="post-card-meta">
										<span class="reading-time">{post.data.readingTime}</span>
										<span>•</span>
										<FormattedDate date={post.data.pubDate} />
									</div>

									<h4 class="post-card-title">
										<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									</h4>

									<p class="post-card-excerpt">
										{post.data.description}
									</p>

									<div class="post-card-footer">
										<div class="post-card-author">{post.data.author}</div>
										<a href={`/blog/${post.id}/`} class="read-more-link">
											Read &rarr;
										</a>
									</div>
								</div>
							</article>
						))}
					</div>
				</div>
			</section>
		</main>

		<Footer />
		<QuoteModal />

		<style>
			.blog-index-page {
				background-color: #f8fafc;
				padding-bottom: 4rem;
			}

			.blog-hero {
				background: linear-gradient(180deg, #e0f2fe 0%, #f8fafc 100%);
				padding: 4.5rem 0 2rem 0;
			}

			.text-center {
				text-align: center;
			}

			.code-notice-box {
				display: inline-flex;
				align-items: center;
				gap: 0.75rem;
				background: #ffffff;
				border: 1px dashed #38bdf8;
				padding: 0.75rem 1.5rem;
				border-radius: var(--radius-lg);
				margin-top: 1.5rem;
				font-size: 0.9rem;
				color: #334155;
				box-shadow: 0 2px 8px rgba(2, 132, 199, 0.08);
				text-align: left;
			}

			.code-notice-box code {
				background: #e0f2fe;
				color: #0369a1;
				padding: 0.15rem 0.4rem;
				border-radius: 4px;
				font-weight: 600;
			}

			.notice-icon {
				font-size: 1.25rem;
			}

			/* Featured Post */
			.featured-post-wrapper {
				position: relative;
				margin-bottom: 3.5rem;
			}

			.featured-badge {
				position: absolute;
				top: -12px;
				left: 2rem;
				background: #0284c7;
				color: #ffffff;
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				padding: 0.25rem 0.85rem;
				border-radius: var(--radius-full);
				z-index: 10;
				box-shadow: 0 4px 10px rgba(2, 132, 199, 0.3);
			}

			.featured-card {
				background: #ffffff;
				border: 1px solid var(--border-color);
				border-radius: var(--radius-lg);
				overflow: hidden;
				display: grid;
				grid-template-columns: 1.2fr 1fr;
				box-shadow: var(--shadow-md);
				transition: var(--transition);
			}

			.featured-card:hover {
				box-shadow: var(--shadow-xl);
				border-color: #cbd5e1;
			}

			.featured-img-link {
				display: block;
				overflow: hidden;
				height: 100%;
			}

			.featured-img {
				width: 100%;
				height: 100%;
				min-height: 340px;
				object-fit: cover;
				transition: transform 0.4s ease;
			}

			.featured-card:hover .featured-img {
				transform: scale(1.03);
			}

			.featured-content {
				padding: 2.5rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.post-meta-top {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 1rem;
			}

			.reading-time {
				font-size: 0.82rem;
				color: var(--text-muted);
				font-weight: 600;
			}

			.featured-title {
				font-size: clamp(1.5rem, 2.2vw, 1.9rem);
				margin-bottom: 1rem;
				line-height: 1.3;
			}

			.featured-title a {
				color: var(--navy-900);
			}

			.featured-title a:hover {
				color: var(--primary);
			}

			.featured-desc {
				color: #475569;
				font-size: 1.05rem;
				line-height: 1.6;
				margin-bottom: 1.75rem;
			}

			.featured-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 1rem;
				padding-top: 1.25rem;
				border-top: 1px solid var(--border-light);
			}

			.post-author {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.85rem;
				color: var(--text-muted);
			}

			/* Posts Section Header */
			.posts-section-header {
				margin-bottom: 1.75rem;
				border-bottom: 2px solid var(--border-color);
				padding-bottom: 0.75rem;
			}

			.posts-section-header h3 {
				margin: 0;
				color: var(--navy-900);
			}

			/* Card Grid */
			.blog-grid {
				align-items: stretch;
			}

			.post-card {
				padding: 0;
				display: flex;
				flex-direction: column;
				border-radius: var(--radius-lg);
			}

			.post-thumbnail-link {
				display: block;
				position: relative;
				overflow: hidden;
				aspect-ratio: 16 / 10;
			}

			.post-thumbnail {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.4s ease;
			}

			.post-card:hover .post-thumbnail {
				transform: scale(1.05);
			}

			.post-cat-badge {
				position: absolute;
				bottom: 0.75rem;
				left: 0.75rem;
				background: rgba(15, 23, 42, 0.8);
				backdrop-filter: blur(4px);
				color: #ffffff;
				font-size: 0.72rem;
				font-weight: 700;
				padding: 0.2rem 0.6rem;
				border-radius: var(--radius-sm);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}

			.post-card-body {
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				flex-grow: 1;
			}

			.post-card-meta {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				font-size: 0.8rem;
				color: var(--text-muted);
				margin-bottom: 0.75rem;
			}

			.post-card-title {
				font-size: 1.2rem;
				margin-bottom: 0.75rem;
				line-height: 1.35;
			}

			.post-card-title a {
				color: var(--navy-900);
			}

			.post-card-title a:hover {
				color: var(--primary);
			}

			.post-card-excerpt {
				color: var(--text-muted);
				font-size: 0.92rem;
				line-height: 1.55;
				margin-bottom: 1.5rem;
				flex-grow: 1;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.post-card-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding-top: 1rem;
				border-top: 1px solid var(--border-light);
			}

			.post-card-author {
				font-size: 0.8rem;
				color: #64748b;
				font-weight: 600;
			}

			.read-more-link {
				font-weight: 700;
				font-size: 0.85rem;
				color: var(--primary);
			}

			@media (max-width: 900px) {
				.featured-card {
					grid-template-columns: 1fr;
				}
				.featured-img {
					min-height: 240px;
					max-height: 280px;
				}
				.featured-content {
					padding: 1.75rem;
				}
			}
		</style>
	</body>
</html>
