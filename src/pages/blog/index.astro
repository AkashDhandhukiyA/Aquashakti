---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import QuoteModal from '../../components/QuoteModal.astro';
import { COMPANY_NAME } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const otherPosts = posts.slice(1);

const categories = ['All', 'Industrial RO', 'Wastewater Treatment', 'Water Purification', 'Commercial RO'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Water Treatment Blog & Engineering Guides | ${COMPANY_NAME}`}
			description="Technical guides, process diagrams, membrane technology, and wastewater treatment insights from Aqua Shakti Industries engineers in Vapi, Gujarat."
			image="/images/hero-plant.jpg"
		/>
	</head>
	<body>
		<Header />

		<main class="blog-index-page">
			<!-- Kokonut UI Hero -->
			<section class="blog-hero">
				<div class="container text-center">
					<div class="kokonut-pill">
						<span class="pill-dot"></span>
						<span>Technical Knowledge Base</span>
						<span class="pill-count">{posts.length} Guides</span>
					</div>

					<h1 class="hero-heading">
						Engineering Insights &amp;<br />
						<span class="text-gradient">Water Treatment Knowledge</span>
					</h1>

					<p class="hero-subheading">
						Practical design calculations, membrane chemistry, sizing formulas, and regulatory compliance tips from our manufacturing plant in Vapi, Gujarat.
					</p>

					<!-- Kokonut UI Interactive Search & Filter Controls -->
					<div class="blog-controls-container">
						<!-- Live Search Input -->
						<div class="blog-search-box">
							<svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="11" cy="11" r="8"></circle>
								<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
							</svg>
							<input
								type="text"
								id="blog-search-input"
								placeholder="Search guides by plant type, membrane, ETP/STP, sizing..."
								aria-label="Search technical guides"
								autocomplete="off"
							/>
							<button type="button" id="blog-search-clear" class="search-clear-btn" aria-label="Clear search" style="display: none;">
								✕
							</button>
						</div>

						<!-- Interactive Kokonut UI Filter Tabs -->
						<div class="category-tabs-rail" role="tablist" aria-label="Filter guides by category">
							{categories.map((cat, idx) => (
								<button
									type="button"
									class={`tab-pill ${idx === 0 ? 'active' : ''}`}
									data-category={cat}
									role="tab"
									aria-selected={idx === 0 ? 'true' : 'false'}
								>
									{cat}
								</button>
							))}
						</div>
					</div>
				</div>
			</section>

			<!-- Blog Content Area -->
			<section class="section" style="padding-top: 1.5rem;">
				<div class="container">
					<!-- Filter Status & Results Counter -->
					<div class="filter-results-bar">
						<div class="results-count">
							Showing <span id="visible-post-count">{posts.length}</span> of {posts.length} technical guides
						</div>
						<div id="active-filter-indicator" class="active-filter-tag" style="display: none;">
							<span id="active-filter-label">All</span>
							<button type="button" id="reset-filter-btn" class="filter-reset-icon" title="Reset filter">✕</button>
						</div>
					</div>

					<!-- Featured Post Card (Kokonut UI 3D Glass) -->
					{featuredPost && (
						<div class="featured-post-wrapper blog-card-item" data-category={featuredPost.data.category || 'Water Treatment'} data-title={featuredPost.data.title.toLowerCase()} data-desc={featuredPost.data.description.toLowerCase()}>
							<div class="featured-badge">★ Spotlight Guide</div>
							<div class="featured-card">
								<a href={`/blog/${featuredPost.id}/`} class="featured-img-link">
									<img
										src={featuredPost.data.heroImage || '/images/hero-plant.jpg'}
										alt={featuredPost.data.title}
										class="featured-img"
									/>
									<span class="img-overlay-chip">{featuredPost.data.category || 'Water Treatment'}</span>
								</a>
								<div class="featured-content">
									<div class="post-meta-top">
										<span class="kokonut-tag-pill">{featuredPost.data.category || 'Water Treatment'}</span>
										<span class="reading-time">
											<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
											{featuredPost.data.readingTime || '5 min read'}
										</span>
									</div>
									<h2 class="featured-title">
										<a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a>
									</h2>
									<p class="featured-desc">{featuredPost.data.description}</p>
									<div class="featured-footer">
										<div class="post-author">
											<div class="author-mini-avatar">AS</div>
											<span>By {featuredPost.data.author || 'Aqua Shakti Team'}</span>
											<span>•</span>
											<FormattedDate date={featuredPost.data.pubDate} />
										</div>
										<a href={`/blog/${featuredPost.id}/`} class="btn-kokonut-action">
											<span>Read Guide</span>
											<span class="btn-arrow">&rarr;</span>
										</a>
									</div>
								</div>
							</div>
						</div>
					)}

					<!-- Grid of Other Posts -->
					<div class="grid-3 blog-grid" id="blog-cards-grid">
						{otherPosts.map((post) => (
							<article
								class="card card-hover post-card blog-card-item"
								data-category={post.data.category}
								data-title={post.data.title.toLowerCase()}
								data-desc={post.data.description.toLowerCase()}
							>
								<a href={`/blog/${post.id}/`} class="post-thumbnail-link">
									<img
										src={post.data.heroImage || '/images/hero-plant.jpg'}
										alt={post.data.title}
										class="post-thumbnail"
									/>
									<span class="post-cat-badge">{post.data.category}</span>
								</a>

								<div class="post-card-body">
									<div class="post-card-meta">
										<span class="reading-time">
											<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
											{post.data.readingTime}
										</span>
										<span>•</span>
										<FormattedDate date={post.data.pubDate} />
									</div>

									<h3 class="post-card-title">
										<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									</h3>

									<p class="post-card-excerpt">
										{post.data.description}
									</p>

									<div class="post-card-footer">
										<div class="post-card-author">Aqua Shakti Engineers</div>
										<a href={`/blog/${post.id}/`} class="read-more-link">
											Read Article &rarr;
										</a>
									</div>
								</div>
							</article>
						))}
					</div>

					<!-- Empty Search State -->
					<div id="blog-empty-state" class="empty-state-card" style="display: none;">
						<div class="empty-icon">🔍</div>
						<h3>No matching engineering guides found</h3>
						<p>Try searching for different keywords or clear the category filters.</p>
						<button type="button" id="empty-reset-btn" class="btn btn-secondary btn-sm" style="margin-top: 1rem;">
							Reset All Filters
						</button>
					</div>
				</div>
			</section>
		</main>

		<Footer />
		<QuoteModal />

		<script is:inline>
			(function () {
				const searchInput = document.getElementById('blog-search-input');
				const clearBtn = document.getElementById('blog-search-clear');
				const tabPills = document.querySelectorAll('.tab-pill');
				const cardItems = document.querySelectorAll('.blog-card-item');
				const countEl = document.getElementById('visible-post-count');
				const emptyState = document.getElementById('blog-empty-state');
				const activeFilterIndicator = document.getElementById('active-filter-indicator');
				const activeFilterLabel = document.getElementById('active-filter-label');
				const resetFilterBtn = document.getElementById('reset-filter-btn');
				const emptyResetBtn = document.getElementById('empty-reset-btn');

				let activeCategory = 'All';
				let searchQuery = '';

				function filterArticles() {
					let visibleCount = 0;
					const q = searchQuery.trim().toLowerCase();

					cardItems.forEach(card => {
						const cardCategory = card.getAttribute('data-category') || '';
						const cardTitle = card.getAttribute('data-title') || '';
						const cardDesc = card.getAttribute('data-desc') || '';

						const matchesCategory = activeCategory === 'All' || cardCategory.toLowerCase() === activeCategory.toLowerCase();
						const matchesSearch = !q || cardTitle.includes(q) || cardDesc.includes(q) || cardCategory.toLowerCase().includes(q);

						if (matchesCategory && matchesSearch) {
							card.style.display = '';
							visibleCount++;
						} else {
							card.style.display = 'none';
						}
					});

					if (countEl) countEl.textContent = visibleCount;

					if (emptyState) {
						emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
					}

					// Update active filter badge
					if (activeFilterIndicator && activeFilterLabel) {
						if (activeCategory !== 'All' || q) {
							activeFilterIndicator.style.display = 'inline-flex';
							activeFilterLabel.textContent = activeCategory !== 'All' ? activeCategory : `"${q}"`;
						} else {
							activeFilterIndicator.style.display = 'none';
						}
					}
				}

				// Tab click handler
				tabPills.forEach(pill => {
					pill.addEventListener('click', () => {
						tabPills.forEach(p => {
							p.classList.remove('active');
							p.setAttribute('aria-selected', 'false');
						});
						pill.classList.add('active');
						pill.setAttribute('aria-selected', 'true');
						activeCategory = pill.getAttribute('data-category') || 'All';
						filterArticles();
					});
				});

				// Search input handler
				if (searchInput) {
					searchInput.addEventListener('input', (e) => {
						searchQuery = e.target.value;
						if (clearBtn) {
							clearBtn.style.display = searchQuery ? 'block' : 'none';
						}
						filterArticles();
					});
				}

				// Clear button handler
				if (clearBtn) {
					clearBtn.addEventListener('click', () => {
						if (searchInput) {
							searchInput.value = '';
							searchQuery = '';
							clearBtn.style.display = 'none';
							searchInput.focus();
							filterArticles();
						}
					});
				}

				// Reset handlers
				function resetAll() {
					activeCategory = 'All';
					searchQuery = '';
					if (searchInput) {
						searchInput.value = '';
					}
					if (clearBtn) {
						clearBtn.style.display = 'none';
					}
					tabPills.forEach((p, idx) => {
						if (idx === 0) {
							p.classList.add('active');
							p.setAttribute('aria-selected', 'true');
						} else {
							p.classList.remove('active');
							p.setAttribute('aria-selected', 'false');
						}
					});
					filterArticles();
				}

				if (resetFilterBtn) resetFilterBtn.addEventListener('click', resetAll);
				if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);
			})();
		</script>

		<style>
			.blog-index-page {
				background-color: #f8fafc;
				padding-bottom: 5rem;
				min-height: 80vh;
			}

			.blog-hero {
				background: radial-gradient(circle at 50% 20%, #e0f2fe 0%, #f0f9ff 60%, #f8fafc 100%);
				padding: 5rem 1rem 2.5rem 1rem;
				border-bottom: 1px solid rgba(226, 232, 240, 0.8);
			}

			.text-center {
				text-align: center;
			}

			/* Kokonut UI Pill */
			.kokonut-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.6rem;
				background: #ffffff;
				border: 1px solid #bae6fd;
				padding: 0.35rem 0.95rem;
				border-radius: 9999px;
				font-size: 0.82rem;
				font-weight: 700;
				color: #0369a1;
				box-shadow: 0 2px 10px rgba(2, 132, 199, 0.08);
				margin-bottom: 1.25rem;
			}

			.pill-dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: #0284c7;
				box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.2);
				animation: pulseDot 2s infinite ease-in-out;
			}

			@keyframes pulseDot {
				0%, 100% { transform: scale(1); opacity: 1; }
				50% { transform: scale(1.2); opacity: 0.7; }
			}

			.pill-count {
				background: #e0f2fe;
				color: #0284c7;
				padding: 0.15rem 0.5rem;
				border-radius: 9999px;
				font-size: 0.75rem;
			}

			.hero-heading {
				font-size: clamp(2.2rem, 4vw, 3.25rem);
				font-weight: 800;
				color: #0f172a;
				line-height: 1.15;
				margin-bottom: 1rem;
				letter-spacing: -0.02em;
			}

			.text-gradient {
				background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.hero-subheading {
				max-width: 680px;
				margin: 0 auto 2.25rem auto;
				font-size: 1.05rem;
				color: #475569;
				line-height: 1.6;
			}

			/* Controls Container */
			.blog-controls-container {
				max-width: 760px;
				margin: 0 auto;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
				align-items: center;
			}

			/* Kokonut UI Live Search Box */
			.blog-search-box {
				position: relative;
				width: 100%;
				max-width: 580px;
			}

			.search-icon {
				position: absolute;
				left: 1.1rem;
				top: 50%;
				transform: translateY(-50%);
				color: #64748b;
				pointer-events: none;
			}

			.blog-search-box input {
				width: 100%;
				padding: 0.85rem 2.8rem 0.85rem 3rem;
				background: #ffffff;
				border: 1px solid #cbd5e1;
				border-radius: 9999px;
				font-size: 0.95rem;
				color: #0f172a;
				box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
				transition: all 0.25s ease;
				box-sizing: border-box;
			}

			.blog-search-box input:focus {
				outline: none;
				border-color: #0284c7;
				box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.15), 0 8px 24px rgba(2, 132, 199, 0.1);
			}

			.search-clear-btn {
				position: absolute;
				right: 1.1rem;
				top: 50%;
				transform: translateY(-50%);
				background: #e2e8f0;
				border: none;
				border-radius: 50%;
				width: 20px;
				height: 20px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 0.7rem;
				color: #475569;
				cursor: pointer;
				transition: all 0.2s;
			}

			.search-clear-btn:hover {
				background: #cbd5e1;
				color: #0f172a;
			}

			/* Interactive Category Tabs Rail */
			.category-tabs-rail {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				background: rgba(255, 255, 255, 0.9);
				backdrop-filter: blur(8px);
				padding: 0.35rem 0.45rem;
				border-radius: 9999px;
				border: 1px solid #e2e8f0;
				box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
				max-width: 100%;
				overflow-x: auto;
				scrollbar-width: none;
			}

			.category-tabs-rail::-webkit-scrollbar {
				display: none;
			}

			.tab-pill {
				background: transparent;
				border: none;
				padding: 0.45rem 1.1rem;
				border-radius: 9999px;
				font-size: 0.85rem;
				font-weight: 600;
				color: #64748b;
				cursor: pointer;
				transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
				white-space: nowrap;
			}

			.tab-pill:hover {
				color: #0f172a;
				background: #f1f5f9;
			}

			.tab-pill.active {
				background: #0284c7;
				color: #ffffff;
				box-shadow: 0 2px 8px rgba(2, 132, 199, 0.35);
			}

			/* Results Bar */
			.filter-results-bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.75rem 0.25rem 1.25rem 0.25rem;
				border-bottom: 1px solid #e2e8f0;
				margin-bottom: 2rem;
				font-size: 0.88rem;
				color: #64748b;
			}

			.results-count {
				font-weight: 500;
			}

			.results-count span {
				color: #0f172a;
				font-weight: 700;
			}

			.active-filter-tag {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				background: #e0f2fe;
				color: #0369a1;
				font-weight: 600;
				font-size: 0.8rem;
				padding: 0.2rem 0.6rem;
				border-radius: 9999px;
			}

			.filter-reset-icon {
				background: transparent;
				border: none;
				color: #0284c7;
				cursor: pointer;
				font-size: 0.75rem;
				padding: 0;
			}

			/* Featured Post Card */
			.featured-post-wrapper {
				position: relative;
				margin-bottom: 3.5rem;
			}

			.featured-badge {
				position: absolute;
				top: -12px;
				left: 2rem;
				background: #0284c7;
				color: #ffffff;
				font-size: 0.75rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				padding: 0.3rem 0.95rem;
				border-radius: 9999px;
				z-index: 10;
				box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35);
			}

			.featured-card {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 1.25rem;
				overflow: hidden;
				display: grid;
				grid-template-columns: 1.2fr 1fr;
				box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.06), 0 8px 10px -6px rgba(15, 23, 42, 0.04);
				transition: all 0.3s ease;
			}

			.featured-card:hover {
				box-shadow: 0 20px 35px -5px rgba(2, 132, 199, 0.12);
				border-color: #bae6fd;
				transform: translateY(-2px);
			}

			.featured-img-link {
				display: block;
				overflow: hidden;
				height: 100%;
				position: relative;
			}

			.featured-img {
				width: 100%;
				height: 100%;
				min-height: 350px;
				object-fit: cover;
				transition: transform 0.5s ease;
			}

			.featured-card:hover .featured-img {
				transform: scale(1.04);
			}

			.img-overlay-chip {
				position: absolute;
				bottom: 1rem;
				left: 1rem;
				background: rgba(15, 23, 42, 0.85);
				backdrop-filter: blur(6px);
				color: #ffffff;
				font-size: 0.75rem;
				font-weight: 700;
				padding: 0.3rem 0.75rem;
				border-radius: 9999px;
				letter-spacing: 0.03em;
			}

			.featured-content {
				padding: 2.5rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.post-meta-top {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 1rem;
			}

			.kokonut-tag-pill {
				background: #e0f2fe;
				color: #0369a1;
				font-size: 0.75rem;
				font-weight: 700;
				padding: 0.25rem 0.75rem;
				border-radius: 9999px;
				letter-spacing: 0.03em;
			}

			.reading-time {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				font-size: 0.82rem;
				color: #64748b;
				font-weight: 600;
			}

			.featured-title {
				font-size: clamp(1.4rem, 2.2vw, 1.85rem);
				margin-bottom: 1rem;
				line-height: 1.3;
				font-weight: 800;
			}

			.featured-title a {
				color: #0f172a;
				text-decoration: none;
				transition: color 0.2s;
			}

			.featured-title a:hover {
				color: #0284c7;
			}

			.featured-desc {
				color: #475569;
				font-size: 1rem;
				line-height: 1.6;
				margin-bottom: 1.75rem;
			}

			.featured-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 1rem;
				padding-top: 1.25rem;
				border-top: 1px solid #f1f5f9;
			}

			.post-author {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.85rem;
				color: #64748b;
			}

			.author-mini-avatar {
				width: 26px;
				height: 26px;
				border-radius: 50%;
				background: #0284c7;
				color: #ffffff;
				font-size: 0.7rem;
				font-weight: 800;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.btn-kokonut-action {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				background: #0284c7;
				color: #ffffff;
				font-size: 0.85rem;
				font-weight: 700;
				padding: 0.55rem 1.15rem;
				border-radius: 9999px;
				text-decoration: none;
				box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
				transition: all 0.2s;
			}

			.btn-kokonut-action:hover {
				background: #0369a1;
				box-shadow: 0 6px 16px rgba(2, 132, 199, 0.35);
			}

			.btn-arrow {
				transition: transform 0.2s;
			}

			.btn-kokonut-action:hover .btn-arrow {
				transform: translateX(3px);
			}

			/* Grid of Posts */
			.blog-grid {
				align-items: stretch;
				gap: 2rem;
			}

			.post-card {
				padding: 0;
				display: flex;
				flex-direction: column;
				border-radius: 1.1rem;
				background: #ffffff;
				border: 1px solid #e2e8f0;
				box-shadow: 0 4px 15px rgba(15, 23, 42, 0.04);
				transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
				overflow: hidden;
			}

			.post-card:hover {
				transform: translateY(-4px);
				box-shadow: 0 16px 30px rgba(2, 132, 199, 0.12);
				border-color: #bae6fd;
			}

			.post-thumbnail-link {
				display: block;
				position: relative;
				overflow: hidden;
				aspect-ratio: 16 / 10;
			}

			.post-thumbnail {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.45s ease;
			}

			.post-card:hover .post-thumbnail {
				transform: scale(1.05);
			}

			.post-cat-badge {
				position: absolute;
				bottom: 0.75rem;
				left: 0.75rem;
				background: rgba(15, 23, 42, 0.85);
				backdrop-filter: blur(4px);
				color: #ffffff;
				font-size: 0.72rem;
				font-weight: 700;
				padding: 0.25rem 0.65rem;
				border-radius: 9999px;
				text-transform: uppercase;
				letter-spacing: 0.04em;
			}

			.post-card-body {
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				flex-grow: 1;
			}

			.post-card-meta {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.8rem;
				color: #64748b;
				margin-bottom: 0.75rem;
			}

			.post-card-title {
				font-size: 1.15rem;
				font-weight: 700;
				margin-bottom: 0.75rem;
				line-height: 1.4;
			}

			.post-card-title a {
				color: #0f172a;
				text-decoration: none;
				transition: color 0.2s;
			}

			.post-card-title a:hover {
				color: #0284c7;
			}

			.post-card-excerpt {
				color: #64748b;
				font-size: 0.92rem;
				line-height: 1.55;
				margin-bottom: 1.5rem;
				flex-grow: 1;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.post-card-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding-top: 1rem;
				border-top: 1px solid #f1f5f9;
			}

			.post-card-author {
				font-size: 0.8rem;
				color: #64748b;
				font-weight: 600;
			}

			.read-more-link {
				font-weight: 700;
				font-size: 0.85rem;
				color: #0284c7;
				text-decoration: none;
				transition: transform 0.2s;
				display: inline-block;
			}

			.post-card:hover .read-more-link {
				color: #0369a1;
				transform: translateX(2px);
			}

			/* Empty State */
			.empty-state-card {
				background: #ffffff;
				border: 1px dashed #cbd5e1;
				border-radius: 1rem;
				padding: 3rem 1.5rem;
				text-align: center;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				margin-top: 2rem;
			}

			.empty-icon {
				font-size: 2.5rem;
				margin-bottom: 1rem;
			}

			.empty-state-card h3 {
				color: #0f172a;
				margin-bottom: 0.5rem;
			}

			.empty-state-card p {
				color: #64748b;
				font-size: 0.95rem;
			}

			@media (max-width: 900px) {
				.featured-card {
					grid-template-columns: 1fr;
				}
				.featured-img {
					min-height: 240px;
					max-height: 280px;
				}
				.featured-content {
					padding: 1.75rem;
				}
			}

			@media (max-width: 600px) {
				.blog-hero {
					padding: 3.5rem 1rem 1.75rem 1rem;
				}
				.featured-content {
					padding: 1.25rem;
				}
				.featured-badge {
					left: 1rem;
				}
			}
		</style>
	</body>
</html>
