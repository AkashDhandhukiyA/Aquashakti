		<script is:inline>
			(function () {
				const searchInput = document.getElementById('blog-search-input');
				const clearBtn = document.getElementById('blog-search-clear');
				const tabPills = document.querySelectorAll('.tab-pill');
				const cardItems = document.querySelectorAll('.blog-card-item');
				const countEl = document.getElementById('visible-post-count');
				const emptyState = document.getElementById('blog-empty-state');
				const activeFilterIndicator = document.getElementById('active-filter-indicator');
				const activeFilterLabel = document.getElementById('active-filter-label');
				const resetFilterBtn = document.getElementById('reset-filter-btn');
				const emptyResetBtn = document.getElementById('empty-reset-btn');

				let activeCategory = 'All';
				let searchQuery = '';

				function filterArticles() {
					let visibleCount = 0;
					const q = searchQuery.trim().toLowerCase();

					cardItems.forEach(card => {
						const cardCategory = card.getAttribute('data-category') || '';
						const cardTitle = card.getAttribute('data-title') || '';
						const cardDesc = card.getAttribute('data-desc') || '';

						const matchesCategory = activeCategory === 'All' || cardCategory.toLowerCase() === activeCategory.toLowerCase();
						const matchesSearch = !q || cardTitle.includes(q) || cardDesc.includes(q) || cardCategory.toLowerCase().includes(q);

						if (matchesCategory && matchesSearch) {
							card.style.display = '';
							visibleCount++;
						} else {
							card.style.display = 'none';
						}
					});

					if (countEl) countEl.textContent = visibleCount;

					if (emptyState) {
						emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
					}

					// Update active filter badge
					if (activeFilterIndicator && activeFilterLabel) {
						if (activeCategory !== 'All' || q) {
							activeFilterIndicator.style.display = 'inline-flex';
							activeFilterLabel.textContent = activeCategory !== 'All' ? activeCategory : `"${q}"`;
						} else {
							activeFilterIndicator.style.display = 'none';
						}
					}
				}

				// Tab click handler
				tabPills.forEach(pill => {
					pill.addEventListener('click', () => {
						tabPills.forEach(p => {
							p.classList.remove('active');
							p.setAttribute('aria-selected', 'false');
						});
						pill.classList.add('active');
						pill.setAttribute('aria-selected', 'true');
						activeCategory = pill.getAttribute('data-category') || 'All';
						filterArticles();
					});
				});

				// Search input handler
				if (searchInput) {
					searchInput.addEventListener('input', (e) => {
						searchQuery = e.target.value;
						if (clearBtn) {
							clearBtn.style.display = searchQuery ? 'block' : 'none';
						}
						filterArticles();
					});
				}

				// Clear button handler
				if (clearBtn) {
					clearBtn.addEventListener('click', () => {
						if (searchInput) {
							searchInput.value = '';
							searchQuery = '';
							clearBtn.style.display = 'none';
							searchInput.focus();
							filterArticles();
						}
					});
				}

				// Reset handlers
				function resetAll() {
					activeCategory = 'All';
					searchQuery = '';
					if (searchInput) {
						searchInput.value = '';
					}
					if (clearBtn) {
						clearBtn.style.display = 'none';
					}
					tabPills.forEach((p, idx) => {
						if (idx === 0) {
							p.classList.add('active');
							p.setAttribute('aria-selected', 'true');
						} else {
							p.classList.remove('active');
							p.setAttribute('aria-selected', 'false');
						}
					});
					filterArticles();
				}

				if (resetFilterBtn) resetFilterBtn.addEventListener('click', resetAll);
				if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

				// ==========================================================
				// 1. BLOG CAROUSEL MOMENTUM & TOUCH SWIPE LOGIC
				// ==========================================================
				const bScroller = document.getElementById('blog-carousel-rail');
				const bTrack = document.getElementById('blog-carousel-track');
				const bPrevBtn = document.getElementById('blog-carousel-prev');
				const bNextBtn = document.getElementById('blog-carousel-next');
				const bIndexEl = document.getElementById('blog-carousel-idx');
				const bDots = Array.from(document.querySelectorAll('.carousel-dot-sm'));

				if (bScroller && bTrack) {
					const bCards = Array.from(bTrack.querySelectorAll('.blog-carousel-card'));
					const totalSlides = bCards.length;
					let bActiveIdx = 0;
					let bIsDown = false;
					let bStartX = 0;
					let bScrollLeft = 0;

					function getBCardWidth() {
						if (bCards[0]) {
							const gap = parseFloat(window.getComputedStyle(bTrack).gap) || 20;
							return bCards[0].offsetWidth + gap;
						}
						return 320;
					}

					function updateBCarouselState() {
						const cardW = getBCardWidth();
						bActiveIdx = Math.round(bScroller.scrollLeft / cardW);
						bActiveIdx = Math.max(0, Math.min(bActiveIdx, totalSlides - 1));

						if (bIndexEl) {
							bIndexEl.textContent = String(bActiveIdx + 1).padStart(2, '0');
						}
						if (bPrevBtn) bPrevBtn.disabled = bActiveIdx === 0;
						if (bNextBtn) bNextBtn.disabled = bActiveIdx >= totalSlides - 1;

						bDots.forEach((dot, idx) => {
							if (idx === bActiveIdx) {
								dot.classList.add('active');
								dot.setAttribute('aria-selected', 'true');
							} else {
								dot.classList.remove('active');
								dot.setAttribute('aria-selected', 'false');
							}
						});
					}

					function scrollToBCard(index) {
						const cardW = getBCardWidth();
						bScroller.scrollTo({
							left: index * cardW,
							behavior: 'smooth'
						});
					}

					bPrevBtn?.addEventListener('click', () => scrollToBCard(bActiveIdx - 1));
					bNextBtn?.addEventListener('click', () => scrollToBCard(bActiveIdx + 1));

					bDots.forEach(dot => {
						dot.addEventListener('click', () => {
							const idx = parseInt(dot.getAttribute('data-idx') || '0', 10);
							scrollToBCard(idx);
						});
					});

					let bScrollTimer = null;
					bScroller.addEventListener('scroll', () => {
						if (!bScrollTimer) {
							bScrollTimer = requestAnimationFrame(() => {
								updateBCarouselState();
								bScrollTimer = null;
							});
						}
					}, { passive: true });

					// Pointer drag for desktop mouse only (touch uses native 60fps swipe)
					bScroller.addEventListener('pointerdown', (e) => {
						if (e.pointerType === 'touch') return;
						if (e.target.closest('button, a, input')) return;
						bIsDown = true;
						bScroller.classList.add('is-dragging');
						bStartX = e.pageX - bScroller.offsetLeft;
						bScrollLeft = bScroller.scrollLeft;
					});

					window.addEventListener('pointermove', (e) => {
						if (!bIsDown) return;
						const x = e.pageX - bScroller.offsetLeft;
						const walk = x - bStartX;
						bScroller.scrollLeft = bScrollLeft - walk;
					});

					window.addEventListener('pointerup', () => {
						if (!bIsDown) return;
						bIsDown = false;
						bScroller.classList.remove('is-dragging');
					});

					updateBCarouselState();
				}

				// ==========================================================
				// 2. INTERACTIVE TECHNICAL STANDARDS ACCORDION CLOSURES
				// ==========================================================
				const accTriggers = document.querySelectorAll('.acc-toggle-trigger');
				accTriggers.forEach(btn => {
					btn.addEventListener('click', () => {
						const targetId = btn.getAttribute('data-target');
						const panel = document.getElementById(targetId);
						const isExpanded = btn.getAttribute('aria-expanded') === 'true';
						const icon = btn.querySelector('.acc-icon-btn');

						if (isExpanded) {
							btn.setAttribute('aria-expanded', 'false');
							if (panel) {
								panel.hidden = true;
								panel.style.display = 'none';
							}
							if (icon) icon.textContent = '+';
						} else {
							btn.setAttribute('aria-expanded', 'true');
							if (panel) {
								panel.hidden = false;
								panel.style.display = 'block';
							}
							if (icon) icon.textContent = '−';
						}
					});
				});

				// ==========================================================
				// 3. CARD-LEVEL QUICK TECHNICAL HIGHLIGHTS CLOSURES
				// ==========================================================
				const cardClosureBtns = document.querySelectorAll('.blog-closure-btn');
				cardClosureBtns.forEach(btn => {
					btn.addEventListener('click', (e) => {
						e.preventDefault();
						e.stopPropagation();
						const targetId = btn.getAttribute('data-closure-id');
						const panel = document.getElementById(targetId);
						const isExpanded = btn.getAttribute('aria-expanded') === 'true';
						const icon = btn.querySelector('.closure-icon-indicator');
						const hint = btn.querySelector('.closure-btn-hint');

						if (isExpanded) {
							btn.setAttribute('aria-expanded', 'false');
							if (panel) {
								panel.hidden = true;
								panel.style.display = 'none';
							}
							if (icon) icon.textContent = '+';
							if (hint) hint.textContent = 'Expand';
						} else {
							btn.setAttribute('aria-expanded', 'true');
							if (panel) {
								panel.hidden = false;
								panel.style.display = 'block';
							}
							if (icon) icon.textContent = '−';
							if (hint) hint.textContent = 'Hide';
						}
					});
				});
			})();
		</script>

