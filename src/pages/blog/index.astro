---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import QuoteModal from '../../components/QuoteModal.astro';
import { COMPANY_NAME } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const otherPosts = posts.slice(1);

const categories = ['All', 'Industrial RO', 'Wastewater Treatment', 'Water Purification', 'Commercial RO'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Water Treatment Blog & Engineering Guides | ${COMPANY_NAME}`}
			description="Technical guides, process diagrams, membrane technology, and wastewater treatment insights from Aqua Shakti Industries engineers in Vapi, Gujarat."
			image="/images/hero-plant.jpg"
		/>
	</head>
	<body>
		<Header />

		<main class="blog-index-page">
			<!-- Kokonut UI Hero -->
			<section class="blog-hero">
				<div class="container text-center">
					<div class="kokonut-pill">
						<span class="pill-dot"></span>
						<span>Technical Knowledge Base</span>
						<span class="pill-count">{posts.length} Guides</span>
					</div>

					<h1 class="hero-heading">
						Engineering Insights &amp;<br />
						<span class="text-gradient">Water Treatment Knowledge</span>
					</h1>

					<p class="hero-subheading">
						Practical design calculations, membrane chemistry, sizing formulas, and regulatory compliance tips from our manufacturing plant in Vapi, Gujarat.
					</p>

					<!-- Kokonut UI Interactive Search & Filter Controls -->
					<div class="blog-controls-container">
						<!-- Live Search Input -->
						<div class="blog-search-box">
							<svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="11" cy="11" r="8"></circle>
								<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
							</svg>
							<input
								type="text"
								id="blog-search-input"
								placeholder="Search guides by plant type, membrane, ETP/STP, sizing..."
								aria-label="Search technical guides"
								autocomplete="off"
							/>
							<button type="button" id="blog-search-clear" class="search-clear-btn" aria-label="Clear search" style="display: none;">
								✕
							</button>
						</div>

						<!-- Interactive Kokonut UI Filter Tabs -->
						<div class="category-tabs-rail" role="tablist" aria-label="Filter guides by category">
							{categories.map((cat, idx) => (
								<button
									type="button"
									class={`tab-pill ${idx === 0 ? 'active' : ''}`}
									data-category={cat}
									role="tab"
									aria-selected={idx === 0 ? 'true' : 'false'}
								>
									{cat}
								</button>
							))}
						</div>
					</div>
				</div>
			</section>

			<!-- Blog Content Area -->
			<section class="section" style="padding-top: 1.5rem;">
				<div class="container">
					<!-- Filter Status & Results Counter -->
					<div class="filter-results-bar">
						<div class="results-count">
							Showing <span id="visible-post-count">{posts.length}</span> of {posts.length} technical guides
						</div>
						<div id="active-filter-indicator" class="active-filter-tag" style="display: none;">
							<span id="active-filter-label">All</span>
							<button type="button" id="reset-filter-btn" class="filter-reset-icon" title="Reset filter">✕</button>
						</div>
					</div>

					<!-- Featured Post Card (Kokonut UI 3D Glass) -->
					{featuredPost && (
						<div class="featured-post-wrapper blog-card-item" data-category={featuredPost.data.category || 'Water Treatment'} data-title={featuredPost.data.title.toLowerCase()} data-desc={featuredPost.data.description.toLowerCase()}>
							<div class="featured-badge">★ Spotlight Guide</div>
							<div class="featured-card">
								<a href={`/blog/${featuredPost.id}/`} class="featured-img-link">
									<img
										src={featuredPost.data.heroImage || '/images/hero-plant.jpg'}
										alt={featuredPost.data.title}
										class="featured-img"
									/>
									<span class="img-overlay-chip">{featuredPost.data.category || 'Water Treatment'}</span>
								</a>
								<div class="featured-content">
									<div class="post-meta-top">
										<span class="kokonut-tag-pill">{featuredPost.data.category || 'Water Treatment'}</span>
										<span class="reading-time">
											<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
											{featuredPost.data.readingTime || '5 min read'}
										</span>
									</div>
									<h2 class="featured-title">
										<a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a>
									</h2>
									<p class="featured-desc">{featuredPost.data.description}</p>
									<div class="featured-footer">
										<div class="post-author">
											<div class="author-mini-avatar">AS</div>
											<span>By {featuredPost.data.author || 'Aqua Shakti Team'}</span>
											<span>•</span>
											<FormattedDate date={featuredPost.data.pubDate} />
										</div>
										<a href={`/blog/${featuredPost.id}/`} class="btn-kokonut-action">
											<span>Read Guide</span>
											<span class="btn-arrow">&rarr;</span>
										</a>
									</div>

									<!-- Interactive Closure for Featured Article -->
									<div class="blog-card-closure featured-closure-wrap">
										<button
											type="button"
											class="blog-closure-btn"
											data-closure-id={`closure-feat-${featuredPost.id}`}
											aria-expanded="false"
											aria-controls={`closure-feat-${featuredPost.id}`}
										>
											<span class="closure-btn-text">
												<span class="closure-icon-indicator">+</span>
												<span>Key Technical Highlights &amp; Standards</span>
											</span>
											<span class="closure-btn-hint">Expand Details</span>
										</button>
										<div class="blog-closure-content" id={`closure-feat-${featuredPost.id}`} hidden>
											<ul class="closure-bullets">
												{featuredPost.data.tags?.map(tag => (
													<li>
														<span class="bullet-dot">✓</span>
														<span>{tag}</span>
													</li>
												))}
											</ul>
										</div>
									</div>
								</div>
							</div>
						</div>
					)}

					<!-- Interactive Featured Engineering Series Carousel -->
					<div class="blog-carousel-container">
						<div class="blog-carousel-header">
							<div>
								<span class="eyebrow-tag">
									<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
									<span>FEATURED TECHNICAL GUIDES</span>
								</span>
								<h3 class="b-carousel-title">Interactive Engineering Series Carousel</h3>
							</div>
							<div class="carousel-nav-controls">
								<div class="carousel-counter">
									<span class="counter-active" id="blog-carousel-idx">01</span>
									<span class="counter-sep">/</span>
									<span class="counter-total">{String(posts.length).padStart(2, '0')}</span>
								</div>
								<div class="carousel-arrow-group">
									<button type="button" class="carousel-nav-btn prev-btn" id="blog-carousel-prev" aria-label="Previous Guide">
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
									</button>
									<button type="button" class="carousel-nav-btn next-btn" id="blog-carousel-next" aria-label="Next Guide">
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
									</button>
								</div>
							</div>
						</div>

						<div class="blog-carousel-rail" id="blog-carousel-rail">
							<div class="blog-carousel-track" id="blog-carousel-track">
								{posts.map((post, idx) => (
									<div class="blog-carousel-card" data-index={idx}>
										<div class="b-rail-card">
											<div class="b-rail-media">
												<img src={post.data.heroImage || '/images/hero-plant.jpg'} alt={post.data.title} class="b-rail-img" loading="lazy" />
												<span class="b-rail-badge">{post.data.category}</span>
											</div>
											<div class="b-rail-content">
												<div class="b-rail-meta">
													<span>{post.data.readingTime}</span>
													<span>•</span>
													<FormattedDate date={post.data.pubDate} />
												</div>
												<h4 class="b-rail-title">
													<a href={`/blog/${post.id}/`}>{post.data.title}</a>
												</h4>
												<p class="b-rail-desc">{post.data.description}</p>

												<!-- Interactive Tech Closure -->
												<div class="blog-card-closure">
													<button
														type="button"
														class="blog-closure-btn"
														data-closure-id={`rail-closure-${post.id}`}
														aria-expanded="false"
														aria-controls={`rail-closure-${post.id}`}
													>
														<span class="closure-btn-text">
															<span class="closure-icon-indicator">+</span>
															<span>Engineering Highlights</span>
														</span>
														<span class="closure-btn-hint">Details</span>
													</button>
													<div class="blog-closure-content" id={`rail-closure-${post.id}`} hidden>
														<ul class="closure-bullets">
															{post.data.tags?.map(tag => (
																<li>
																	<span class="bullet-dot">✓</span>
																	<span>{tag}</span>
																</li>
															))}
														</ul>
													</div>
												</div>

												<div class="b-rail-footer">
													<a href={`/blog/${post.id}/`} class="btn-read-sm">
														<span>Read Full Article</span>
														<span>&rarr;</span>
													</a>
												</div>
											</div>
										</div>
									</div>
								))}
							</div>
						</div>

						<div class="carousel-dots-row" id="blog-carousel-dots">
							{posts.map((_, idx) => (
								<button type="button" class={`carousel-dot-sm ${idx === 0 ? 'active' : ''}`} data-idx={idx} aria-label={`Slide ${idx + 1}`}></button>
							))}
						</div>
					</div>

					<!-- Grid of Other Posts -->
					<div class="grid-3 blog-grid" id="blog-cards-grid">
						{otherPosts.map((post) => (
							<article
								class="card card-hover post-card blog-card-item"
								data-category={post.data.category}
								data-title={post.data.title.toLowerCase()}
								data-desc={post.data.description.toLowerCase()}
							>
								<a href={`/blog/${post.id}/`} class="post-thumbnail-link">
									<img
										src={post.data.heroImage || '/images/hero-plant.jpg'}
										alt={post.data.title}
										class="post-thumbnail"
									/>
									<span class="post-cat-badge">{post.data.category}</span>
								</a>

								<div class="post-card-body">
									<div class="post-card-meta">
										<span class="reading-time">
											<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
											{post.data.readingTime}
										</span>
										<span>•</span>
										<FormattedDate date={post.data.pubDate} />
									</div>

									<h3 class="post-card-title">
										<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									</h3>

									<p class="post-card-excerpt">
										{post.data.description}
									</p>

									<!-- Interactive Closure for Grid Post -->
									<div class="blog-card-closure">
										<button
											type="button"
											class="blog-closure-btn"
											data-closure-id={`grid-closure-${post.id}`}
											aria-expanded="false"
											aria-controls={`grid-closure-${post.id}`}
										>
											<span class="closure-btn-text">
												<span class="closure-icon-indicator">+</span>
												<span>Key Technical Highlights</span>
											</span>
											<span class="closure-btn-hint">Expand</span>
										</button>
										<div class="blog-closure-content" id={`grid-closure-${post.id}`} hidden>
											<ul class="closure-bullets">
												{post.data.tags?.map(tag => (
													<li>
														<span class="bullet-dot">✓</span>
														<span>{tag}</span>
													</li>
												))}
											</ul>
										</div>
									</div>

									<div class="post-card-footer">
										<div class="post-card-author">Aqua Shakti Engineers</div>
										<a href={`/blog/${post.id}/`} class="read-more-link">
											Read Article &rarr;
										</a>
									</div>
								</div>
							</article>
						))}
					</div>

					<!-- Empty Search State -->
					<div id="blog-empty-state" class="empty-state-card" style="display: none;">
						<div class="empty-icon">🔍</div>
						<h3>No matching engineering guides found</h3>
						<p>Try searching for different keywords or clear the category filters.</p>
						<button type="button" id="empty-reset-btn" class="btn btn-secondary btn-sm" style="margin-top: 1rem;">
							Reset All Filters
						</button>
					</div>
				</div>
			</section>

			<!-- Dedicated Interactive Technical Closures Reference (Standards & Calculations) -->
			<section class="section section-alt tech-closures-section" id="standards-reference">
				<div class="container">
					<div class="section-title-wrap-centered">
						<div class="eyebrow-tag" style="margin-bottom: 0.75rem;">
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
							<span>ENGINEERING CHEAT SHEETS &amp; CLOSURES</span>
						</div>
						<h2 style="font-size: clamp(1.8rem, 3vw, 2.3rem); font-weight: 800; margin-bottom: 0.5rem;">Water Engineering Standards &amp; Calculation Closures</h2>
						<p style="color: var(--color-text-muted); max-width: 680px; margin: 0 auto 2.5rem auto;">
							Tap any technical closure below to expand reference formulas, permissible testing limits, and environmental compliance parameters.
						</p>
					</div>

					<div class="tech-closures-accordion">
						<!-- Closure 1: BIS 10500 Drinking Water Limits -->
						<div class="accordion-closure-card">
							<button type="button" class="acc-toggle-trigger" data-target="panel-bis10500" aria-expanded="false">
								<div class="acc-trigger-left">
									<span class="acc-num-badge">01</span>
									<div>
										<h3 class="acc-topic-title">BIS 10500:2012 Drinking Water Permissible Limits</h3>
										<span class="acc-topic-sub">Acceptable vs Permissible TDS, Hardness, Chlorides, Fluoride &amp; Turbidity</span>
									</div>
								</div>
								<span class="acc-icon-btn">+</span>
							</button>
							<div class="acc-collapse-panel" id="panel-bis10500" hidden>
								<div class="acc-panel-body">
									<p class="acc-panel-lead">Bureau of Indian Standards (BIS 10500) benchmark values for potable and commercial drinking water systems:</p>
									<div class="specs-table-wrapper">
										<table class="acc-mini-table">
											<thead>
												<tr>
													<th>Parameter</th>
													<th>Acceptable Limit</th>
													<th>Permissible (No Alt Source)</th>
													<th>Aqua Shakti RO Output</th>
												</tr>
											</thead>
											<tbody>
												<tr>
													<td><strong>Total Dissolved Solids (TDS)</strong></td>
													<td>&lt; 500 mg/L</td>
													<td>2,000 mg/L</td>
													<td><strong>50 – 150 mg/L</strong></td>
												</tr>
												<tr>
													<td><strong>Total Hardness (as CaCO3)</strong></td>
													<td>&lt; 200 mg/L</td>
													<td>600 mg/L</td>
													<td><strong>&lt; 10 mg/L (Softened)</strong></td>
												</tr>
												<tr>
													<td><strong>pH Value</strong></td>
													<td>6.5 to 8.5</td>
													<td>No relaxation</td>
													<td><strong>6.8 to 7.8 (Balanced)</strong></td>
												</tr>
												<tr>
													<td><strong>Chlorides (as Cl)</strong></td>
													<td>&lt; 250 mg/L</td>
													<td>1,000 mg/L</td>
													<td><strong>&lt; 20 mg/L</strong></td>
												</tr>
												<tr>
													<td><strong>Turbidity (NTU)</strong></td>
													<td>&lt; 1 NTU</td>
													<td>5 NTU</td>
													<td><strong>&lt; 0.1 NTU</strong></td>
												</tr>
											</tbody>
										</table>
									</div>
								</div>
							</div>
						</div>

						<!-- Closure 2: RO Plant Sizing & Recovery Formulas -->
						<div class="accordion-closure-card">
							<button type="button" class="acc-toggle-trigger" data-target="panel-ro-calc" aria-expanded="false">
								<div class="acc-trigger-left">
									<span class="acc-num-badge">02</span>
									<div>
										<h3 class="acc-topic-title">Reverse Osmosis Plant Recovery &amp; Sizing Formulas</h3>
										<span class="acc-topic-sub">Mathematical models for pure water recovery %, salt rejection, and flux rate</span>
									</div>
								</div>
								<span class="acc-icon-btn">+</span>
							</button>
							<div class="acc-collapse-panel" id="panel-ro-calc" hidden>
								<div class="acc-panel-body">
									<div class="formulas-grid">
										<div class="formula-card">
											<h4>1. Permeate Recovery (%)</h4>
											<code>Recovery % = (Permeate Flow ÷ Raw Feed Flow) × 100</code>
											<p>Typical recovery: 50–60% for commercial units, 65–85% for multi-stage industrial RO.</p>
										</div>
										<div class="formula-card">
											<h4>2. Salt Rejection Efficiency (%)</h4>
											<code>Rejection % = [(Feed TDS − Permeate TDS) ÷ Feed TDS] × 100</code>
											<p>Aqua Shakti imported polyamide membranes maintain 98.5% to 99.4% salt rejection.</p>
										</div>
										<div class="formula-card">
											<h4>3. Membrane Flux Rate (GFD)</h4>
											<code>Flux = Permeate Rate (GPD) ÷ (Total Membrane Area ft²)</code>
											<p>Standard design flux: 14 to 18 GFD for ground borewell water in Gujarat industrial belts.</p>
										</div>
									</div>
								</div>
							</div>
						</div>

						<!-- Closure 3: GPCB & CPCB Wastewater Norms (ETP/STP) -->
						<div class="accordion-closure-card">
							<button type="button" class="acc-toggle-trigger" data-target="panel-gpcb" aria-expanded="false">
								<div class="acc-trigger-left">
									<span class="acc-num-badge">03</span>
									<div>
										<h3 class="acc-topic-title">GPCB &amp; CPCB Industrial Wastewater Discharge Norms</h3>
										<span class="acc-topic-sub">BOD, COD, TSS, and Zero Liquid Discharge (ZLD) statutory thresholds</span>
									</div>
								</div>
								<span class="acc-icon-btn">+</span>
							</button>
							<div class="acc-collapse-panel" id="panel-gpcb" hidden>
								<div class="acc-panel-body">
									<div class="specs-table-wrapper">
										<table class="acc-mini-table">
											<thead>
												<tr>
													<th>Pollutant Parameter</th>
													<th>Inland Surface Water Limit</th>
													<th>Public Sewer Limit</th>
													<th>Aqua Shakti ETP Guaranteed Output</th>
												</tr>
											</thead>
											<tbody>
												<tr>
													<td><strong>BOD (3 days at 27°C)</strong></td>
													<td>&lt; 30 mg/L</td>
													<td>&lt; 350 mg/L</td>
													<td><strong>&lt; 10 – 20 mg/L</strong></td>
												</tr>
												<tr>
													<td><strong>COD (Chemical Oxygen Demand)</strong></td>
													<td>&lt; 250 mg/L</td>
													<td>&lt; 500 mg/L</td>
													<td><strong>&lt; 80 – 150 mg/L</strong></td>
												</tr>
												<tr>
													<td><strong>Total Suspended Solids (TSS)</strong></td>
													<td>&lt; 100 mg/L</td>
													<td>&lt; 600 mg/L</td>
													<td><strong>&lt; 30 mg/L</strong></td>
												</tr>
												<tr>
													<td><strong>Oil &amp; Grease</strong></td>
													<td>&lt; 10 mg/L</td>
													<td>&lt; 20 mg/L</td>
													<td><strong>&lt; 2 mg/L</strong></td>
												</tr>
											</tbody>
										</table>
									</div>
								</div>
							</div>
						</div>

						<!-- Closure 4: Boiler Feed Water & DM Plant Water Standards -->
						<div class="accordion-closure-card">
							<button type="button" class="acc-toggle-trigger" data-target="panel-boiler-dm" aria-expanded="false">
								<div class="acc-trigger-left">
									<span class="acc-num-badge">04</span>
									<div>
										<h3 class="acc-topic-title">Industrial Boiler Feed Water &amp; DM Plant Conductivity</h3>
										<span class="acc-topic-sub">Ion-exchange cation, anion, and mix-bed polisher quality criteria</span>
									</div>
								</div>
								<span class="acc-icon-btn">+</span>
							</button>
							<div class="acc-collapse-panel" id="panel-boiler-dm" hidden>
								<div class="acc-panel-body">
									<div class="formulas-grid">
										<div class="formula-card">
											<h4>Dual Bed (Cation + Anion)</h4>
