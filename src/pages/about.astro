---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import QuoteModal from '../components/QuoteModal.astro';
import ClientsBanner from '../components/ClientsBanner.astro';
import { COMPANY_NAME, COMPANY_ESTD, COMPANY_LOCATION, DEALERS } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About Us & Company Profile | ${COMPANY_NAME}`}
			description="Established in 2007 in Vapi, Gujarat, Aqua Shakti Industries is an ISO 9001:2008 certified manufacturer and service provider of water treatment plants."
			image="/images/hero-plant.jpg"
		/>
	</head>
	<body>
		<Header />

		<main class="about-page">
			<!-- Hero Banner -->
			<section class="about-hero">
				<div class="container text-center">
					<span class="section-tag">Company Profile</span>
					<h1>About Aqua Shakti Industries</h1>
					<p class="section-subtitle">
						Pioneering pure water engineering and wastewater recycling in Vapi, Gujarat since {COMPANY_ESTD}.
					</p>
				</div>
			</section>

			<!-- Profile Story -->
			<section class="section">
				<div class="container">
					<div class="grid-2" style="align-items: center; gap: 3.5rem;">
						<div>
							<span class="badge badge-teal">Established {COMPANY_ESTD} • Vapi, Gujarat</span>
							<h2 style="margin-top: 0.75rem;">Leading Water Treatment Plant Manufacturer & Service Provider</h2>
							<p>
								Established in the year <strong>2007, in Vapi, Valsad (Gujarat, India)</strong>, <strong>Aqua Shakti Industries</strong> is an <strong>ISO 9001:2008 certified company</strong> known to be one of the leading manufacturers, suppliers, and service providers of all kinds of Water Treatment Plants.
							</p>
							<p>
								By focusing our attention on the fulfillment of the exact needs of our customers, we have been able to carve a niche for ourselves in the industry. Our products are widely acknowledged for their <strong>easy installation, minimal maintenance requirements, and high efficiency</strong>.
							</p>
							<p>
								Our services are rendered by industry experts as per the requirements of the customers and are concluded within the given timeframe. Our qualified engineers are involved in developing innovative and economical products by using advanced technology.
							</p>
							<p>
								Our objective is to achieve continuous improvement in the quality of our products through updating our technology and procedures. <strong>We have more than 500 customers across Gujarat and India.</strong>
							</p>

							<div class="about-stats-row">
								<div class="about-stat">
									<span class="about-stat-number">500+</span>
									<span class="about-stat-desc">Industrial Clients in Gujarat</span>
								</div>
								<div class="about-stat">
									<span class="about-stat-number">18+</span>
									<span class="about-stat-desc">Years in Water Treatment</span>
								</div>
								<div class="about-stat">
									<span class="about-stat-number">ISO</span>
									<span class="about-stat-desc">9001:2008 Certified</span>
								</div>
							</div>
						</div>

						<div>
							<img src="/images/hero-plant.jpg" alt="Aqua Shakti Manufacturing Facility Vapi" style="border-radius: var(--radius-lg); box-shadow: var(--shadow-xl); width: 100%;" />
						</div>
					</div>
				</div>
			</section>

			<!-- Mission & Core Values -->
			<section class="section section-alt">
				<div class="container">
					<div class="grid-2" style="gap: 2.5rem;">
						<div class="card" style="padding: 2.5rem; border-top: 4px solid var(--primary);">
							<span class="badge badge-blue">Our Driving Purpose</span>
							<h3 style="margin-top: 0.75rem;">Our Mission</h3>
							<p style="font-size: 1.05rem; line-height: 1.7; color: #334155;">
								"We will work with clear and strategic market focus for providing customer centric solutions and services. Keeping pace with latest technological developments, we will combine our own innovative thinking to build solutions and services for strong competitive position. Through intense process and methods orientation we will ensure continuous operational improvements to provide value to the customers. High employee motivation and continued value creation for stakeholders will help us continuously tread the progressive path."
							</p>
						</div>

						<div class="card" style="padding: 2.5rem; border-top: 4px solid #10b981;">
							<span class="badge badge-teal">Quality Assurance</span>
							<h3 style="margin-top: 0.75rem;">Our Quality Policy</h3>
							<p style="font-size: 1.05rem; line-height: 1.7; color: #334155;">
								As an <strong>ISO 9001:2008 certified company</strong>, quality is deeply ingrained in every stage of our operations. From raw material procurement (SS 304/316 pipes, FRP vessels, valves) to precision welding, electronic panel integration, and pre-dispatch hydrostatic pressure testing, we guarantee seamless field operation and extended plant lifespan.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Our Team (Brochure Page 1/16) -->
			<section class="section">
				<div class="container">
					<div class="section-header">
						<span class="section-tag">Human Capital</span>
						<h2>Our Specialized Engineering Team</h2>
						<p class="section-subtitle">
							We have an experienced team of professionals who put their dedicated efforts to meet the requirements of our clients. Our expertise and knowledge have led us to mark a good name in this competitive market.
						</p>
					</div>

					<div class="grid-3" style="gap: 1.5rem;">
						<div class="card card-hover" style="padding: 1.75rem;">
							<div style="font-size: 2rem; margin-bottom: 0.75rem;">⚙️</div>
							<h4>Mechanical Engineers</h4>
							<p style="font-size: 0.9rem;">Specialize in hydraulic flow design, high pressure piping stress analysis, skid structural fabrication, and P&ID diagrams.</p>
						</div>

						<div class="card card-hover" style="padding: 1.75rem;">
							<div style="font-size: 2rem; margin-bottom: 0.75rem;">🔬</div>
							<h4>Research & Development</h4>
							<p style="font-size: 0.9rem;">Continuously innovate cost-effective filtration media, anti-scaling formulas, and biological MBBR aeration systems.</p>
						</div>

						<div class="card card-hover" style="padding: 1.75rem;">
							<div style="font-size: 2rem; margin-bottom: 0.75rem;">🔍</div>
							<h4>Quality Inspectors</h4>
							<p style="font-size: 0.9rem;">Inspect every welded seam, test vessel burst pressures, verify pump current draw, and validate permeate water TDS.</p>
						</div>

						<div class="card card-hover" style="padding: 1.75rem;">
							<div style="font-size: 2rem; margin-bottom: 0.75rem;">⚡</div>
							<h4>Technicians & Skilled Labor</h4>
							<p style="font-size: 0.9rem;">Experienced workforce certified in precision stainless steel TIG welding, electrical instrumentation, and PLC automation.</p>
						</div>

						<div class="card card-hover" style="padding: 1.75rem;">
							<div style="font-size: 2rem; margin-bottom: 0.75rem;">🚚</div>
							<h4>Installation & Commissioning</h4>
							<p style="font-size: 0.9rem;">On-site erection specialists delivering rapid turnkey commissioning across Vapi, Surat, Ankleshwar, and nationwide.</p>
						</div>

						<div class="card card-hover" style="padding: 1.75rem;">
							<div style="font-size: 2rem; margin-bottom: 0.75rem;">📞</div>
							<h4>After-Sales Service Support</h4>
							<p style="font-size: 0.9rem;">Dedicated field technicians handling preventative maintenance, membrane CIP cleaning, resin replenishment, and AMC contracts.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Testing Laboratory & Infrastructure -->
			<section class="section section-dark">
				<div class="container">
					<div class="grid-2" style="align-items: center; gap: 3rem;">
						<div>
							<span class="section-tag section-tag-dark">Manufacturing & R&D</span>
							<h2>State-of-the-Art Infrastructure in Vapi</h2>
							<p style="color: #cbd5e1;">
								Our manufacturing facility located in the premier industrial hub of <strong>Vapi, Valsad (Gujarat)</strong> is equipped with advanced metal fabrication tools, automated pipe bending, SS argon welding, and an in-house water testing laboratory.
							</p>
							<p style="color: #94a3b8;">
								Every raw water sample sent by our clients undergoes physical, chemical, and microbiological titration to ensure the custom-designed plant delivers optimal recovery and cost efficiency.
							</p>

							<div style="margin-top: 2rem;">
								<button class="btn btn-primary" data-quote-trigger data-plant="Custom Plant Consultation">
									Send Water Sample for Free Testing &rarr;
								</button>
							</div>
						</div>

						<div>
							<img src="/images/water-testing-lab.jpg" alt="Aqua Shakti Water Testing Cleanroom Laboratory" style="border-radius: var(--radius-lg); box-shadow: var(--shadow-xl); width: 100%;" />
						</div>
					</div>
				</div>
			</section>

			<!-- Reputed Clients Showcase -->
			<ClientsBanner />

			<!-- Dealer Network Strip -->
			<section class="section section-alt">
				<div class="container">
					<div class="section-header" style="margin-bottom: 2rem;">
						<span class="section-tag">Distribution Network</span>
						<h2>Authorized Dealers Across India</h2>
						<p class="section-subtitle">Supporting industrial clients in Gujarat, Uttar Pradesh, and Rajasthan.</p>
					</div>

					<div class="grid-3">
						{DEALERS.map((dealer) => (
							<div class="card" style="padding: 1.75rem;">
								<span class="badge badge-teal" style="margin-bottom: 0.5rem;">{dealer.region}</span>
								<h4>{dealer.region}</h4>
								{dealer.address && (
									<p style="font-size: 0.85rem; margin-bottom: 0.5rem; color: #475569;">
										<strong>Address:</strong> {dealer.address}
									</p>
								)}
								<p style="font-size: 0.88rem; margin-bottom: 0.5rem;">
									<strong>Contact:</strong> {dealer.phones.join(' / ')}
								</p>
								{dealer.branches && (
									<p style="font-size: 0.82rem; color: #64748b; margin-bottom: 0.5rem;">
										<strong>Branches:</strong> {dealer.branches}
									</p>
								)}
								{dealer.emails && (
									<p style="font-size: 0.82rem; color: #0284c7; margin: 0;">
										<strong>Email:</strong> {dealer.emails.join(', ')}
									</p>
								)}
							</div>
						))}
					</div>
				</div>
			</section>
		</main>

		<Footer />
		<QuoteModal />

		<style>
			.about-hero {
				background: linear-gradient(180deg, #e0f2fe 0%, #f8fafc 100%);
				padding: 4.5rem 0 2rem 0;
			}

			.text-center {
				text-align: center;
			}

			.about-stats-row {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem;
				margin-top: 2rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--border-color);
			}

			.about-stat {
				display: flex;
				flex-direction: column;
			}

			.about-stat-number {
				font-family: var(--font-display);
				font-size: 2rem;
				font-weight: 800;
				color: var(--primary);
				line-height: 1;
			}

			.about-stat-desc {
				font-size: 0.82rem;
				color: var(--text-muted);
				margin-top: 0.35rem;
			}

			@media (max-width: 800px) {
				.about-stats-row {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
