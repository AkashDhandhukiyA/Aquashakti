				height: 100%;
				object-fit: cover;
			}

			.turnkey-body {
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				flex-grow: 1;
			}
			.turnkey-body h3 {
				font-size: 1.15rem;
				font-weight: 700;
				margin-bottom: 0.4rem;
				color: var(--ink-900);
			}
			:global(html.dark) .turnkey-body h3 { color: #ffffff; }

			.turnkey-desc {
				font-size: 0.88rem;
				color: var(--ink-500);
				line-height: 1.5;
				flex-grow: 1;
				margin-bottom: 1rem;
			}
			:global(html.dark) .turnkey-desc { color: var(--ink-300); }

			.turnkey-actions {
				display: flex;
				gap: 0.75rem;
				align-items: center;
				flex-wrap: wrap;
			}

			.spec-link {
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--ink-400);
				text-decoration: none;
			}
			.spec-link:hover { color: var(--brand-500); }
			:global(html.dark) .spec-link { color: var(--ink-300); }
			:global(html.dark) .spec-link:hover { color: var(--brand-400); }

			/* ==========================================================
			   USAGE
			   ========================================================== */
			.usage-icon {
				color: var(--brand-400);
				margin-bottom: 0.75rem;
			}

			/* ==========================================================
			   WHY US + TEAM
			   ========================================================== */
			.why-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.25rem;
				margin-bottom: 2.5rem;
			}

			.why-box {
				display: flex;
				gap: 1rem;
				align-items: flex-start;
				padding: 1.25rem;
				background: var(--surface-alt);
				border: 1px solid var(--line-200);
				border-radius: var(--radius-md);
			}
			:global(html.dark) .why-box {
				background: var(--surface-dark-2);
				border-color: rgba(255,255,255,0.08);
			}

			.why-icon {
				color: var(--brand-500);
				width: 42px;
				height: 42px;
				border-radius: var(--radius-md);
				background: var(--brand-50);
				display: flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
			}
			:global(html.dark) .why-icon {
				background: rgba(2,132,199,0.18);
				color: var(--brand-400);
			}

			.why-box h4 {
				font-size: 0.98rem;
				font-weight: 700;
				color: var(--ink-900);
				margin-bottom: 0.2rem;
			}
			:global(html.dark) .why-box h4 { color: #ffffff; }

			.why-box p {
				font-size: 0.85rem;
				color: var(--ink-500);
				line-height: 1.5;
				margin: 0;
			}
			:global(html.dark) .why-box p { color: var(--ink-300); }

			.team-card {
				background: var(--surface-alt);
				border: 1px solid var(--line-200);
				border-radius: var(--radius-lg);
				padding: 2rem;
			}
			:global(html.dark) .team-card {
				background: var(--surface-dark-2);
				border-color: rgba(255,255,255,0.08);
			}

			.team-card h3 {
				font-size: 1.25rem;
				font-weight: 700;
				color: var(--ink-900);
				margin-bottom: 1rem;
			}
			:global(html.dark) .team-card h3 { color: #ffffff; }

			.team-list {
				list-style: none;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
			}
			.team-list li {
				font-size: 0.9rem;
				color: var(--ink-500);
				line-height: 1.55;
				padding-left: 1.1rem;
				position: relative;
			}
			.team-list li::before {
				content: "";
				position: absolute;
				left: 0;
				top: 0.6em;
				width: 5px;
				height: 5px;
				border-radius: 50%;
				background: var(--brand-500);
			}
			:global(html.dark) .team-list li { color: var(--ink-300); }

			.team-list strong { color: var(--ink-900); }
			:global(html.dark) .team-list strong { color: #ffffff; }

			/* ==========================================================
			   BLOG CARDS
			   ========================================================== */
			.post-card {
				padding: 0;
				overflow: hidden;
			}

			.post-thumb-link {
				display: block;
				position: relative;
				aspect-ratio: 16 / 10;
				overflow: hidden;
			}
			.post-thumb-img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.4s var(--ease);
			}
			.post-card:hover .post-thumb-img { transform: scale(1.04); }

			.post-category-tag {
				position: absolute;
				bottom: 0.7rem;
				left: 0.7rem;
				background: rgba(15,23,42,0.8);
				color: #ffffff;
				font-size: 0.68rem;
				font-weight: 600;
				padding: 0.18rem 0.55rem;
				border-radius: 4px;
			}

			.post-body {
				padding: 1.25rem;
				display: flex;
				flex-direction: column;
				flex-grow: 1;
			}
			.post-date-row {
				font-size: 0.75rem;
				color: var(--ink-400);
				display: flex;
				gap: 0.4rem;
				margin-bottom: 0.5rem;
			}

			.post-body h4 {
				font-size: 1rem;
				line-height: 1.35;
				margin-bottom: 0.5rem;
			}
			.post-body h4 a {
				color: var(--ink-900);
				text-decoration: none;
			}
			.post-body h4 a:hover { color: var(--brand-500); }
			:global(html.dark) .post-body h4 a { color: #ffffff; }

			.post-summary {
				font-size: 0.85rem;
				color: var(--ink-400);
				line-height: 1.5;
				margin-bottom: 1rem;
				flex-grow: 1;
			}
			:global(html.dark) .post-summary { color: var(--ink-300); }

			.read-post-btn {
				font-weight: 600;
				font-size: 0.82rem;
				color: var(--brand-500);
			}
			:global(html.dark) .read-post-btn { color: var(--brand-400); }

			.view-all-cta { text-align: center; margin-top: 2.5rem; }

			/* ==========================================================
			   RESPONSIVE
			   ========================================================== */
			@media (max-width: 990px) {
				.turnkey-track,
				.usage-track,
				.blog-track {
					display: flex;
					gap: 1rem;
					width: max-content;
					padding: 0 0.25rem;
				}
				.turnkey-track .turnkey-card {
					flex: 0 0 min(380px, 86vw);
					width: min(380px, 86vw);
					scroll-snap-align: start;
				}
				.usage-track .card-dark {
					flex: 0 0 min(310px, 82vw);
					width: min(310px, 82vw);
					scroll-snap-align: start;
				}
				.blog-track .post-card {
					flex: 0 0 min(330px, 84vw);
					width: min(330px, 84vw);
					scroll-snap-align: start;
				}
				.turnkey-carousel-rail,
				.usage-carousel-rail,
				.blog-carousel-rail {
					scroll-snap-type: x mandatory;
				}
				.usage-dots-row,
				.blog-dots-row { display: flex; }
			}

			@media (max-width: 960px) {
				.hero-section {
					height: auto !important;
					min-height: auto !important;
					padding: 5.5rem 0 3rem !important;
					overflow: visible !important;
					background-position: center right 20%;
				}
				.hero-container {
					grid-template-columns: 1fr;
					gap: 2rem;
					margin: 0;
				}
				.profile-grid { grid-template-columns: 1fr; }
				.experience-badge { position: static; margin-top: 1rem; }
				.why-grid { grid-template-columns: 1fr; }
			}

			@media (max-width: 640px) {
				.hero-section { padding: 5rem 0 2.5rem !important; }
				.hero-title { font-size: clamp(1.75rem, 7vw, 2.25rem); }
				.hero-subtitle { font-size: 0.9rem; margin-bottom: 1.25rem; }
				.hero-cta-group { flex-direction: column; align-items: stretch; }
				.btn-hero-primary,
				.btn-hero-secondary { width: 100%; justify-content: center; text-align: center; }
				.hero-stats-strip { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
				.stat-divider { display: none; }
				.calculator-card { padding: 1.1rem; }
				.hero-water-splash { display: none; }
				.team-card { padding: 1.5rem; }
			}

			@media (max-width: 400px) {
				.hero-section { padding: 4.6rem 0 2rem !important; }
				.stat-num { font-size: 1.2rem; }
				.stat-label { font-size: 0.68rem; }
			}

			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
					scroll-behavior: auto !important;
				}
			}
		</style>

		<!-- ==========================================================
		     JAVASCRIPT — UNCHANGED
		     ========================================================== -->
		<script is:inline>
			function calculatePlant() {
				const industry = document.getElementById('calc-industry').value;
				const usage = parseInt(document.getElementById('calc-usage').value, 10);
				const modelEl = document.getElementById('result-model-name');
				const specsEl = document.getElementById('result-specs-text');
				const quoteBtn = document.getElementById('calc-quote-btn');

				let model = '';
				let specs = '';

				if (industry === 'waste') {
					if (usage <= 5000) {
						model = '5 KLD Compact Package STP / ETP';
						specs = 'MBBR / DELTA biological treatment, skid-mounted clarifier, automated air blower.';
					} else if (usage <= 25000) {
						model = '25 KLD Turnkey ETP / STP Plant';
						specs = 'Bar screen, Equalization, Flash mixer, Clariflocculator, Sludge filter press.';
					} else {
						model = '50 KLD to 100+ KLD Industrial ETP Facility';
						specs = 'Full civil and mechanical skid, BOD/COD removal, zero liquid discharge compliant.';
					}
				} else if (industry === 'pharma') {
					if (usage <= 2000) {
						model = '250 LPH Two-Bed DM Plant (Cation + Anion)';
						specs = 'Very low conductivity (<10 µS/cm), chloride-free, semi-automatic multiport valve.';
					} else {
						model = 'Mix Bed D.M 100 / D.M 200 System (1000 - 2000 L/hr)';
						specs = 'Ultra-pure water (<0.5 µS/cm), mixed resin bed, SS 304 skid for pharma & lab formulations.';
					}
				} else {
					if (usage <= 500) {
						model = '50 LPH Commercial RO Plant (SS 304)';
						specs = 'Compact frame, 20" jumbo pre-filter, booster pump, ideal for 50-100 people.';
					} else if (usage <= 2000) {
						model = '250 LPH Commercial RO Plant';
						specs = '1.0 HP vertical multistage pump, FRP vessel, 4040 membrane, auto-flush.';
					} else if (usage <= 5000) {
						model = '500 LPH Commercial RO Plant (SS 304 Frame)';
						specs = '1.5 HP vertical pump, dual FRP vessels, rota meters, UV disinfection chamber.';
					} else if (usage <= 10000) {
						model = '1,000 LPH Commercial / Industrial RO Plant';
						specs = '2.0 HP vertical pump, 4x 4040 membranes, automated control panel, 5-micron jumbo.';
					} else if (usage <= 25000) {
						model = '2,500 LPH Industrial RO Skid';
						specs = 'SS 304 skid, 8040 industrial membranes, automated antiscalant dosing, telemetry.';
					} else {
						model = '5,000 to 20,000+ LPH Custom Industrial RO Plant';
						specs = 'Turnkey engineering for high-TDS borewell or seawater desalination with CIP skid.';
					}
				}

				modelEl.textContent = model;
				specsEl.textContent = specs;
				quoteBtn.setAttribute('data-plant', model);
				quoteBtn.setAttribute('data-capacity', usage + ' LPD');
			}

			window.calculatePlant = calculatePlant;

			const liquidSlider = document.getElementById('aqua-liquid-slider');
			liquidSlider?.addEventListener('liquid-slider-change', (e) => {
				const val = e.detail?.value;
				const usageSelect = document.getElementById('calc-usage');
				if (usageSelect && val) {
					usageSelect.value = String(val);
					calculatePlant();
				}
			});

			function initMiniCarousel(railId, prevBtnId, nextBtnId, dotsContainerId, cardSelector) {
				const rail = document.getElementById(railId);
				if (!rail) return;
				const prevBtn = document.getElementById(prevBtnId);
				const nextBtn = document.getElementById(nextBtnId);
				const dotsContainer = document.getElementById(dotsContainerId);
				const dots = dotsContainer ? Array.from(dotsContainer.querySelectorAll('button, span')) : [];
				const cards = Array.from(rail.querySelectorAll(cardSelector));

				function getStep() {
					if (cards[0]) {
						return cards[0].offsetWidth + 20;
					}
					return 320;
				}

				prevBtn?.addEventListener('click', () => {
					rail.scrollBy({ left: -getStep(), behavior: 'smooth' });
				});

				nextBtn?.addEventListener('click', () => {
					rail.scrollBy({ left: getStep(), behavior: 'smooth' });
				});

				dots.forEach((dot, idx) => {
					dot.addEventListener('click', () => {
						rail.scrollTo({ left: idx * getStep(), behavior: 'smooth' });
					});
				});

				if (dots.length) {
					rail.addEventListener('scroll', () => {
						const idx = Math.min(dots.length - 1, Math.max(0, Math.round(rail.scrollLeft / getStep())));
						dots.forEach((d, i) => {
							if (i === idx) d.classList.add('active');
							else d.classList.remove('active');
						});
					}, { passive: true });
				}
			}

			function initAllMiniCarousels() {
				initMiniCarousel('turnkey-carousel-rail', 'turnkey-prev-btn', 'turnkey-next-btn', null, '.turnkey-card');
				initMiniCarousel('usage-carousel-rail', 'usage-prev-btn', 'usage-next-btn', 'usage-dots', '.card-dark');
				initMiniCarousel('blog-carousel-rail', 'blog-prev-btn', 'blog-next-btn', 'blog-dots', '.post-card');
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initAllMiniCarousels);
			} else {
				initAllMiniCarousels();
			}
			document.addEventListener('astro:page-load', initAllMiniCarousels);
		</script>
	</body>
</html>
