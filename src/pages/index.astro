---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import QuoteModal from '../components/QuoteModal.astro';
import ClientsBanner from '../components/ClientsBanner.astro';
import LiquidSlider from '../components/LiquidSlider.astro';
import ProductCarousel from '../components/ProductCarousel.astro';
import {
	COMPANY_NAME,
	COMPANY_TAGLINE,
	SITE_DESCRIPTION,
	SITE_TITLE,
	COMPANY_PHONE,
	COMPANY_EMAIL,
} from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

/* Inline SVG icon set — no emojis */
const icons = {
	factory: `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 21h20"/><path d="M4 21V10l5-3v14"/><path d="M9 21V7l6-4v18"/><path d="M15 21V11l5-2v12"/></svg>`,
	hotel: `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 9h6v4H9z"/><path d="M9 17h6"/></svg>`,
	home: `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/></svg>`,
	hospital: `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><path d="M12 9v6M9 12h6"/></svg>`,
	building: `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16"/><path d="M15 21V9h4v12"/><path d="M9 7h.01M9 11h.01M9 15h.01"/></svg>`,
	graduation: `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1 2.5 3 6 3s6-2 6-3v-5"/><path d="M22 10v6"/></svg>`,
	handshake: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg>`,
	rupee: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12"/><path d="M6 8h12"/><path d="m6 13 8.5 8"/><path d="M6 13h3"/><path d="M9 13c6.667 0 6.667-10 0-10"/></svg>`,
	gear: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>`,
	wrench: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/images/hero-plant.jpg" />
	</head>
	<body>
		<main id="main-content">
			<!-- ======================================================
			     HERO
			     ====================================================== -->
			<section class="hero-section" aria-labelledby="hero-heading">
				<Header />

				<div class="container hero-container">
					<div class="hero-content">
						<div class="hero-badges">
							<span class="hero-badge">
								<svg class="badge-icon icon-green" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
								<span>ISO 9001:2008</span>
							</span>
							<span class="hero-badge">
								<svg class="badge-flag-svg" viewBox="0 0 24 16" width="18" height="12" aria-hidden="true">
									<rect width="24" height="5.33" fill="#FF9933"/>
									<rect y="5.33" width="24" height="5.33" fill="#FFFFFF"/>
									<rect y="10.66" width="24" height="5.34" fill="#138808"/>
									<circle cx="12" cy="8" r="2.2" fill="none" stroke="#000080" stroke-width="0.5"/>
									<circle cx="12" cy="8" r="0.5" fill="#000080"/>
								</svg>
								<span>Make in India</span>
							</span>
						</div>

						<h1 id="hero-heading" class="hero-title">
							Water solutions,<br />
							<span class="highlight-blue">engineered for industry.</span>
						</h1>

						<p class="hero-subtitle">
							RO, DM, Softener, ETP &amp; STP plants — manufactured in Vapi, Gujarat since 2007.
						</p>

						<div class="hero-cta-group">
							<button type="button" class="btn-hero-primary" data-quote-trigger data-plant="Complete Plant Requirement">
								<span>Get a free quote</span>
								<span class="arrow-icon" aria-hidden="true">&rarr;</span>
							</button>
							<a href="/products" class="btn-hero-secondary">
								<span>Explore products</span>
							</a>
						</div>

						<div class="hero-stats-strip">
							<div class="stat-item">
								<span class="stat-num">500+</span>
								<span class="stat-label">Clients</span>
							</div>
							<div class="stat-divider" aria-hidden="true"></div>
							<div class="stat-item">
								<span class="stat-num">18+</span>
								<span class="stat-label">Years</span>
							</div>
							<div class="stat-divider" aria-hidden="true"></div>
							<div class="stat-item">
								<span class="stat-num">25–50k</span>
								<span class="stat-label">LPH capacity</span>
							</div>
							<div class="stat-divider" aria-hidden="true"></div>
							<div class="stat-item">
								<span class="stat-num">100%</span>
								<span class="stat-label">Turnkey</span>
							</div>
						</div>
					</div>

					<div class="hero-card-column">
						<div class="calculator-card">
							<div class="calculator-header">
								<h3 class="calc-title">Plant Capacity Estimator</h3>
								<p class="calc-subtitle">Pick a sector and usage — get an instant recommendation.</p>
							</div>

							<form id="hero-calc-form" onsubmit="event.preventDefault(); calculatePlant();">
								<div class="calc-field-group">
									<label class="calc-label" for="calc-industry">
										<span>Industry</span>
									</label>
									<div class="select-wrapper">
										<select id="calc-industry" class="calc-select" onchange="calculatePlant()">
											<option value="factory" selected>Industrial Factory / Manufacturing</option>
											<option value="pharma">Pharmaceuticals &amp; Labs (DM Water)</option>
											<option value="hotel">Hotel, Restaurant &amp; Resort</option>
											<option value="residential">Apartment Society / Residential</option>
											<option value="hospital">Hospital &amp; Clinic</option>
											<option value="school">School / University / Hostel</option>
											<option value="waste">Effluent / Sewage Treatment (ETP/STP)</option>
										</select>
										<svg class="select-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
									</div>
								</div>

								<LiquidSlider defaultValue={10000} id="aqua-liquid-slider" />

								<select id="calc-usage" style="display: none;" aria-hidden="true" tabindex="-1" onchange="calculatePlant()">
									<option value="500">500</option>
									<option value="2000">2000</option>
									<option value="5000">5000</option>
									<option value="10000" selected>10000</option>
									<option value="25000">25000</option>
									<option value="50000">50000</option>
								</select>

								<div class="calc-result-box" id="calc-result" aria-live="polite">
									<div class="result-check-badge" aria-hidden="true">
										<svg viewBox="0 0 20 20" fill="currentColor" width="12" height="12"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
									</div>
									<div class="result-info-col">
										<div class="result-label">Recommended</div>
										<div class="result-model" id="result-model-name">1,000 LPH Commercial RO Plant (SS 304)</div>
										<div class="result-specs" id="result-specs-text">
											Vertical multistage pump, dual FRP vessels, auto-flush, imported membrane.
										</div>
									</div>
								</div>

								<button type="button" class="btn-calc-submit" id="calc-quote-btn" data-quote-trigger data-plant="1,000 LPH Commercial RO Plant (SS 304)">
									<span>Get pricing for this model &rarr;</span>
								</button>
							</form>
						</div>
					</div>
				</div>

				<div class="hero-water-splash" aria-hidden="true">
					<img src="/images/water-wave-splash.jpg" alt="" class="splash-graphic-img" loading="lazy" />
				</div>
			</section>

			<!-- ======================================================
			     ABOUT
			     ====================================================== -->
			<section class="section" id="about" aria-labelledby="about-heading">
				<div class="container">
					<div class="section-title-wrap-centered">
						<span class="eyebrow">About us</span>
						<h2 id="about-heading" class="section-title">Your partner in pure water.</h2>
						<p class="section-subtitle">
							ISO-certified manufacturer of custom water treatment plants.
						</p>
					</div>

					<div class="grid-2 profile-grid">
						<div class="profile-image-col">
							<div class="image-stack">
								<img src="/images/hero-plant.jpg" alt="Aqua Shakti Industrial RO Skid" class="main-profile-img" loading="lazy" />
								<div class="experience-badge">
									<span class="badge-num">18+</span>
									<span class="badge-text">Years</span>
								</div>
							</div>
						</div>

						<div class="profile-text-col">
							<h3 class="profile-lead-title">Engineering water systems since 2007.</h3>
							<p>
								Based in Vapi, Gujarat — ISO 9001:2008 certified manufacturer of RO plants, softeners, DM units, and ZLD ETP/STP systems.
							</p>
							<p>
								Over 500 industrial installations across western India, with SS skids, fast commissioning, and preventive maintenance.
							</p>

							<ul class="profile-features-list" role="list">
								<li class="feature-item">
									<span class="feature-icon" aria-hidden="true">✓</span>
									<span>ISO 9001:2008 certified</span>
								</li>
								<li class="feature-item">
									<span class="feature-icon" aria-hidden="true">✓</span>
									<span>GPCB &amp; CPCB compliant</span>
								</li>
								<li class="feature-item">
									<span class="feature-icon" aria-hidden="true">✓</span>
									<span>Turnkey spares &amp; chemicals</span>
								</li>
							</ul>

							<a href="/about" class="btn btn-secondary profile-cta">Read more &rarr;</a>
						</div>
					</div>
				</div>
			</section>

			<ProductCarousel />

			<!-- ======================================================
			     COMMERCIAL RO MODELS
			     ====================================================== -->
			<section class="section section-alt" aria-labelledby="commercial-heading">
				<div class="container">
					<div class="section-title-wrap-centered">
						<span class="eyebrow">Products</span>
						<h2 id="commercial-heading" class="section-title">Commercial RO lineup.</h2>
						<p class="section-subtitle">
							SS 304 · import membranes · vertical multistage pumps.
						</p>
					</div>

					<div class="spec-table-wrapper" role="region" aria-label="RO model specifications" tabindex="0">
						<table class="spec-table">
							<thead>
								<tr>
									<th scope="col">Model</th>
									<th scope="col">Capacity</th>
									<th scope="col">Membrane</th>
									<th scope="col">Pump</th>
									<th scope="col">Action</th>
								</tr>
							</thead>
							<tbody>
								{[
									['Aqua-25','25 LPH','1 × 75 GPD','Booster','25 LPH RO Plant'],
									['Aqua-50','50 LPH','2 × 100 GPD','Heavy booster','50 LPH RO Plant'],
									['Aqua-100','100 LPH','2 × 4021','0.5 HP vertical','100 LPH RO Plant'],
									['Aqua-250','250 LPH','1 × 4040','1.0 HP vertical','250 LPH RO Plant'],
									['Aqua-500','500 LPH','2 × 4040','1.5 HP vertical','500 LPH RO Plant'],
									['Aqua-1000','1,000 LPH','4 × 4040','2.0–3.0 HP vertical','1000 LPH RO Plant'],
								].map(([model, cap, membrane, pump, plant]) => (
									<tr>
										<td><strong>{model}</strong></td>
										<td>{cap}</td>
										<td>{membrane}</td>
										<td>{pump}</td>
										<td>
											<button class="btn btn-primary btn-sm" data-quote-trigger data-plant={plant}>Enquire</button>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</div>
			</section>

			<!-- ======================================================
			     TURNKEY
			     ====================================================== -->
			<section class="section" aria-labelledby="turnkey-heading">
				<div class="container">
					<div class="section-header-flex">
						<div>
							<span class="eyebrow">Turnkey systems</span>
							<h2 id="turnkey-heading" class="section-title">Built to run continuously.</h2>
						</div>
						<div class="carousel-ctrl-sm" role="group" aria-label="Turnkey navigation">
							<button type="button" class="ctrl-arrow-btn" id="turnkey-prev-btn" aria-label="Previous">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
							</button>
							<button type="button" class="ctrl-arrow-btn" id="turnkey-next-btn" aria-label="Next">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
							</button>
						</div>
					</div>

					<div class="turnkey-carousel-rail" id="turnkey-carousel-rail">
						<div class="turnkey-track">
							<article class="card card-hover turnkey-card">
								<div class="turnkey-img-wrap">
									<img src="/images/secondary-settling-plant.jpg" alt="Secondary Settling Tank" loading="lazy" />
								</div>
								<div class="turnkey-body">
									<h3>Secondary Settling Tank</h3>
									<p class="turnkey-desc">
										Hopper-bottom settling tank with multi-media filter, dosing drum and automated panel.
									</p>
									<div class="turnkey-actions">
										<button class="btn btn-primary btn-sm" data-quote-trigger data-plant="Secondary Settling Tank Plant">Get quote</button>
										<a href="/products#settling-plants" class="spec-link">Specs</a>
									</div>
								</div>
							</article>

							<article class="card card-hover turnkey-card">
								<div class="turnkey-img-wrap">
									<img src="/images/boiler-plant.jpg" alt="Industrial Boiler Plant" loading="lazy" />
								</div>
								<div class="turnkey-body">
									<h3>Industrial Boiler Plant</h3>
									<p class="turnkey-desc">
										Super Economizer, multi-fuel burners, rapid start-up and fuel savings.
									</p>
									<div class="turnkey-actions">
										<button class="btn btn-primary btn-sm" data-quote-trigger data-plant="Industrial Boiler Plant">Get quote</button>
										<a href="/products#boiler-plant" class="spec-link">Specs</a>
									</div>
								</div>
							</article>
						</div>
					</div>
				</div>
			</section>

			<ClientsBanner />

			<!-- ======================================================
			     USAGE
			     ====================================================== -->
			<section class="section section-dark" aria-labelledby="usage-heading">
				<div class="container">
					<div class="section-header-flex section-header-dark">
						<div>
							<span class="eyebrow eyebrow-light">Sectors</span>
							<h2 id="usage-heading" class="section-title section-title-light">Where we work.</h2>
						</div>
						<div class="carousel-ctrl-sm ctrl-dark" role="group" aria-label="Sectors navigation">
							<button type="button" class="ctrl-arrow-btn" id="usage-prev-btn" aria-label="Previous">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
							</button>
							<button type="button" class="ctrl-arrow-btn" id="usage-next-btn" aria-label="Next">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
							</button>
						</div>
					</div>

					<div class="usage-carousel-rail" id="usage-carousel-rail">
						<div class="usage-track">
							{[
								{ icon: 'home', title: 'Home & Office', desc: 'Compact RO for staff and customers.' },
								{ icon: 'hotel', title: 'Hotels & Restaurants', desc: 'Softeners and high-volume RO.' },
								{ icon: 'building', title: 'Societies & Villages', desc: 'Community RO for scale-free water.' },
								{ icon: 'hospital', title: 'Hospitals & Pharma', desc: 'DM and ultra-filtered RO.' },
								{ icon: 'factory', title: 'Factories', desc: 'Industrial RO, softening, ETP.' },
								{ icon: 'graduation', title: 'Campus & Hostels', desc: 'Packaging plants and STP.' },
							].map(({ icon, title, desc }) => (
								<article class="card card-dark">
									<div class="usage-icon" set:html={icons[icon]} />
									<h3>{title}</h3>
									<p>{desc}</p>
								</article>
							))}
						</div>
					</div>

					<div class="usage-dots-row" id="usage-dots" role="tablist" aria-label="Sector slides">
						{Array.from({ length: 6 }).map((_, i) => (
							<button type="button" class={`usage-dot${i === 0 ? ' active' : ''}`} data-idx={i} aria-label={`Slide ${i + 1}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} />
						))}
					</div>
				</div>
			</section>

			<!-- ======================================================
			     WHY US
			     ====================================================== -->
			<section class="section" aria-labelledby="why-heading">
				<div class="container">
					<div class="section-title-wrap-centered">
						<span class="eyebrow">Why us</span>
						<h2 id="why-heading" class="section-title">Four reasons to choose us.</h2>
					</div>

					<div class="why-grid">
						{[
							{ icon: 'handshake', title: 'Transparent dealings', desc: 'Clear specs, genuine brands, upfront pricing.' },
							{ icon: 'rupee', title: 'Factory-direct prices', desc: 'No middlemen markups.' },
							{ icon: 'gear', title: 'Full customization', desc: 'Sized to your raw-water report.' },
							{ icon: 'wrench', title: 'After-sales & AMC', desc: 'Local technicians across Gujarat.' },
						].map(({ icon, title, desc }) => (
							<div class="why-box">
								<div class="why-icon" set:html={icons[icon]} />
								<div>
									<h4>{title}</h4>
									<p>{desc}</p>
								</div>
							</div>
						))}
					</div>

					<div class="team-card">
						<span class="eyebrow">Our team</span>
						<h3>Multidisciplinary engineering.</h3>
						<ul class="team-list" role="list">
							<li><strong>Mechanical Engineers</strong> — skid and P&amp;ID design</li>
							<li><strong>Process Chemists</strong> — water analysis and chemical formulation</li>
							<li><strong>Quality Inspectors</strong> — hydrostatic and electrical testing</li>
							<li><strong>Field Technicians</strong> — SS welding, piping, commissioning</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- ======================================================
			     BLOG
			     ====================================================== -->
			<section class="section section-alt" aria-labelledby="blog-heading">
