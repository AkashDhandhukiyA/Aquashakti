			.role-pill {
				background: var(--surface-alt);
				padding: 0.75rem 1rem;
				border-radius: var(--radius-md);
				font-size: 0.88rem;
				color: var(--ink-700);
				border: 1px solid var(--line-200);
			}
			:global(html.dark) .role-pill { background: #152238; color: var(--line-200); border-color: rgba(255,255,255,0.1); }

			.mission-box {
				background: #f0f9ff;
				border-left: 4px solid var(--brand-500);
				padding: 1.25rem;
				border-radius: 0 var(--radius-md) var(--radius-md) 0;
				margin-top: 1.5rem;
			}
			.mission-box h4 { color: var(--ink-900); margin-bottom: 0.4rem; font-size: 1rem; }
			.mission-box p { font-style: italic; font-size: 0.88rem; color: #0369a1; margin: 0; }
			:global(html.dark) .mission-box { background: #111e38; border-left-color: var(--brand-400); }
			:global(html.dark) .mission-box h4 { color: #f8fafc; }
			:global(html.dark) .mission-box p { color: var(--brand-400); }

			/* ==========================================================
			   BLOG CARDS
			   ========================================================== */
			.post-card { padding: 0; overflow: hidden; }
			.post-thumb-link { display: block; position: relative; aspect-ratio: 16 / 10; overflow: hidden; }
			.post-thumb-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s var(--ease); }
			.post-card:hover .post-thumb-img { transform: scale(1.05); }

			.post-category-tag {
				position: absolute;
				bottom: 0.75rem;
				left: 0.75rem;
				background: rgba(15,23,42,0.85);
				color: #fff;
				font-size: 0.72rem;
				font-weight: 700;
				padding: 0.2rem 0.6rem;
				border-radius: 4px;
				text-transform: uppercase;
			}

			.post-body { padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; }
			.post-date-row { font-size: 0.8rem; color: var(--ink-400); display: flex; gap: 0.4rem; margin-bottom: 0.5rem; }
			.post-body h4 { font-size: 1.15rem; line-height: 1.35; margin-bottom: 0.5rem; }
			.post-body h4 a { color: var(--ink-900); text-decoration: none; }
			.post-body h4 a:hover { color: var(--brand-500); }
			:global(html.dark) .post-body h4 a { color: #f8fafc; }

			.post-summary { font-size: 0.88rem; color: var(--ink-400); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1; }
			:global(html.dark) .post-summary { color: var(--ink-300); }

			.read-post-btn { font-weight: 700; font-size: 0.85rem; color: var(--brand-500); }
			:global(html.dark) .read-post-btn { color: var(--brand-400); }

			.view-all-cta { text-align: center; margin-top: 3.5rem; }

			/* ==========================================================
			   RESPONSIVE
			   ========================================================== */
			@media (max-width: 990px) {
				.turnkey-track,
				.usage-track,
				.blog-track {
					display: flex;
					gap: 1.25rem;
					width: max-content;
					padding: 0 0.25rem;
				}
				.turnkey-track .turnkey-card { flex: 0 0 min(380px, 86vw); width: min(380px, 86vw); scroll-snap-align: start; }
				.usage-track .card-dark { flex: 0 0 min(310px, 82vw); width: min(310px, 82vw); scroll-snap-align: start; }
				.blog-track .post-card { flex: 0 0 min(330px, 84vw); width: min(330px, 84vw); scroll-snap-align: start; }

				.turnkey-carousel-rail,
				.usage-carousel-rail,
				.blog-carousel-rail { scroll-snap-type: x mandatory; }

				.usage-dots-row,
				.blog-dots-row { display: flex; }
			}

			@media (max-width: 960px) {
				.hero-section {
					height: auto !important;
					min-height: auto !important;
					padding: 5.8rem 0 3.5rem !important;
					overflow: visible !important;
					background-position: center right 20%;
				}
				.hero-container { grid-template-columns: 1fr; gap: 2.25rem; margin: 0; }
				.profile-grid { grid-template-columns: 1fr; }
				.experience-badge { position: static; margin-top: 1rem; }
			}

			@media (max-width: 640px) {
				.hero-section { padding: 5.25rem 0 3rem !important; }
				.hero-badge { padding: 0.25rem 0.6rem; font-size: 0.68rem; }
				.hero-title { font-size: clamp(1.85rem, 7.5vw, 2.5rem); line-height: 1.18; }
				.hero-subtitle { font-size: 0.88rem; margin-bottom: 1.1rem; }
				.hero-cta-group { flex-direction: column; align-items: stretch; gap: 0.75rem; }
				.btn-hero-primary,
				.btn-hero-secondary { width: 100%; justify-content: center; text-align: center; padding: 0.75rem 1.25rem; }
				.hero-stats-strip { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.1rem 0.85rem; }
				.stat-label { white-space: normal; line-height: 1.2; }
				.stat-divider { display: none; }
				.calculator-card { padding: 0.9rem 0.85rem; border-radius: 18px; }
				.calc-title { font-size: 1.05rem; }
				.hero-water-splash { display: none; }
				.why-grid { gap: 2rem; }
				.why-box { gap: 0.85rem; }
				.team-card { padding: 1.5rem 1.25rem; }
				.view-all-cta { margin-top: 2rem; }
				.btn-calc-submit { white-space: normal; text-align: center; }
			}

			@media (max-width: 400px) {
				.hero-section { padding: 4.8rem 0 2rem !important; }
				.hero-badge { padding: 0.22rem 0.5rem; font-size: 0.62rem; }
				.stat-num { font-size: 1.05rem; }
				.stat-label { font-size: 0.58rem; }
				.calculator-card { padding: 0.85rem 0.75rem; }
				.btn-calc-submit { font-size: 0.82rem; padding: 0.65rem 0.85rem; }
			}

			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
					scroll-behavior: auto !important;
				}
			}
		</style>

		<!-- ============================================================
		     JAVASCRIPT — IDENTICAL TO ORIGINAL (no logic changes)
		     ============================================================ -->
		<script is:inline>
			function calculatePlant() {
				const industry = document.getElementById('calc-industry').value;
				const usage = parseInt(document.getElementById('calc-usage').value, 10);
				const modelEl = document.getElementById('result-model-name');
				const specsEl = document.getElementById('result-specs-text');
				const quoteBtn = document.getElementById('calc-quote-btn');

				let model = '';
				let specs = '';

				if (industry === 'waste') {
					if (usage <= 5000) {
						model = '5 KLD Compact Package STP / ETP';
						specs = 'MBBR / DELTA biological treatment, skid-mounted clarifier, automated air blower.';
					} else if (usage <= 25000) {
						model = '25 KLD Turnkey ETP / STP Plant';
						specs = 'Bar screen, Equalization, Flash mixer, Clariflocculator, Sludge filter press.';
					} else {
						model = '50 KLD to 100+ KLD Industrial ETP Facility';
						specs = 'Full civil and mechanical skid, BOD/COD removal, zero liquid discharge compliant.';
					}
				} else if (industry === 'pharma') {
					if (usage <= 2000) {
						model = '250 LPH Two-Bed DM Plant (Cation + Anion)';
						specs = 'Very low conductivity (<10 µS/cm), chloride-free, semi-automatic multiport valve.';
					} else {
						model = 'Mix Bed D.M 100 / D.M 200 System (1000 - 2000 L/hr)';
						specs = 'Ultra-pure water (<0.5 µS/cm), mixed resin bed, SS 304 skid for pharma & lab formulations.';
					}
				} else {
					if (usage <= 500) {
						model = '50 LPH Commercial RO Plant (SS 304)';
						specs = 'Compact frame, 20" jumbo pre-filter, booster pump, ideal for 50-100 people.';
					} else if (usage <= 2000) {
						model = '250 LPH Commercial RO Plant';
						specs = '1.0 HP vertical multistage pump, FRP vessel, 4040 membrane, auto-flush.';
					} else if (usage <= 5000) {
						model = '500 LPH Commercial RO Plant (SS 304 Frame)';
						specs = '1.5 HP vertical pump, dual FRP vessels, rota meters, UV disinfection chamber.';
					} else if (usage <= 10000) {
						model = '1,000 LPH Commercial / Industrial RO Plant';
						specs = '2.0 HP vertical pump, 4x 4040 membranes, automated control panel, 5-micron jumbo.';
					} else if (usage <= 25000) {
						model = '2,500 LPH Industrial RO Skid';
						specs = 'SS 304 skid, 8040 industrial membranes, automated antiscalant dosing, telemetry.';
					} else {
						model = '5,000 to 20,000+ LPH Custom Industrial RO Plant';
						specs = 'Turnkey engineering for high-TDS borewell or seawater desalination with CIP skid.';
					}
				}

				modelEl.textContent = model;
				specsEl.textContent = specs;
				quoteBtn.setAttribute('data-plant', model);
				quoteBtn.setAttribute('data-capacity', usage + ' LPD');
			}

			window.calculatePlant = calculatePlant;

			const liquidSlider = document.getElementById('aqua-liquid-slider');
			liquidSlider?.addEventListener('liquid-slider-change', (e) => {
				const val = e.detail?.value;
				const usageSelect = document.getElementById('calc-usage');
				if (usageSelect && val) {
					usageSelect.value = String(val);
					calculatePlant();
				}
			});

			function initMiniCarousel(railId, prevBtnId, nextBtnId, dotsContainerId, cardSelector) {
				const rail = document.getElementById(railId);
				if (!rail) return;
				const prevBtn = document.getElementById(prevBtnId);
				const nextBtn = document.getElementById(nextBtnId);
				const dotsContainer = document.getElementById(dotsContainerId);
				const dots = dotsContainer ? Array.from(dotsContainer.querySelectorAll('button, span')) : [];
				const cards = Array.from(rail.querySelectorAll(cardSelector));

				function getStep() {
					if (cards[0]) {
						return cards[0].offsetWidth + 20;
					}
					return 320;
				}

				prevBtn?.addEventListener('click', () => {
					rail.scrollBy({ left: -getStep(), behavior: 'smooth' });
				});

				nextBtn?.addEventListener('click', () => {
					rail.scrollBy({ left: getStep(), behavior: 'smooth' });
				});

				dots.forEach((dot, idx) => {
					dot.addEventListener('click', () => {
						rail.scrollTo({ left: idx * getStep(), behavior: 'smooth' });
					});
				});

				if (dots.length) {
					rail.addEventListener('scroll', () => {
						const idx = Math.min(dots.length - 1, Math.max(0, Math.round(rail.scrollLeft / getStep())));
						dots.forEach((d, i) => {
							if (i === idx) d.classList.add('active');
							else d.classList.remove('active');
						});
					}, { passive: true });
				}
			}

			function initAllMiniCarousels() {
				initMiniCarousel('turnkey-carousel-rail', 'turnkey-prev-btn', 'turnkey-next-btn', null, '.turnkey-card');
				initMiniCarousel('usage-carousel-rail', 'usage-prev-btn', 'usage-next-btn', 'usage-dots', '.card-dark');
				initMiniCarousel('blog-carousel-rail', 'blog-prev-btn', 'blog-next-btn', 'blog-dots', '.post-card');
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initAllMiniCarousels);
			} else {
				initAllMiniCarousels();
			}
			document.addEventListener('astro:page-load', initAllMiniCarousels);
		</script>
	</body>
</html>
