---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import QuoteModal from '../components/QuoteModal.astro';
import ClientsBanner from '../components/ClientsBanner.astro';
import LiquidSlider from '../components/LiquidSlider.astro';
import ProductCarousel from '../components/ProductCarousel.astro';
import {
	COMPANY_NAME,
	COMPANY_TAGLINE,
	SITE_DESCRIPTION,
	SITE_TITLE,
	COMPANY_PHONE,
	COMPANY_EMAIL,
} from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const usageSectors = [
	{ icon: 'store', title: 'Home, Office & Showroom', desc: 'Hygienic commercial RO for staff and walk-in customers.' },
	{ icon: 'hotel', title: 'Hotels, Restaurants & Resorts', desc: 'Softeners and high-volume RO for spotless laundry and safe drinking water.' },
	{ icon: 'building-2', title: 'Apartment Societies & Villages', desc: 'Centralized community RO removing scale from municipal or high-TDS borewell water.' },
	{ icon: 'stethoscope', title: 'Hospitals, Clinics & Pharma', desc: 'High-purity DM plants and ultra-filtered RO for dialysis, labs and formulations.' },
	{ icon: 'factory', title: 'Factories & Industries', desc: 'Industrial RO skids, boiler-feed softening, cooling-tower treatment and ZLD ETP plants.' },
	{ icon: 'graduation-cap', title: 'Universities & Hostels', desc: 'Drinking-water packaging plants and campus STP for landscaping reuse.' },
];

const advantages = [
	{ icon: 'handshake', title: 'Transparent Dealings', desc: 'Clear specs, genuine component brands, upfront pricing.' },
	{ icon: 'indian-rupee', title: 'Factory-Direct Prices', desc: 'Direct manufacturer rates — no middlemen markups.' },
	{ icon: 'settings-2', title: 'Full Customization', desc: 'Every plant sized to your raw-water report (TDS, hardness, BOD/COD).' },
	{ icon: 'wrench', title: 'After-Sales & AMC', desc: 'Local technicians across Gujarat for rapid preventive maintenance.' },
];

const roModels = [
	['Aqua-25', '25 LPH', '1 × 75 GPD / 100 GPD', 'Booster Diaphragm', '10" Spun + Carbon Block', 'Compact, auto cut-off', '25 LPH RO Plant'],
	['Aqua-50', '50 LPH', '2 × 100 GPD / 1 × 4021', 'Heavy Booster', '20" Spun Pre-Filter', 'SS 304 frame, dual TDS', '50 LPH RO Plant'],
	['Aqua-100', '100 LPH', '2 × 4021 / 1 × 4040', 'Vertical MS (0.5 HP)', '20" Jumbo Cartridge', 'SS skid, flow meter, gauge', '100 LPH RO Plant'],
	['Aqua-250', '250 LPH', '1 × 4040 Import TFC', 'Vertical MS (1.0 HP)', 'FRP Sand + 5-Micron', 'Auto-flush, LP switch, rota meter', '250 LPH RO Plant'],
	['Aqua-500', '500 LPH', '2 × 4040 High Rejection', 'Vertical MS (1.5 HP)', 'FRP Dual Media (Sand+Carbon)', 'SS panel, UV, chemical dosing', '500 LPH RO Plant'],
	['Aqua-1000', '1,000 LPH', '4 × 4040 / 1 × 8040', 'Vertical MS (2.0–3.0 HP)', 'Dual FRP Vessels + Cartridge', 'SS 304 skid, telemetry, auto-backwash', '1000 LPH RO Plant'],
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/images/hero-plant.jpg" />
	</head>
	<body>
		<main id="main-content">
			<!-- ============================================================
			     HERO
			     ============================================================ -->
			<section class="hero-section" aria-labelledby="hero-heading">
				<Header />

				<div class="container hero-container">
					<div class="hero-content">
						<div class="hero-badges">
							<span class="hero-badge">
								<Icon name="lucide:badge-check" size={14} class="badge-icon-green" />
								<span>ISO 9001:2008 Certified</span>
							</span>
							<span class="hero-badge">
								<svg class="badge-flag" viewBox="0 0 24 16" width="18" height="12" aria-hidden="true">
									<rect width="24" height="5.33" fill="#FF9933"/>
									<rect y="5.33" width="24" height="5.33" fill="#FFFFFF"/>
									<rect y="10.66" width="24" height="5.34" fill="#138808"/>
									<circle cx="12" cy="8" r="2.2" fill="none" stroke="#000080" stroke-width="0.5"/>
									<circle cx="12" cy="8" r="0.5" fill="#000080"/>
								</svg>
								<span>Make in India</span>
							</span>
						</div>

						<h1 id="hero-heading" class="hero-title">
							Ideal Solution for<br />
							<span class="highlight-blue">All Types of Water</span>
						</h1>

						<p class="hero-subtitle">
							Aqua Shakti Industries — turnkey manufacturer of Industrial RO, Commercial RO, Water Softeners, DM Plants, ETP &amp; STP systems. Based in Vapi, Gujarat since 2007.
						</p>

						<div class="hero-cta-group">
							<button
								type="button"
								class="btn-hero-primary"
								data-quote-trigger
								data-plant="Complete Plant Requirement"
							>
								<Icon name="lucide:file-text" size={16} />
								<span>Get Free Plant Sizing &amp; Quote</span>
								<Icon name="lucide:arrow-right" size={16} class="arrow-icon" />
							</button>
							<a href="/products" class="btn-hero-secondary">
								<span>Explore Product Profile</span>
								<Icon name="lucide:arrow-right" size={16} class="arrow-icon" />
							</a>
						</div>

						<div class="hero-stats-strip">
							<div class="stat-item">
								<div class="stat-icon-wrap"><Icon name="lucide:users" size={22} /></div>
								<div class="stat-text-wrap">
									<span class="stat-num">500+</span>
									<span class="stat-label">Clients across Gujarat</span>
								</div>
							</div>
							<div class="stat-divider" aria-hidden="true"></div>
							<div class="stat-item">
								<div class="stat-icon-wrap"><Icon name="lucide:calendar-check" size={22} /></div>
								<div class="stat-text-wrap">
									<span class="stat-num">18+</span>
									<span class="stat-label">Years of Excellence</span>
								</div>
							</div>
							<div class="stat-divider" aria-hidden="true"></div>
							<div class="stat-item">
								<div class="stat-icon-wrap"><Icon name="lucide:gauge" size={22} /></div>
								<div class="stat-text-wrap">
									<span class="stat-num">25–50k</span>
									<span class="stat-label">LPH Capacity Range</span>
								</div>
							</div>
							<div class="stat-divider" aria-hidden="true"></div>
							<div class="stat-item">
								<div class="stat-icon-wrap"><Icon name="lucide:shield-check" size={22} /></div>
								<div class="stat-text-wrap">
									<span class="stat-num">100%</span>
									<span class="stat-label">Turnkey Commissioning</span>
								</div>
							</div>
						</div>
					</div>

					<!-- Estimator card (logic unchanged) -->
					<div class="hero-card-column">
						<div class="calculator-card">
							<div class="calculator-header">
								<span class="calc-tag">
									<Icon name="lucide:sliders-horizontal" size={11} />
									<span>Interactive Sizing Tool</span>
								</span>
								<h3 class="calc-title">Instant Plant Capacity Estimator</h3>
							</div>

							<form id="hero-calc-form" onsubmit="event.preventDefault(); calculatePlant();">
								<div class="calc-field-group">
									<label class="calc-label" for="calc-industry">
										<Icon name="lucide:building-2" size={13} class="field-icon" />
										<span>Industry / Application Sector</span>
									</label>
									<div class="select-wrapper">
										<select id="calc-industry" class="calc-select" onchange="calculatePlant()">
											<option value="factory" selected>Industrial Factory / Manufacturing</option>
											<option value="pharma">Pharmaceuticals &amp; Labs (DM Water)</option>
											<option value="hotel">Hotel, Restaurant &amp; Resort</option>
											<option value="residential">Apartment Society / Residential</option>
											<option value="hospital">Hospital &amp; Clinic</option>
											<option value="school">School / University / Hostel</option>
											<option value="waste">Effluent / Sewage Treatment (ETP/STP)</option>
										</select>
										<Icon name="lucide:chevron-down" size={13} class="select-chevron" />
									</div>
								</div>

								<LiquidSlider defaultValue={10000} id="aqua-liquid-slider" />

								<select id="calc-usage" style="display: none;" onchange="calculatePlant()">
									<option value="500">500</option>
									<option value="2000">2000</option>
									<option value="5000">5000</option>
									<option value="10000" selected>10000</option>
									<option value="25000">25000</option>
									<option value="50000">50000</option>
								</select>

								<div class="calc-result-box" id="calc-result" aria-live="polite">
									<div class="result-check-badge"><Icon name="lucide:check" size={12} /></div>
									<div class="result-info-col">
										<div class="result-label">Recommended System</div>
										<div class="result-model" id="result-model-name">1,000 LPH Commercial RO Plant (SS 304)</div>
										<div class="result-specs" id="result-specs-text">
											Vertical multistage pump, dual FRP vessels, auto-flush, imported membrane.
										</div>
									</div>
								</div>

								<button
									type="button"
									class="btn-calc-submit"
									id="calc-quote-btn"
									data-quote-trigger
									data-plant="1,000 LPH Commercial RO Plant (SS 304)"
								>
									<Icon name="lucide:file-text" size={15} />
									<span>Get Exact Pricing for This Model</span>
									<Icon name="lucide:arrow-right" size={15} />
								</button>
							</form>
						</div>
					</div>
				</div>

				<div class="hero-water-splash" aria-hidden="true">
					<img src="/images/water-wave-splash.jpg" alt="" class="splash-graphic-img" />
				</div>
			</section>

			<!-- ============================================================
			     ABOUT
			     ============================================================ -->
			<section class="section company-overview-section" id="about" aria-labelledby="about-heading">
				<div class="container">
					<div class="section-title-wrap-centered">
						<div class="eyebrow-dashes">
							<span class="dash-rule" aria-hidden="true"></span>
							<span class="eyebrow-text">About Aqua Shakti Industries</span>
							<span class="dash-rule" aria-hidden="true"></span>
						</div>
						<h2 id="about-heading" class="title-trusted-partner">Your Trusted Partner in Water Solutions</h2>
						<p class="subtitle-trusted-partner">
							We design, manufacture and supply high-quality water treatment plants and chemicals for a cleaner, safer tomorrow.
						</p>
					</div>

					<div class="grid-2 profile-grid">
						<div class="profile-image-col">
							<div class="image-stack">
								<img src="/images/hero-plant.jpg" alt="Aqua Shakti Industrial Reverse Osmosis Skid" class="main-profile-img" loading="lazy" />
								<div class="experience-badge float-anim">
									<span class="badge-num">18+</span>
									<span class="badge-text">Years Industrial Track Record</span>
								</div>
							</div>
						</div>

						<div class="profile-text-col">
							<h3 class="profile-lead-title">Engineering Pure Water &amp; Wastewater Systems Since 2007</h3>
							<p>
								Based in <strong>Vapi, Valsad (Gujarat)</strong>, we are an <strong>ISO 9001:2008 certified turnkey manufacturer</strong> specializing in custom Reverse Osmosis Plants, Softeners, DM Units and Zero Liquid Discharge (ZLD) ETP/STP systems.
							</p>
							<p>
								With <strong>500+ industrial installations</strong> across Gujarat and western India, our engineers deliver robust SS skids, fast installation and preventive maintenance.
							</p>

							<ul class="profile-features-list" role="list">
								<li class="feature-item">
									<span class="feature-icon" aria-hidden="true">✓</span>
									<div>
										<strong>ISO 9001:2008 Certified</strong>
										<span>Quality inspection from fabrication to commissioning</span>
									</div>
								</li>
								<li class="feature-item">
									<span class="feature-icon" aria-hidden="true">✓</span>
									<div>
										<strong>GPCB &amp; CPCB Compliant</strong>
										<span>Engineered to industrial pollution-control discharge limits</span>
									</div>
								</li>
								<li class="feature-item">
									<span class="feature-icon" aria-hidden="true">✓</span>
									<div>
										<strong>Turnkey Spares &amp; Chemicals</strong>
										<span>Membranes, resins, antiscalants and multiport valves in stock</span>
									</div>
								</li>
							</ul>

							<div class="profile-cta">
								<a href="/about" class="btn btn-secondary">Read Full Company Profile →</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<ProductCarousel />

			<!-- ============================================================
			     COMMERCIAL RO TABLE
			     ============================================================ -->
			<section class="section" aria-labelledby="commercial-heading">
				<div class="container">
					<div class="section-header">
						<span class="section-tag">Commercial Models</span>
						<h2 id="commercial-heading">Aqua Shakti Commercial RO Lineup</h2>
						<p class="section-subtitle">
							Grade 304 Stainless Steel, import membranes, vertical multistage pumps.
						</p>
					</div>

					<div class="spec-table-wrapper" role="region" aria-label="RO model specifications" tabindex="0">
						<table class="spec-table">
							<thead>
								<tr>
									<th scope="col">Model</th>
									<th scope="col">Capacity</th>
									<th scope="col">Membrane</th>
									<th scope="col">HP Pump</th>
									<th scope="col">Pre-Filter</th>
									<th scope="col">Features</th>
									<th scope="col">Action</th>
								</tr>
							</thead>
							<tbody>
								{roModels.map(([model, cap, membrane, pump, pre, features, plant]) => (
									<tr>
										<td><strong>{model}</strong></td>
										<td>{cap}</td>
										<td>{membrane}</td>
										<td>{pump}</td>
										<td>{pre}</td>
										<td>{features}</td>
										<td>
											<button class="btn btn-primary btn-sm" data-quote-trigger data-plant={plant}>Enquire</button>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</div>
			</section>

			<!-- ============================================================
			     TURNKEY SHOWCASE
			     ============================================================ -->
			<section class="section section-alt" aria-labelledby="turnkey-heading">
				<div class="container">
					<div class="section-header-flex">
						<div>
							<span class="section-tag">Turnkey Highlights</span>
							<h2 id="turnkey-heading">Clarification &amp; Boiler Systems</h2>
							<p class="section-subtitle">Heavy-duty skid package units for continuous industrial operations.</p>
						</div>
						<div class="carousel-ctrl-sm" role="group" aria-label="Turnkey navigation">
							<button type="button" class="ctrl-arrow-btn" id="turnkey-prev-btn" aria-label="Previous system">
								<Icon name="lucide:chevron-left" size={15} />
							</button>
							<button type="button" class="ctrl-arrow-btn" id="turnkey-next-btn" aria-label="Next system">
								<Icon name="lucide:chevron-right" size={15} />
							</button>
						</div>
					</div>

					<div class="turnkey-carousel-rail" id="turnkey-carousel-rail">
						<div class="turnkey-track">
							<article class="card card-hover turnkey-card">
								<div class="turnkey-img-wrap">
									<img src="/images/secondary-settling-plant.jpg" alt="Secondary Settling Tank" loading="lazy" />
									<span class="badge badge-teal">Skid-Mounted</span>
								</div>
								<div class="turnkey-body">
									<span class="section-tag turnkey-tag">Clarification &amp; Filtration</span>
									<h3>Secondary Settling Tank</h3>
									<p class="turnkey-desc">
										Hopper-bottom conical tank, multi-media filter column, chemical dosing drum and automated panel for industrial wastewater clarification.
									</p>
									<div class="turnkey-actions">
										<button class="btn btn-primary btn-sm" data-quote-trigger data-plant="Secondary Settling Tank Plant">
											Get Quote →
										</button>
										<a href="/products#settling-plants" class="spec-link">Detailed Specs</a>
									</div>
								</div>
							</article>

							<article class="card card-hover turnkey-card">
								<div class="turnkey-img-wrap">
									<img src="/images/boiler-plant.jpg" alt="Industrial Boiler Plant" loading="lazy" />
									<span class="badge badge-blue">Thermal</span>
								</div>
								<div class="turnkey-body">
									<span class="section-tag turnkey-tag">High-Efficiency Steam</span>
									<h3>Industrial Boiler Plants</h3>
									<p class="turnkey-desc">
										Super Economizer, step-fired multi-fuel burners (gas, propane, biogas, oil), rapid start-up and fuel savings for continuous production.
									</p>
									<div class="turnkey-actions">
										<button class="btn btn-primary btn-sm" data-quote-trigger data-plant="Industrial Boiler Plant">
											Get Quote →
										</button>
										<a href="/products#boiler-plant" class="spec-link">Detailed Specs</a>
									</div>
								</div>
							</article>
						</div>
					</div>
				</div>
			</section>

			<ClientsBanner />

			<!-- ============================================================
			     AREAS OF USAGE
			     ============================================================ -->
			<section class="section section-dark" aria-labelledby="usage-heading">
				<div class="container">
					<div class="section-header-flex">
						<div>
							<span class="section-tag section-tag-dark">Versatile Deployment</span>
							<h2 id="usage-heading">Areas of Usage &amp; Sectors</h2>
							<p class="section-subtitle section-subtitle-dark">
								Custom-engineered plants tailored to your exact feed-water conditions.
							</p>
						</div>
						<div class="carousel-ctrl-sm ctrl-dark" role="group" aria-label="Sector navigation">
							<button type="button" class="ctrl-arrow-btn" id="usage-prev-btn" aria-label="Previous sector">
								<Icon name="lucide:chevron-left" size={15} />
							</button>
							<button type="button" class="ctrl-arrow-btn" id="usage-next-btn" aria-label="Next sector">
								<Icon name="lucide:chevron-right" size={15} />
							</button>
						</div>
					</div>

					<div class="usage-carousel-rail" id="usage-carousel-rail">
						<div class="usage-track">
							{usageSectors.map(({ icon, title, desc }) => (
								<article class="card card-dark">
									<div class="usage-icon"><Icon name={`lucide:${icon}`} size={28} /></div>
									<h3>{title}</h3>
									<p>{desc}</p>
								</article>
							))}
						</div>
					</div>

					<div class="usage-dots-row" id="usage-dots" role="tablist" aria-label="Sector slides">
						{Array.from({ length: 6 }).map((_, i) => (
							<button
								type="button"
								class={`usage-dot${i === 0 ? ' active' : ''}`}
								data-idx={i}
								aria-label={`Slide ${i + 1}`}
								role="tab"
								aria-selected={i === 0 ? 'true' : 'false'}
							/>
						))}
					</div>
				</div>
			</section>

			<!-- ============================================================
			     WHY CHOOSE US + TEAM
			     ============================================================ -->
			<section class="section" aria-labelledby="why-heading">
				<div class="container">
					<div class="grid-2 why-grid">
						<div>
							<span class="section-tag">Competitive Advantages</span>
							<h2 id="why-heading">Why Choose Aqua Shakti?</h2>
							<p>
								Innovative thinking, customer-centric solutions and continuous value creation.
							</p>

							<div class="why-us-items">
								{advantages.map(({ icon, title, desc }) => (
									<div class="why-box">
										<div class="why-icon"><Icon name={`lucide:${icon}`} size={22} /></div>
										<div>
											<h4>{title}</h4>
											<p>{desc}</p>
										</div>
									</div>
								))}
							</div>
						</div>

						<div class="card card-glass team-card">
							<span class="badge badge-teal">Our Team</span>
							<h3>Experienced Engineering</h3>
							<p>
								A multidisciplinary team studying each industry's water requirements to deliver the right solution.
							</p>

							<ul class="team-roles-list" role="list">
								<li class="role-pill"><strong>Mechanical Engineers</strong> — High-pressure skid and P&amp;ID design</li>
								<li class="role-pill"><strong>Process Chemists &amp; R&amp;D</strong> — Raw-water titration, resin capacity, chemical formulations</li>
								<li class="role-pill"><strong>Quality Inspectors</strong> — Hydrostatic vessel testing and electrical checks</li>
								<li class="role-pill"><strong>Field Technicians</strong> — Precision SS welding, piping erection, site commissioning</li>
							</ul>

							<div class="mission-box">
								<h4>Our Mission</h4>
								<p>
									"Clear market focus, customer-centric solutions and continuous operational improvement — creating lasting value for every client."
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ============================================================
			     BLOG
			     ============================================================ -->
			<section class="section section-alt" aria-labelledby="blog-heading">
				<div class="container">
					<div class="section-header-flex">
						<div>
							<span class="section-tag">Knowledge Sharing</span>
							<h2 id="blog-heading">Latest Technical Insights</h2>
							<p class="section-subtitle">
								Engineering guides on RO sizing, softening chemistry and GPCB wastewater compliance.
							</p>
						</div>
						<div class="carousel-ctrl-sm" role="group" aria-label="Blog navigation">
							<button type="button" class="ctrl-arrow-btn" id="blog-prev-btn" aria-label="Previous post">
								<Icon name="lucide:chevron-left" size={15} />
							</button>
							<button type="button" class="ctrl-arrow-btn" id="blog-next-btn" aria-label="Next post">
								<Icon name="lucide:chevron-right" size={15} />
							</button>
						</div>
					</div>

					<div class="blog-carousel-rail" id="blog-carousel-rail">
						<div class="blog-track">
							{recentPosts.map((post) => (
								<article class="card card-hover post-card">
									<a href={`/blog/${post.id}/`} class="post-thumb-link">
										<img
											src={post.data.heroImage || '/images/hero-plant.jpg'}
											alt={post.data.title}
											class="post-thumb-img"
											loading="lazy"
										/>
										<span class="post-category-tag">{post.data.category}</span>
									</a>
									<div class="post-body">
										<div class="post-date-row">
											<span>{post.data.readingTime}</span>
											<span aria-hidden="true">·</span>
											<FormattedDate date={post.data.pubDate} />
										</div>
										<h4><a href={`/blog/${post.id}/`}>{post.data.title}</a></h4>
										<p class="post-summary">{post.data.description}</p>
										<a href={`/blog/${post.id}/`} class="read-post-btn">Read Article →</a>
									</div>
								</article>
							))}
						</div>
					</div>

