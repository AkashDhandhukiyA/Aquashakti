---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import QuoteModal from '../components/QuoteModal.astro';
import ClientsBanner from '../components/ClientsBanner.astro';
import LiquidSlider from '../components/LiquidSlider.astro';
import ProductCarousel from '../components/ProductCarousel.astro';
import {
	COMPANY_NAME,
	COMPANY_TAGLINE,
	SITE_DESCRIPTION,
	SITE_TITLE,
	COMPANY_PHONE,
	COMPANY_EMAIL,
} from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

/* Inline SVG icon set — no emojis */
const icons = {
	factory: `<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 21h20"/><path d="M4 21V10l5-3v14"/><path d="M9 21V7l6-4v18"/><path d="M15 21V11l5-2v12"/></svg>`,
	hotel: `<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 9h6v4H9z"/><path d="M9 17h6"/></svg>`,
	home: `<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/></svg>`,
	hospital: `<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><path d="M12 9v6M9 12h6"/></svg>`,
	building: `<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16"/><path d="M15 21V9h4v12"/><path d="M9 7h.01M9 11h.01M9 15h.01"/></svg>`,
	graduation: `<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1 2.5 3 6 3s6-2 6-3v-5"/><path d="M22 10v6"/></svg>`,
	handshake: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg>`,
	rupee: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12"/><path d="M6 8h12"/><path d="m6 13 8.5 8"/><path d="M6 13h3"/><path d="M9 13c6.667 0 6.667-10 0-10"/></svg>`,
	gear: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>`,
	wrench: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/images/hero-plant.jpg" />
	</head>
	<body>
		<main id="main-content">
			<!-- ======================================================
			     HERO
			     ====================================================== -->
			<section class="hero-section" aria-labelledby="hero-heading">
				<Header />

				<div class="container hero-container">
					<div class="hero-content">
						<div class="hero-badges">
							<span class="hero-badge badge-iso">
								<svg class="badge-icon icon-green" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
								<span>ISO 9001:2008 CERTIFIED</span>
							</span>
							<span class="hero-badge badge-flag">
								<svg class="badge-flag-svg" viewBox="0 0 24 16" width="18" height="12" aria-hidden="true">
									<rect width="24" height="5.33" fill="#FF9933"/>
									<rect y="5.33" width="24" height="5.33" fill="#FFFFFF"/>
									<rect y="10.66" width="24" height="5.34" fill="#138808"/>
									<circle cx="12" cy="8" r="2.2" fill="none" stroke="#000080" stroke-width="0.5"/>
									<circle cx="12" cy="8" r="0.5" fill="#000080"/>
								</svg>
								<span>MAKE IN INDIA</span>
							</span>
						</div>

						<h1 id="hero-heading" class="hero-title">
							Ideal Solution for<br />
							<span class="highlight-blue">All Types of Water</span>
						</h1>

						<p class="hero-subtitle">
							Aqua Shakti Industries — ISO-certified manufacturer of Industrial RO, DM, Softener, ETP &amp; STP plants in Vapi, Gujarat since 2007.
						</p>

						<div class="hero-cta-group">
							<button type="button" class="btn-hero-primary" data-quote-trigger data-plant="Complete Plant Requirement">
								<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
								<span>Get Free Plant Sizing &amp; Quote</span>
								<span class="arrow-icon" aria-hidden="true">&rarr;</span>
							</button>
							<a href="/products" class="btn-hero-secondary">
								<span>Explore Product Profile</span>
								<span class="arrow-icon" aria-hidden="true">&rarr;</span>
							</a>
						</div>

						<div class="hero-stats-strip">
							<div class="stat-item">
								<div class="stat-icon-wrap">
									<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
								</div>
								<div class="stat-text-wrap">
									<span class="stat-num">500+</span>
									<span class="stat-label">Clients across Gujarat</span>
								</div>
							</div>
							<div class="stat-divider" aria-hidden="true"></div>
							<div class="stat-item">
								<div class="stat-icon-wrap">
									<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
								</div>
								<div class="stat-text-wrap">
									<span class="stat-num">18+</span>
									<span class="stat-label">Years of excellence</span>
								</div>
							</div>
							<div class="stat-divider" aria-hidden="true"></div>
							<div class="stat-item">
								<div class="stat-icon-wrap">
									<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
								</div>
								<div class="stat-text-wrap">
									<span class="stat-num">25–50k</span>
									<span class="stat-label">LPH capacity range</span>
								</div>
							</div>
							<div class="stat-divider" aria-hidden="true"></div>
							<div class="stat-item">
								<div class="stat-icon-wrap">
									<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
								</div>
								<div class="stat-text-wrap">
									<span class="stat-num">100%</span>
									<span class="stat-label">Turnkey commissioning</span>
								</div>
							</div>
						</div>
					</div>

					<div class="hero-card-column">
						<div class="calculator-card">
							<div class="calculator-header">
								<div class="calc-tag-wrap">
									<span class="calc-tag">
										<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
										<span>Interactive Sizing Tool</span>
									</span>
								</div>
								<h3 class="calc-title">Instant Plant Capacity Estimator</h3>
							</div>

							<form id="hero-calc-form" onsubmit="event.preventDefault(); calculatePlant();">
								<div class="calc-field-group">
									<label class="calc-label" for="calc-industry">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 20h20"/><path d="M6 20V10l6-4v14"/><path d="M12 20V6l6-4v18"/></svg>
										<span>Industry / Application Sector</span>
									</label>
									<div class="select-wrapper">
										<select id="calc-industry" class="calc-select" onchange="calculatePlant()">
											<option value="factory" selected>Industrial Factory / Manufacturing</option>
											<option value="pharma">Pharmaceuticals &amp; Labs (DM Water)</option>
											<option value="hotel">Hotel, Restaurant &amp; Resort</option>
											<option value="residential">Apartment Society / Residential</option>
											<option value="hospital">Hospital &amp; Clinic</option>
											<option value="school">School / University / Hostel</option>
											<option value="waste">Effluent / Sewage Treatment (ETP/STP)</option>
										</select>
										<svg class="select-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
									</div>
								</div>

								<LiquidSlider defaultValue={10000} id="aqua-liquid-slider" />

								<select id="calc-usage" style="display: none;" aria-hidden="true" tabindex="-1" onchange="calculatePlant()">
									<option value="500">500</option>
									<option value="2000">2000</option>
									<option value="5000">5000</option>
									<option value="10000" selected>10000</option>
									<option value="25000">25000</option>
									<option value="50000">50000</option>
								</select>

								<div class="calc-result-box" id="calc-result" aria-live="polite">
									<div class="result-check-badge" aria-hidden="true">
										<svg viewBox="0 0 20 20" fill="currentColor" width="12" height="12"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
									</div>
									<div class="result-info-col">
										<div class="result-label">Recommended System:</div>
										<div class="result-model" id="result-model-name">1,000 LPH Commercial RO Plant (SS 304)</div>
										<div class="result-specs" id="result-specs-text">
											Vertical multistage pump, dual FRP vessels, auto-flush, imported membrane.
										</div>
									</div>
								</div>

								<button type="button" class="btn-calc-submit" id="calc-quote-btn" data-quote-trigger data-plant="1,000 LPH Commercial RO Plant (SS 304)">
									<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
									<span>Get Exact Pricing for This Model &rarr;</span>
								</button>
							</form>
						</div>
					</div>
				</div>

				<div class="hero-water-splash" aria-hidden="true">
					<img src="/images/water-wave-splash.jpg" alt="" class="splash-graphic-img" loading="lazy" />
				</div>
			</section>

			<!-- ======================================================
			     ABOUT
			     ====================================================== -->
			<section class="section company-overview-section" id="about" aria-labelledby="about-heading">
				<div class="container">
					<div class="section-title-wrap-centered">
						<div class="eyebrow-dashes">
							<span class="dash-rule" aria-hidden="true"></span>
							<span class="eyebrow-text">About Aqua Shakti Industries</span>
							<span class="dash-rule" aria-hidden="true"></span>
						</div>
						<h2 id="about-heading" class="title-trusted-partner">Your Trusted Partner in Water Solutions</h2>
						<p class="subtitle-trusted-partner">
							High-quality water treatment plants and chemicals for a cleaner, safer tomorrow.
						</p>
					</div>

					<div class="grid-2 profile-grid">
						<div class="profile-image-col">
							<div class="image-stack">
								<img src="/images/hero-plant.jpg" alt="Aqua Shakti Industrial Reverse Osmosis Skid" class="main-profile-img" loading="lazy" />
								<div class="experience-badge float-anim">
									<span class="badge-num">18+</span>
									<span class="badge-text">Years Industrial Track Record</span>
								</div>
							</div>
						</div>

						<div class="profile-text-col">
							<h3 class="profile-lead-title">Engineering Pure Water &amp; Wastewater Systems Since 2007</h3>
							<p>
								Based in <strong>Vapi, Valsad (Gujarat)</strong>, we are an <strong>ISO 9001:2008 certified turnkey manufacturer</strong> of custom RO plants, softeners, DM units, and ZLD ETP/STP systems.
							</p>
							<p>
								With <strong>500+ industrial installations</strong> across Gujarat and western India, our engineers deliver robust SS skids, rapid installation, and prompt preventive maintenance.
							</p>

							<ul class="profile-features-list" role="list">
								<li class="feature-item">
									<span class="feature-icon" aria-hidden="true">✓</span>
									<div>
										<strong>ISO 9001:2008 Certified</strong>
										<span>Strict inspection from fabrication to commissioning</span>
									</div>
								</li>
								<li class="feature-item">
									<span class="feature-icon" aria-hidden="true">✓</span>
									<div>
										<strong>GPCB &amp; CPCB Compliant</strong>
										<span>Engineered to meet pollution control discharge limits</span>
									</div>
								</li>
								<li class="feature-item">
									<span class="feature-icon" aria-hidden="true">✓</span>
									<div>
										<strong>Turnkey Spares &amp; Chemicals</strong>
										<span>Membranes, resins, antiscalants, and multiport valves in stock</span>
									</div>
								</li>
							</ul>

							<div class="profile-cta">
								<a href="/about" class="btn btn-secondary">Read Full Company Profile &rarr;</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<ProductCarousel />

			<!-- ======================================================
			     COMMERCIAL RO MODELS TABLE
			     ====================================================== -->
			<section class="section" aria-labelledby="commercial-heading">
				<div class="container">
					<div class="section-header">
						<span class="section-tag">Commercial Models</span>
						<h2 id="commercial-heading">Aqua Shakti Commercial RO Plant Lineup</h2>
						<p class="section-subtitle">
							Grade 304 stainless steel with import membranes and vertical multistage pumps.
						</p>
					</div>

					<div class="spec-table-wrapper" role="region" aria-label="RO model specifications" tabindex="0">
						<table class="spec-table">
							<thead>
								<tr>
									<th scope="col">Model</th>
									<th scope="col">Capacity</th>
									<th scope="col">Membrane</th>
									<th scope="col">HP Pump</th>
									<th scope="col">Pre-Filter</th>
									<th scope="col">Key Features</th>
									<th scope="col">Action</th>
								</tr>
							</thead>
							<tbody>
								{[
									['Aqua-25','25 LPH','1 x 75 GPD / 100 GPD','Booster Diaphragm','10" Spun + Carbon Block','Compact mount, auto cut-off','25 LPH RO Plant'],
									['Aqua-50','50 LPH','2 x 100 GPD / 1 x 4021','Heavy Booster','20" Spun Pre-Filter','SS 304 frame, dual TDS control','50 LPH RO Plant'],
									['Aqua-100','100 LPH','2 x 4021 / 1 x 4040','Vertical Multi-stage (0.5 HP)','20" Jumbo Cartridge','SS skid, flow meter, pressure gauge','100 LPH RO Plant'],
									['Aqua-250','250 LPH','1 x 4040 Import TFC','Vertical Multi-stage (1.0 HP)','FRP Sand + 5-Micron','Auto-flush, low pressure switch','250 LPH RO Plant'],
									['Aqua-500','500 LPH','2 x 4040 High Rejection','Vertical Multi-stage (1.5 HP)','FRP Dual Media (Sand+Carbon)','SS panel, UV system, chemical dosing','500 LPH RO Plant'],
									['Aqua-1000','1,000 LPH','4 x 4040 / 1 x 8040','Vertical Multi-stage (2.0–3.0 HP)','Dual FRP Vessels + Cartridge','SS 304 skid, telemetry, auto-backwash','1000 LPH RO Plant'],
								].map(([model, cap, membrane, pump, pre, features, plant]) => (
									<tr>
										<td><strong>{model}</strong></td>
										<td>{cap}</td>
										<td>{membrane}</td>
										<td>{pump}</td>
										<td>{pre}</td>
										<td>{features}</td>
										<td>
											<button class="btn btn-primary btn-sm" data-quote-trigger data-plant={plant}>Enquire</button>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</div>
			</section>

			<!-- ======================================================
			     TURNKEY SHOWCASE
			     ====================================================== -->
			<section class="section section-alt turnkey-showcase-section" aria-labelledby="turnkey-heading">
				<div class="container">
					<div class="section-header-flex">
						<div>
							<span class="section-tag">Turnkey Highlights</span>
							<h2 id="turnkey-heading">Clarification &amp; High-Efficiency Boiler Systems</h2>
							<p class="section-subtitle">Heavy-duty skid units for continuous industrial operations.</p>
						</div>
						<div class="carousel-ctrl-sm" role="group" aria-label="Turnkey systems navigation">
							<button type="button" class="ctrl-arrow-btn" id="turnkey-prev-btn" aria-label="Previous system">
