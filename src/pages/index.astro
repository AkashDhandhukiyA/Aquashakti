---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import QuoteModal from '../components/QuoteModal.astro';
import ClientsBanner from '../components/ClientsBanner.astro';
import LiquidSlider from '../components/LiquidSlider.astro';
import ProductCarousel from '../components/ProductCarousel.astro';
import { COMPANY_NAME, COMPANY_TAGLINE, SITE_DESCRIPTION, SITE_TITLE, COMPANY_PHONE, COMPANY_EMAIL } from '../consts';

// Fetch recent blog posts from markdown files
const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/images/hero-plant.jpg" />
	</head>
	<body>
		<main id="main-content">
			<!-- Hero Section with Industrial Background & Interactive Capacity Calculator -->
			<section class="hero-section">
				<Header />

				<div class="container hero-container">
					<div class="hero-content">
						<!-- 3 Pill Badges matching image -->
						<div class="hero-badges">
							<span class="hero-badge badge-iso">
								<svg class="badge-icon icon-green" viewBox="0 0 20 20" fill="currentColor" width="14" height="14"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
								<span>ISO 9001:2008 CERTIFIED</span>
							</span>
							<span class="hero-badge badge-waptag">
								<svg class="badge-icon icon-blue" viewBox="0 0 20 20" fill="currentColor" width="14" height="14"><path d="M7 8a3 3 0 100-6 3 3 0 000 6zM14.5 9a2.5 2.5 0 100-5 2.5 2.5 0 000 5zM1.615 16.428a1.224 1.224 0 01-.569-1.175 6.002 6.002 0 0111.908 0c.058.467-.172.92-.57 1.174A9.953 9.953 0 017 18a9.953 9.953 0 01-5.385-1.572zM14.5 16h-.106c.07-.297.088-.611.048-.933a7.47 7.47 0 00-1.588-3.755 4.502 4.502 0 015.874 2.636.813.813 0 01-.63 1.052H14.5z"/></svg>
								<span>WAPTAG MEMBER</span>
							</span>
							<span class="hero-badge badge-flag">
								<svg class="badge-flag-svg" viewBox="0 0 24 16" width="18" height="12" style="border-radius: 2px; box-shadow: 0 0 1px rgba(0,0,0,0.3); vertical-align: middle;" aria-hidden="true">
									<rect width="24" height="5.33" fill="#FF9933"/>
									<rect y="5.33" width="24" height="5.33" fill="#FFFFFF"/>
									<rect y="10.66" width="24" height="5.34" fill="#138808"/>
									<circle cx="12" cy="8" r="2.2" fill="none" stroke="#000080" stroke-width="0.5"/>
									<circle cx="12" cy="8" r="0.5" fill="#000080"/>
								</svg>
								<span>MAKE IN INDIA</span>
							</span>
						</div>

						<!-- Headline: Ideal Solution for All Types of Water -->
						<h1 class="hero-title">
							Ideal Solution for<br />
							<span class="highlight-blue">All Types of Water</span>
						</h1>

						<!-- Subtitle paragraph -->
						<p class="hero-subtitle">
							Aqua Shakti Industries &mdash; Leading Manufacturer, Supplier &amp; Turnkey Service Provider of Industrial RO Plants, Commercial RO Systems, Water Softeners, DM Plants, ETP &amp; Sewage Treatment Plants (STP) based in Vapi, Gujarat since 2007.
						</p>

						<!-- CTAs: Get Free Plant Sizing & Quote + Explore Product Profile -->
						<div class="hero-cta-group">
							<button type="button" class="btn-hero-primary" data-quote-trigger data-plant="Complete Plant Requirement">
								<svg class="btn-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
								<span>Get Free Plant Sizing &amp; Quote</span>
								<span class="arrow-icon">&rarr;</span>
							</button>
							<a href="/products" class="btn-hero-secondary">
								<span>Explore Product Profile</span>
								<span class="arrow-icon">&rarr;</span>
							</a>
						</div>

						<!-- Trust Metrics Strip: 4 items with blue icons -->
						<div class="hero-stats-strip">
							<div class="stat-item">
								<div class="stat-icon-wrap">
									<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#0284c7" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
								</div>
								<div class="stat-text-wrap">
									<span class="stat-num">500+</span>
									<span class="stat-label">CLIENTS ACROSS GUJARAT</span>
								</div>
							</div>
							<div class="stat-divider"></div>
							<div class="stat-item">
								<div class="stat-icon-wrap">
									<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#0284c7" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
								</div>
								<div class="stat-text-wrap">
									<span class="stat-num">18+</span>
									<span class="stat-label">YEARS OF EXCELLENCE (ESTD 2007)</span>
								</div>
							</div>
							<div class="stat-divider"></div>
							<div class="stat-item">
								<div class="stat-icon-wrap">
									<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#0284c7" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
								</div>
								<div class="stat-text-wrap">
									<span class="stat-num">25 to 50k</span>
									<span class="stat-label">LPH CAPACITY RANGE</span>
								</div>
							</div>
							<div class="stat-divider"></div>
							<div class="stat-item">
								<div class="stat-icon-wrap">
									<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#0284c7" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
								</div>
								<div class="stat-text-wrap">
									<span class="stat-num">100%</span>
									<span class="stat-label">TURNKEY COMMISSIONING</span>
								</div>
							</div>
						</div>
					</div>

					<!-- Hero Visual & Interactive Sizing Estimator Card -->
					<div class="hero-card-column">
						<div class="calculator-card">
							<div class="calculator-header">
								<div class="calc-tag-wrap">
									<span class="calc-tag">
										<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
										<span>INTERACTIVE SIZING TOOL</span>
									</span>
								</div>
								<h3 class="calc-title">Instant Plant Capacity Estimator</h3>
							</div>

							<form id="hero-calc-form" onsubmit="event.preventDefault(); calculatePlant();">
								<!-- 1. Industry / Sector -->
								<div class="calc-field-group">
									<label class="calc-label" for="calc-industry">
										<svg class="field-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2"><path d="M2 20h20"/><path d="M6 20V10l6-4v14"/><path d="M12 20V6l6-4v18"/></svg>
										<span>Industry / Application Sector</span>
									</label>
									<div class="select-wrapper">
										<select id="calc-industry" class="calc-select" onchange="calculatePlant()">
											<option value="factory" selected>Industrial Factory / Manufacturing</option>
											<option value="pharma">Pharmaceuticals &amp; Labs (DM Water)</option>
											<option value="hotel">Hotel, Restaurant &amp; Resort</option>
											<option value="residential">Apartment Society / Residential</option>
											<option value="hospital">Hospital &amp; Clinic</option>
											<option value="school">School / University / Hostel</option>
											<option value="waste">Effluent / Sewage Treatment (ETP/STP)</option>
										</select>
										<svg class="select-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
									</div>
								</div>

								<!-- 2. Compact Physics Liquid Water Slider (Side-by-Side Beaker & Preset Chips) -->
								<LiquidSlider defaultValue={10000} id="aqua-liquid-slider" />

								<!-- Hidden Select to keep form values synchronized for calculatePlant() -->
								<select id="calc-usage" style="display: none;" onchange="calculatePlant()">
									<option value="500">500</option>
									<option value="2000">2000</option>
									<option value="5000">5000</option>
									<option value="10000" selected>10000</option>
									<option value="25000">25000</option>
									<option value="50000">50000</option>
								</select>

								<!-- 3. Recommendation Box -->
								<div class="calc-result-box" id="calc-result">
									<div class="result-check-badge">
										<svg viewBox="0 0 20 20" fill="currentColor" width="12" height="12"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
									</div>
									<div class="result-info-col">
										<div class="result-label">RECOMMENDED SYSTEM:</div>
										<div class="result-model" id="result-model-name">1,000 LPH Commercial RO Plant (SS 304)</div>
										<div class="result-specs" id="result-specs-text">
											Vertical multistage pump, dual FRP vessels, auto-flush, imported membrane.
										</div>
									</div>
								</div>

								<!-- 4. CTA Pricing Button -->
								<button type="button" class="btn-calc-submit" id="calc-quote-btn" data-quote-trigger data-plant="1,000 LPH Commercial RO Plant (SS 304)">
									<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
									<span>Get Exact Pricing for This Model &rarr;</span>
								</button>
							</form>
						</div>
					</div>
				</div>

				<!-- Water Wave Splash Graphic along bottom of Hero -->
				<div class="hero-water-splash" aria-hidden="true">
					<img src="/images/water-wave-splash.jpg" alt="" class="splash-graphic-img" />
				</div>
			</section>

			<!-- Company Profile Banner -->
			<section class="section company-overview-section" id="about">
				<div class="container">
					<!-- Section Heading matching image -->
					<div class="section-title-wrap-centered">
						<div class="eyebrow-dashes">
							<span class="dash-rule"></span>
							<span class="eyebrow-text">ABOUT AQUA SHAKTI INDUSTRIES</span>
							<span class="dash-rule"></span>
						</div>
						<h2 class="title-trusted-partner">Your Trusted Partner in Water Solutions</h2>
						<p class="subtitle-trusted-partner">
							We design, manufacture and supply high-quality water treatment plants and chemicals for a cleaner, safer and healthier tomorrow.
						</p>
					</div>

					<div class="grid-2 profile-grid">
						<div class="profile-image-col">
							<div class="image-stack">
								<img src="/images/hero-plant.jpg" alt="Aqua Shakti Industrial Reverse Osmosis Skid" class="main-profile-img" />
								<div class="experience-badge float-anim">
									<span class="badge-num">18+</span>
									<span class="badge-text">Years Industrial Track Record</span>
								</div>
							</div>
						</div>

						<div class="profile-text-col">
							<h3 class="profile-lead-title">Engineering Pure Water & Wastewater Systems Since 2007</h3>
							<p>
								Established in <strong>Vapi, Valsad (Gujarat)</strong>, Aqua Shakti Industries is an <strong>ISO 9001:2008 certified turnkey manufacturer</strong> specializing in customized Reverse Osmosis Plants, Softeners, DM Units, and Zero Liquid Discharge (ZLD) ETP/STP systems.
							</p>
							<p>
								With over <strong>500+ industrial installations</strong> across Gujarat and western India, our experienced engineers deliver robust Stainless Steel skids, rapid installation, and prompt preventative maintenance.
							</p>

							<div class="profile-features-list">
								<div class="feature-item">
									<div class="feature-icon">✓</div>
									<div>
										<strong>ISO 9001:2008 Certified</strong>
										<span>Strict quality inspection from fabrication to commissioning</span>
									</div>
								</div>
								<div class="feature-item">
									<div class="feature-icon">✓</div>
									<div>
										<strong>Active WAPTAG Member</strong>
										<span>Affiliated with Water Purification & Treatment Association of Gujarat</span>
									</div>
								</div>
								<div class="feature-item">
									<div class="feature-icon">✓</div>
									<div>
										<strong>Turnkey Spare Parts & Chemicals</strong>
										<span>Full stock of membranes, resins, antiscalants, and multiport valves</span>
									</div>
								</div>
							</div>

							<div style="margin-top: 2rem;">
								<a href="/about" class="btn btn-secondary">Read Full Company Profile &rarr;</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Comprehensive Product Profile Carousel (Momentum Rail & Closures) -->
			<ProductCarousel />

			<!-- Commercial RO Models Detailed Specs Table (Direct from Brochure Page 3/16) -->
			<section class="section">
				<div class="container">
					<div class="section-header">
						<span class="section-tag">Commercial Models</span>
						<h2>Aqua Shakti Commercial RO Plant Lineup</h2>
						<p class="section-subtitle">
							Manufactured in Grade 304 Stainless Steel with import membranes and vertical multistage pumps.
						</p>
					</div>

					<div class="spec-table-wrapper">
						<table class="spec-table">
							<thead>
								<tr>
									<th>Model</th>
									<th>Capacity (LPH)</th>
									<th>Membrane Type</th>
									<th>High Pressure Pump</th>
									<th>Pre-Filter Stage</th>
									<th>Key Features</th>
									<th>Action</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td><strong>Aqua-25</strong></td>
									<td>25 LPH</td>
									<td>1 x 75 GPD / 100 GPD</td>
									<td>Booster Diaphragm Pump</td>
									<td>10" Spun + Carbon Block</td>
									<td>Compact wall/table mount, Auto cut-off</td>
									<td><button class="btn btn-primary btn-sm" data-quote-trigger data-plant="25 LPH RO Plant">Enquire</button></td>
								</tr>
								<tr>
									<td><strong>Aqua-50</strong></td>
									<td>50 LPH</td>
									<td>2 x 100 GPD / 1 x 4021</td>
									<td>Heavy Booster Pump</td>
									<td>20" Spun Pre-Filter</td>
									<td>Stainless Steel 304 Frame, Dual TDS control</td>
									<td><button class="btn btn-primary btn-sm" data-quote-trigger data-plant="50 LPH RO Plant">Enquire</button></td>
								</tr>
								<tr>
									<td><strong>Aqua-100</strong></td>
									<td>100 LPH</td>
									<td>2 x 4021 / 1 x 4040</td>
									<td>Vertical Multi-stage (0.5 HP)</td>
									<td>20" Jumbo Cartridge Housing</td>
									<td>SS Skid, Flow meter, Pressure gauge</td>
									<td><button class="btn btn-primary btn-sm" data-quote-trigger data-plant="100 LPH RO Plant">Enquire</button></td>
								</tr>
								<tr>
									<td><strong>Aqua-250</strong></td>
									<td>250 LPH</td>
									<td>1 x 4040 Import TFC</td>
									<td>Vertical Multi-stage (1.0 HP)</td>
									<td>FRP Sand Filter + 5-Micron</td>
									<td>Auto-flush, Low pressure switch, Rota meter</td>
									<td><button class="btn btn-primary btn-sm" data-quote-trigger data-plant="250 LPH RO Plant">Enquire</button></td>
								</tr>
								<tr>
									<td><strong>Aqua-500</strong></td>
									<td>500 LPH</td>
									<td>2 x 4040 High Rejection</td>
									<td>Vertical Multi-stage (1.5 HP)</td>
									<td>FRP Dual Media Filter (Sand+Carbon)</td>
									<td>SS Control Panel, UV System, Chemical Dosing</td>
									<td><button class="btn btn-primary btn-sm" data-quote-trigger data-plant="500 LPH RO Plant">Enquire</button></td>
								</tr>
								<tr>
									<td><strong>Aqua-1000</strong></td>
									<td>1,000 LPH</td>
									<td>4 x 4040 / 1 x 8040</td>
									<td>Vertical Multi-stage (2.0 - 3.0 HP)</td>
									<td>Dual FRP Pressure Vessels + Cartridge</td>
									<td>Complete SS 304 Skid, Telemetry, Auto-Backwash</td>
									<td><button class="btn btn-primary btn-sm" data-quote-trigger data-plant="1000 LPH RO Plant">Enquire</button></td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</section>

			<!-- Water Treatment Plant (Secondary Settling Tank) & Boiler Plant Showcase -->
			<section class="section section-alt turnkey-showcase-section">
				<div class="container">
					<div class="section-header-flex">
						<div>
							<span class="section-tag">Turnkey Engineering Highlights</span>
							<h2>Clarification &amp; High-Efficiency Boiler Systems</h2>
							<p class="section-subtitle">Heavy-duty skid package units engineered for continuous industrial operations.</p>
						</div>
						<div class="carousel-ctrl-sm">
							<button type="button" class="ctrl-arrow-btn" id="turnkey-prev-btn" aria-label="Previous System" title="Previous System">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
							</button>
							<button type="button" class="ctrl-arrow-btn" id="turnkey-next-btn" aria-label="Next System" title="Next System">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
							</button>
						</div>
					</div>

					<div class="turnkey-carousel-rail" id="turnkey-carousel-rail">
						<div class="turnkey-track">
							<!-- Secondary Settling Tank Package Plant -->
							<div class="card card-hover turnkey-card" style="display: flex; flex-direction: column; padding: 0; overflow: hidden;">
								<div style="position: relative; aspect-ratio: 16/9; overflow: hidden;">
									<img src="/images/secondary-settling-plant.jpg" alt="Secondary Settling Tank and Filter Plant" style="width: 100%; height: 100%; object-fit: cover;" />
									<span class="badge badge-teal" style="position: absolute; bottom: 0.75rem; left: 0.75rem;">Skid-Mounted Unit</span>
								</div>
								<div style="padding: 1.75rem; display: flex; flex-direction: column; flex-grow: 1;">
									<span class="section-tag" style="margin-bottom: 0.5rem; width: fit-content;">Clarification &amp; Filtration</span>
									<h3>Water Treatment Plant (Secondary Settling Tank)</h3>
									<p style="font-size: 0.9rem; color: #475569; flex-grow: 1;">
										Equipped with hopper-bottom conical settling tank, multi-media filter column, chemical dosing drum, and automated panel board for industrial wastewater clarification.
									</p>
									<div style="display: flex; gap: 0.75rem; align-items: center; margin-top: 1rem; flex-wrap: wrap;">
										<button class="btn btn-primary btn-sm" data-quote-trigger data-plant="Secondary Settling Tank Plant">
											Get Quote &rarr;
										</button>
										<a href="/products#settling-plants" class="spec-link">Detailed Specs</a>
									</div>
								</div>
							</div>

							<!-- Industrial Boiler Plant -->
							<div class="card card-hover turnkey-card" style="display: flex; flex-direction: column; padding: 0; overflow: hidden;">
								<div style="position: relative; aspect-ratio: 16/9; overflow: hidden;">
									<img src="/images/boiler-plant.jpg" alt="Industrial Boiler Plant Unit" style="width: 100%; height: 100%; object-fit: cover;" />
									<span class="badge badge-blue" style="position: absolute; bottom: 0.75rem; left: 0.75rem;">Thermal Engineering</span>
								</div>
								<div style="padding: 1.75rem; display: flex; flex-direction: column; flex-grow: 1;">
									<span class="section-tag" style="margin-bottom: 0.5rem; width: fit-content;">High-Efficiency Steam</span>
									<h3>Industrial Boiler Plants &amp; Steam Systems</h3>
									<p style="font-size: 0.9rem; color: #475569; flex-grow: 1;">
										Features Super Economizer (SE), step-fired multi-fuel burners (Natural gas, propane, biogas, oil), rapid start-up, and fuel savings for continuous production.
									</p>
