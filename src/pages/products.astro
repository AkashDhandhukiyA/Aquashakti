		<script is:inline>
			(function() {
				function initCategoryRail() {
					const rail = document.querySelector('.category-pills-nav');
					const pills = document.querySelectorAll('.category-pills-nav .cat-pill');
					if (!pills.length || !rail) return;

					const sectionIds = Array.from(pills).map(p => p.getAttribute('href').substring(1));
					const sections = sectionIds.map(id => document.getElementById(id)).filter(Boolean);

					function onScroll() {
						const scrollPos = window.scrollY + 180;
						let currentSectionId = '';

						sections.forEach(sec => {
							if (sec.offsetTop <= scrollPos) {
								currentSectionId = sec.id;
							}
						});

						if (currentSectionId) {
							pills.forEach(pill => {
								if (pill.getAttribute('href') === '#' + currentSectionId) {
									if (!pill.classList.contains('active')) {
										pills.forEach(p => p.classList.remove('active'));
										pill.classList.add('active');
										pill.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
									}
								}
							});
						}
					}

					let scrollTimer = null;
					window.addEventListener('scroll', () => {
						if (!scrollTimer) {
							scrollTimer = requestAnimationFrame(() => {
								onScroll();
								scrollTimer = null;
							});
						}
					}, { passive: true });
				}

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initCategoryRail);
				} else {
					initCategoryRail();
				}
				document.addEventListener('astro:page-load', initCategoryRail);
			})();
		</script>
