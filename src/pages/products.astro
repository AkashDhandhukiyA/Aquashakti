---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import QuoteModal from '../components/QuoteModal.astro';
import ProductCarousel from '../components/ProductCarousel.astro';
import { COMPANY_NAME } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Products & Plants Profile | ${COMPANY_NAME}`}
			description="Industrial RO Plants, Commercial RO Systems, ETP, STP, Boiler Plants, Secondary Settling Tanks, Softeners, DM Plants, and Complete Water Treatment Chemicals in Vapi, Gujarat."
			image="/images/hero-plant.jpg"
		/>
	</head>
	<body>
		<Header />

		<main class="products-page">
			<!-- ======================================================
			     HERO
			     ====================================================== -->
			<section class="products-hero">
				<div class="container text-center">
					<span class="eyebrow-pill">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 20h20"/><path d="M6 20V10l6-4v14"/><path d="M12 20V6l6-4v18"/></svg>
						<span>Manufacturing &amp; Engineering</span>
					</span>
					<h1 class="products-main-title">Water &amp; Wastewater Plant Profile</h1>
					<p class="section-subtitle">
						Engineered for reliability, minimal maintenance and full GPCB, CPCB &amp; ISO 9001:2008 compliance.
					</p>

					<div class="products-stats-bar">
						<div class="p-stat">
							<span class="p-stat-val">8</span>
							<span class="p-stat-lbl">Plant categories</span>
						</div>
						<div class="p-stat-div" aria-hidden="true"></div>
						<div class="p-stat">
							<span class="p-stat-val">25–50k</span>
							<span class="p-stat-lbl">LPH capacity</span>
						</div>
						<div class="p-stat-div" aria-hidden="true"></div>
						<div class="p-stat">
							<span class="p-stat-val">100%</span>
							<span class="p-stat-lbl">Turnkey skid</span>
						</div>
						<div class="p-stat-div" aria-hidden="true"></div>
						<div class="p-stat">
							<span class="p-stat-val">ISO</span>
							<span class="p-stat-lbl">&amp; GPCB</span>
						</div>
					</div>
				</div>

				<div class="category-nav-wrapper" id="sticky-category-rail">
					<div class="container">
						<nav class="category-pills-nav" aria-label="Product categories">
							<a href="#commercial-ro" class="cat-pill active">Commercial RO</a>
							<a href="#industrial-ro" class="cat-pill">Industrial RO</a>
							<a href="#settling-plants" class="cat-pill">Settling Tanks</a>
							<a href="#boiler-plant" class="cat-pill">Boiler Plants</a>
							<a href="#etp-plants" class="cat-pill">ETP</a>
							<a href="#stp-plants" class="cat-pill">STP</a>
							<a href="#dm-plants" class="cat-pill">Softeners &amp; DM</a>
							<a href="#industrial-chemicals" class="cat-pill">Chemicals</a>
						</nav>
					</div>
				</div>
			</section>

			<ProductCarousel
				title="Interactive plant showcase"
				subtitle="Swipe through core models or jump to detailed specifications below."
				showViewAllButton={false}
			/>

			<!-- ======================================================
			     1. COMMERCIAL RO
			     ====================================================== -->
			<section class="section" id="commercial-ro">
				<div class="container">
					<div class="section-title-wrap-centered">
						<span class="eyebrow">Commercial</span>
						<h2 class="section-title">Commercial RO plants (25–1000 LPH)</h2>
						<p class="section-subtitle">
							SS 304 frame, vertical multistage pumps, auto-flush, imported TFC membranes.
						</p>
					</div>

					<div class="grid-2 product-detail-row">
						<div>
							<img src="/images/commercial-ro.jpg" alt="Aqua Shakti Commercial RO Plant Skid" class="detail-img" loading="lazy" />
							<div class="features-checklist card">
								<h4>Standard features</h4>
								<ul class="spec-list">
									<li>SS 304 grade frame</li>
									<li>Imported high-rejection membrane</li>
									<li>FRP / SS pressure vessels</li>
									<li>Vertical multistage high-pressure pump</li>
									<li>Control panel with voltmeter &amp; switches</li>
									<li>5-micron jumbo pre-filter</li>
									<li>Dual flow meter &amp; glycerin-filled gauge</li>
									<li>Low-pressure switch (dry-run protection)</li>
									<li>Automatic high-velocity flush</li>
									<li>SS UV chamber</li>
								</ul>
							</div>
						</div>

						<div>
							<h3 class="detail-heading">Available capacities</h3>
							<p class="detail-lead">
								For offices, restaurants, hotels, schools, universities, residential buildings and bottling facilities.
							</p>

							<div class="spec-table-wrapper">
								<table class="spec-table">
									<thead>
										<tr>
											<th scope="col">Capacity</th>
											<th scope="col">Recommended usage</th>
											<th scope="col">Action</th>
										</tr>
									</thead>
									<tbody>
										<tr>
											<td><strong>25 LPH</strong></td>
											<td>Small clinic, office (20–50 people)</td>
											<td><button class="btn btn-primary btn-sm" data-quote-trigger data-plant="25 LPH RO Plant">Quote</button></td>
										</tr>
										<tr>
											<td><strong>50 LPH</strong></td>
											<td>Coaching centres, cafés (50–100 people)</td>
											<td><button class="btn btn-primary btn-sm" data-quote-trigger data-plant="50 LPH RO Plant">Quote</button></td>
										</tr>
										<tr>
											<td><strong>100 / 250 LPH</strong></td>
											<td>Hotels, mid hospitals (150–400 people)</td>
											<td><button class="btn btn-primary btn-sm" data-quote-trigger data-plant="250 LPH RO Plant">Quote</button></td>
										</tr>
										<tr>
											<td><strong>500 LPH</strong></td>
											<td>Large colleges, canteens (500–1000 people)</td>
											<td><button class="btn btn-primary btn-sm" data-quote-trigger data-plant="500 LPH RO Plant">Quote</button></td>
										</tr>
										<tr>
											<td><strong>1,000 LPH</strong></td>
											<td>Hostels, industrial staff, packaging</td>
											<td><button class="btn btn-primary btn-sm" data-quote-trigger data-plant="1000 LPH RO Plant">Quote</button></td>
										</tr>
									</tbody>
								</table>
							</div>

							<div class="detail-cta">
								<button class="btn btn-primary" data-quote-trigger data-plant="Commercial RO Plant Requirement">
									Request commercial RO pricing &rarr;
								</button>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ======================================================
			     2. INDUSTRIAL RO
			     ====================================================== -->
			<section class="section section-alt" id="industrial-ro">
				<div class="container">
					<div class="section-title-wrap-centered">
						<span class="eyebrow">Heavy industrial</span>
						<h2 class="section-title">Industrial RO &amp; sea water desalination</h2>
						<p class="section-subtitle">
							Skid-mounted reverse osmosis plants from 500 LPH to 50,000+ LPH.
						</p>
					</div>

					<div class="grid-2 product-detail-row">
						<div>
							<h3 class="detail-heading">Engineered for high-TDS &amp; brackish water</h3>
							<p class="detail-lead">
								Membrane RO removes dissolved salts from sea water and high-TDS borewell water — far more economical and energy-efficient than thermal evaporation.
							</p>

							<div class="feature-card">
								<h4>Key components</h4>
								<ul class="spec-list">
									<li>High-pressure vertical centrifugal pumps (SS 304 / 316)</li>
									<li>8-inch high salt-rejection polyamide membranes (Dow / Hydranautics / Toray)</li>
									<li>FRP / SS pressure vessels (300–1000 PSI)</li>
									<li>Multi-media pre-treatment + antiscalant dosing</li>
									<li>Integrated Clean-In-Place (CIP) skid</li>
									<li>PLC / SCADA automation with TDS &amp; conductivity telemetry</li>
								</ul>
							</div>

							<div class="detail-cta">
								<button class="btn btn-primary" data-quote-trigger data-plant="Industrial RO Plant" data-capacity="10000 LPH">
									Request industrial RO proposal &rarr;
								</button>
							</div>
						</div>

						<div>
							<img src="/images/hero-plant.jpg" alt="Industrial RO plant 5000 LPH skid" class="detail-img" loading="lazy" />
							<div class="caption-card">
								<strong>5,000–20,000 LPH turnkey skid:</strong> SS 304 piping, Victaulic couplings, digital panel board, dual vertical multistage pumps.
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ======================================================
			     3. SETTLING PLANTS
			     ====================================================== -->
			<section class="section" id="settling-plants">
				<div class="container">
					<div class="section-title-wrap-centered">
						<span class="eyebrow">Package plants</span>
						<h2 class="section-title">Secondary settling tank &amp; multi-media filter</h2>
						<p class="section-subtitle">
							Compact skid-mounted clarification with hopper-bottom settling, mixed-bed columns and dosing automation.
						</p>
					</div>

					<div class="grid-2 product-detail-row">
						<div>
							<img src="/images/secondary-settling-plant.jpg" alt="Water treatment plant with secondary settling tank" class="detail-img" loading="lazy" />
							<div class="caption-card">
								<strong>Turnkey skid unit:</strong> settling tank, holding tank, mixed-bed filter column, chemical dosing system and central control panel.
							</div>
						</div>

						<div>
							<h3 class="detail-heading">Complete industrial skid integration</h3>
							<p class="detail-lead">
								Combines physical coagulation settling with pressurized bed filtration — clean, polished water on a compact footprint.
							</p>

							<div class="feature-card">
								<ul class="spec-list">
									<li>Multi-barrier removal of suspended solids &amp; turbidity</li>
									<li>High-rate multi-media bed (quartz sand, anthracite, gravel)</li>
									<li>Heavy-gauge coated steel settling tank with conical hopper</li>
									<li>Enables zero-liquid-discharge recycling for cooling / gardening</li>
									<li>Integrated panel with pump sequencing &amp; level float control</li>
									<li>Precision chemical dosing drum with electronic metering pump</li>
								</ul>
							</div>

							<div class="detail-cta">
								<button class="btn btn-primary" data-quote-trigger data-plant="Water Treatment Plant with Secondary Settling Tank">
									Request package plant quotation &rarr;
								</button>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ======================================================
			     4. BOILER
			     ====================================================== -->
			<section class="section section-dark" id="boiler-plant">
				<div class="container">
					<div class="section-title-wrap-centered">
						<span class="eyebrow eyebrow-light">Thermal engineering</span>
						<h2 class="section-title section-title-light">Industrial boiler plants</h2>
						<p class="section-subtitle section-subtitle-light">
							High-efficiency steam boilers with Super Economizers, multi-fuel burners and advanced controls.
						</p>
					</div>

					<div class="grid-2 product-detail-row">
						<div>
							<h3 class="detail-heading detail-heading-light">Technical specifications</h3>
							<p class="detail-lead detail-lead-light">
								Steam is a vital, high-cost industrial utility. Our boilers deliver trouble-free operation with maximum thermal efficiency and safety.
							</p>

							<div class="feature-card feature-card-dark">
								<ul class="spec-list spec-list-dark">
									<li>Standard configuration for most industrial installations</li>
									<li><strong>Super Economizer (SE):</strong> recovers flue gas heat for elevated fuel savings</li>
									<li><strong>Step-fired burners:</strong> high/low/off modulation tracks steam demand precisely</li>
									<li><strong>Multi-fuel options:</strong> natural gas, propane, #2 fuel oil, biogas, hydrogen</li>
								</ul>
							</div>

							<div class="benefit-row">
								<span class="benefit-badge">Fuel saving</span>
								<span class="benefit-badge">Safe &amp; reliable</span>
								<span class="benefit-badge">Rapid response</span>
								<span class="benefit-badge">PLC controls</span>
							</div>

							<div class="detail-cta">
								<button class="btn btn-primary" data-quote-trigger data-plant="Industrial Boiler Plant">
									Request boiler plant proposal &rarr;
								</button>
							</div>
						</div>

						<div>
							<img src="/images/boiler-plant.jpg" alt="Industrial boiler plant" class="detail-img" loading="lazy" />
							<div class="caption-card caption-card-dark">
								<strong>Boiler plant unit:</strong> Super Economizer, low-NOx burner, steam pressure safety switches and automated blowdown.
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ======================================================
			     5. ETP
			     ====================================================== -->
			<section class="section" id="etp-plants">
				<div class="container">
					<div class="section-title-wrap-centered">
						<span class="eyebrow">Wastewater</span>
						<h2 class="section-title">Effluent treatment plants (ETP)</h2>
						<p class="section-subtitle">
							Physico-chemical and biological ETP design for chemical, pharma, textile and engineering industries.
						</p>
					</div>

					<div class="grid-2 product-detail-row">
						<div>
							<img src="/images/etp-stp-plant.jpg" alt="Effluent treatment plant facility" class="detail-img" loading="lazy" />
							<div class="caption-card">
								<strong>ETP process flow:</strong> screening → equalization → coagulation → clariflocculator → aeration → secondary clarifier → filter press → sand / carbon polish.
							</div>
						</div>

						<div>
							<h3 class="detail-heading">Applications &amp; advantages</h3>
							<p class="detail-lead">
								Industrial wastewater carries toxic heavy metals, erratic pH, high COD and chemical dyes. Our custom ETPs meet zero-discharge standards.
							</p>

							<div class="feature-card">
								<h4>Advantages</h4>
								<ul class="spec-list">
									<li>Modular scaling for capacity increases</li>
									<li>BOD, COD &amp; nitrogen removal</li>
									<li>Fast recovery from process upsets</li>
									<li>Compact skid layout — minimal footprint</li>
									<li>Low operator attention required</li>
								</ul>
							</div>

							<div class="detail-cta">
								<button class="btn btn-primary" data-quote-trigger data-plant="Effluent Treatment Plant (ETP)" data-capacity="50 KLD">
									Request ETP P&amp;ID &amp; sizing &rarr;
								</button>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ======================================================
			     6. STP
			     ====================================================== -->
			<section class="section section-alt" id="stp-plants">
				<div class="container">
					<div class="section-title-wrap-centered">
						<span class="eyebrow">Biological sewage</span>
						<h2 class="section-title">&ldquo;DELTA PR&rdquo; sewage treatment plants</h2>
						<p class="section-subtitle">
							Fully biological, compliant with Marpol 73/78 Annex IV, European Maritime Equipment Council and USCG.
						</p>
					</div>

					<div class="grid-2 product-detail-row">
						<div>
							<h3 class="detail-heading">Guaranteed effluent quality</h3>
							<p class="detail-lead">
								Treats domestic black and grey water to a clear, bacteriologically-safe output — reusable for gardening, cooling towers and toilet flushing.
							</p>

							<div class="spec-table-wrapper">
								<table class="spec-table">
									<thead>
										<tr>
											<th scope="col">Parameter</th>
											<th scope="col">IMO / CPCB norm</th>
											<th scope="col">DELTA output</th>
										</tr>
									</thead>
									<tbody>
										<tr>
											<td>Suspended solids (TSS)</td>
											<td>&lt; 50 mg/L</td>
											<td><strong class="text-emerald">&lt; 20–30 mg/L</strong></td>
										</tr>
										<tr>
											<td>BOD₅</td>
											<td>&lt; 50 mg/L</td>
											<td><strong class="text-emerald">&lt; 10–20 mg/L</strong></td>
										</tr>
										<tr>
											<td>Coliform bacteria</td>
											<td>&lt; 250 / 100 mL</td>
											<td><strong class="text-emerald">&lt; 100 / 100 mL</strong></td>
										</tr>
									</tbody>
								</table>
							</div>

							<div class="detail-cta">
								<button class="btn btn-primary" data-quote-trigger data-plant="Sewage Treatment Plant (STP)" data-capacity="25 KLD">
									Request STP quote &rarr;
								</button>
							</div>
						</div>

						<div>
							<div class="feature-card">
								<h4>Scope of supply</h4>
								<ul class="spec-list">
									<li><strong>Tanks:</strong> collection, aeration, clarifier, sludge holding</li>
									<li><strong>Effluent discharge pump:</strong> heavy-duty non-clog submersible</li>
									<li><strong>Air blower:</strong> twin-lobe rotary, continuous DO supply</li>
									<li><strong>Chlorine dosing:</strong> electronic metering pump with tank</li>
									<li><strong>Control panel:</strong> PLC with automatic cycling</li>
									<li><strong>Tertiary filtration:</strong> dual-media sand &amp; carbon</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ======================================================
			     7. SOFTENERS & DM
			     ====================================================== -->
			<section class="section" id="dm-plants">
				<div class="container">
					<div class="section-title-wrap-centered">
						<span class="eyebrow">Ion exchange</span>
						<h2 class="section-title">Water softeners, DM &amp; mix-bed plants</h2>
						<p class="section-subtitle">
							Removing hardness and mineral conductivity for boilers, cooling towers, labs and pharmaceuticals.
						</p>
					</div>

					<div class="grid-2 product-detail-row">
						<div>
							<img src="/images/dm-softener.jpg" alt="Industrial water softener and DM plant" class="detail-img" loading="lazy" />
							<div class="caption-card">
								<strong>Composite FRP &amp; SS columns:</strong> multiport control valves, salt brine tank, cationic / anionic ion-exchange resins.
							</div>
						</div>

						<div>
							<h3 class="detail-heading">Water softener plants</h3>
							<p class="detail-lead">
								Manual and semi-automatic ion-exchange units for industrial and domestic use — MS or FRP vessels with strong cation resin, multiport valve and brine regeneration.
							</p>
							<p class="detail-meta"><strong>Applications:</strong> boiler feed, cooling towers, textile mills, beverages, hospitals, apartment societies, swimming pools.</p>

							<h3 class="detail-heading">Demineralization (DM) plants</h3>
							<p class="detail-lead">
								Ultra-pure, low-conductivity, chloride-free output — cation exchanger (H⁺ form) followed by anion exchanger (OH⁻ form).
							</p>
							<p class="detail-meta"><strong>Applications:</strong> pharmaceutical manufacturing, laboratories, chemical synthesis, battery water, fertilizer, electroplating, healthcare.</p>

							<div class="detail-cta">
								<button class="btn btn-primary" data-quote-trigger data-plant="Water Softener / DM Plant">
									Get softener / DM quote &rarr;
								</button>
							</div>
						</div>
					</div>

					<div class="mix-bed-wrap">
						<div class="section-title-wrap-centered">
							<h3 class="section-title">Mix bed specifications</h3>
							<p class="section-subtitle">
								Mixed cationic &amp; anionic resin polishers producing water with conductivity &lt; 0.5 µS/cm.
							</p>
						</div>

						<div class="spec-table-wrapper">
							<table class="spec-table">
								<thead>
									<tr>
										<th scope="col">Model</th>
										<th scope="col">Flow (L/hr)</th>
										<th scope="col">Pressure (kg/cm²)</th>
										<th scope="col">Resin (L)</th>
										<th scope="col">OBR @100 ppm</th>
										<th scope="col">HCl</th>
										<th scope="col">NaOH</th>
										<th scope="col">Action</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td><strong>D.M 100</strong></td>
										<td>1,000</td>
										<td>0.8–2.0</td>
										<td>100</td>
										<td>3,500 L</td>
										<td>30 L</td>
										<td>10 kg</td>
										<td><button class="btn btn-primary btn-sm" data-quote-trigger data-plant="Mix Bed D.M 100">Quote</button></td>
									</tr>
									<tr>
										<td><strong>D.M 200</strong></td>
										<td>2,000</td>
										<td>0.8–2.0</td>
										<td>200</td>
										<td>7,000 L</td>
										<td>60 L</td>
										<td>20 kg</td>
										<td><button class="btn btn-primary btn-sm" data-quote-trigger data-plant="Mix Bed D.M 200">Quote</button></td>
									</tr>
									<tr>
										<td><strong>D.M 600</strong></td>
										<td>6,000</td>
										<td>0.8–2.0</td>
										<td>300</td>
										<td>10,500 L</td>
										<td>130 L</td>
										<td>27 kg</td>
										<td><button class="btn btn-primary btn-sm" data-quote-trigger data-plant="Mix Bed D.M 600">Quote</button></td>
									</tr>
									<tr>
										<td><strong>D.M 800</strong></td>
										<td>8,000</td>
										<td>0.8–2.0</td>
										<td>400</td>
										<td>17,500 L</td>
										<td>180 L</td>
										<td>40 kg</td>
										<td><button class="btn btn-primary btn-sm" data-quote-trigger data-plant="Mix Bed D.M 800">Quote</button></td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</section>

			<!-- ======================================================
			     8. CHEMICALS
			     ====================================================== -->
			<section class="section section-alt" id="industrial-chemicals">
				<div class="container">
					<div class="section-title-wrap-centered">
						<span class="eyebrow">Formulation chemistry</span>
						<h2 class="section-title">Industrial water treatment chemicals</h2>
						<p class="section-subtitle">
							Anti-corrosion, descaling, anti-scaling, biocide and sludge conditioning formulations.
						</p>
					</div>

					<!-- 1. Cooling water -->
					<div class="chem-block-card">
						<div class="chem-card-header">
							<span class="chem-category-badge">Cooling water</span>
							<h3>Cooling water treatment products</h3>
							<p>Overcomes fouling, corrosion, scaling and microbiological growth in cooling towers, coolers and condensers.</p>
						</div>

						<div class="chem-table-wrap">
							<table class="chem-data-table">
								<thead>
									<tr>
										<th scope="col">Code</th>
										<th scope="col">Description</th>
										<th scope="col">Suitability</th>
										<th scope="col" class="align-right">Action</th>
									</tr>
								</thead>
								<tbody>
